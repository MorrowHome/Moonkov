# Unity generated files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Uu]nity[Cc]rash[Rr]eports/
# Unity may create a matching folder meta for local validation caches under Assets.
/Assets/Library.meta
/Assets/Temp.meta

# Generated local build state. Archive release content-state files with release artifacts.
/Assets/AddressableAssetsData/Windows/
/Assets/AddressableAssetsData/Windows.meta
/Assets/AddressableAssetsData/OSX/
/Assets/AddressableAssetsData/OSX.meta
/Assets/SceneDependencyCache/
/Assets/SceneDependencyCache.meta

# IDE generated files
.vs/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# OS generated files
.DS_Store
Thumbs.db

# Standalone persistence service sources; Unity-generated project files stay ignored.
!Backend/**/*.csproj
Backend/**/bin/
Backend/**/obj/
**/appsettings.local.json
moon-server.local.json
moon-client.local.json
moon-client.editor.local.json
moon-game-ca.pem
/Assets/OnlineServerBuildSnapshot/
/Assets/OnlineServerBuildSnapshot.meta
LocalData/

# Local audition copies of candidate source audio. Nothing in the project references
# them; they exist so a shortlist can be previewed in the editor. Delete freely.
/Assets/Audio/Audition/
/Assets/Audio/Audition.meta

# Local map preview/test scenes; keep gameplay scenes, shared assets and builders versioned.
/Assets/MoonEnvironment/Variants/**/Scenes/*Preview.unity
/Assets/MoonEnvironment/Variants/**/Scenes/*Preview.unity.meta
/Assets/MoonEnvironment/Variants/Apollo12Base/Scenes/MoonBaseApollo12.unity
/Assets/MoonEnvironment/Variants/Apollo12Base/Scenes/MoonBaseApollo12.unity.meta

# Reproducible exporter console output; manifests and integration reports remain versioned.
/SourceData/**/*.log
