// Apply sun occlusion to direct sunlight, never to the room's baked probe light.

// URP lilToon normally merges punctual lights into the main light in the
// fragment shader. Keep them separate so the sun's occlusion cannot erase
// lamps. The original forward pass adds fd.addLightColor after OVERRIDE_SHADOW.
#if defined(LIL_URP) && !defined(LIL_OUTLINE) && \
    defined(LIL_USE_ADDITIONALLIGHT_MAINDIR_PS) && !defined(LIL_USE_LIGHTMAP)
    #define MOON_TOON_SEPARATE_LIGHTS

    float3 MoonToonAdditionalLight(uint lightIndex, float3 positionWS, half4 shadowMask, uint renderingLayers)
    {
        // This overload resolves both realtime shadow maps and Mixed-light probe
        // occlusion. The two-argument lilToon path leaves shadowAttenuation at 1.
        Light light = GetAdditionalLight(lightIndex, positionWS, shadowMask);
        #if defined(_LIGHT_LAYERS)
            if ((light.layerMask & renderingLayers) == 0) return 0.0;
        #endif
        return light.color.rgb * light.distanceAttenuation * light.shadowAttenuation;
    }

    float3 MoonToonAdditionalLights(float3 positionWS, float4 positionCS, float strength)
    {
        float3 color = 0.0;
        #if defined(_ADDITIONAL_LIGHTS) || defined(_ADDITIONAL_LIGHTS_VERTEX)
            // These character passes are not lightmapped. Legacy Light Probes
            // provide the shadowmask channels used by URP's standard light API.
            half4 shadowMask = unity_ProbesOcclusion;
            uint renderingLayers = lilGetRenderingLayer();
            InputData inputData = (InputData)0;
            inputData.positionWS = positionWS;
            inputData.normalizedScreenSpaceUV = GetNormalizedScreenSpaceUV(positionCS);

            // URP 17.5 clusters contain punctual lights only. Additional
            // directionals have their own small range before the cluster list.
            #if USE_CLUSTER_LIGHT_LOOP
                UNITY_LOOP for (uint lightIndex = 0; lightIndex < min(URP_FP_DIRECTIONAL_LIGHTS_COUNT, MAX_VISIBLE_LIGHTS); lightIndex++)
                {
                    CLUSTER_LIGHT_LOOP_SUBTRACTIVE_LIGHT_CHECK
                    color += MoonToonAdditionalLight(lightIndex, positionWS, shadowMask, renderingLayers);
                }
            #endif

            uint lightsCount = GetAdditionalLightsCount();
            LIGHT_LOOP_BEGIN(lightsCount)
                color += MoonToonAdditionalLight(lightIndex, positionWS, shadowMask, renderingLayers);
            LIGHT_LOOP_END
        #endif
        return color * strength;
    }

    #undef LIL_GET_MAINLIGHT
    #define LIL_GET_MAINLIGHT(input,lc,ld,atten) \
        lc = max(0.0, input.lightColor - LIL_MAINLIGHT_COLOR) + \
            LIL_MAINLIGHT_COLOR * MoonToonShadowVisibility(input.positionWS, atten); \
        LIL_CORRECT_LIGHTCOLOR_PS(lc); \
        LIL_CORRECT_LIGHTDIRECTION_PS(ld)

    #undef LIL_GET_ADDITIONALLIGHT
    #define LIL_GET_ADDITIONALLIGHT(i,o) \
        o = MoonToonAdditionalLights(i.positionWS, i.positionCS, LIL_ADDITIONAL_LIGHT_STRENGTH); \
        o = lerp(o, lilGray(o), _MonochromeLighting); \
        o = lerp(o, 0.0, _AsUnlit)
#endif

float MoonToonShadowVisibility(float3 positionWS, float attenuation)
{
    #if defined(LIL_URP) && defined(LIL_USE_SHADOW)
        if (attenuation >= 0.999) return 1.0;
        uint cascade = 0;
        #if defined(_MAIN_LIGHT_SHADOWS_CASCADE)
            cascade = (uint)ComputeCascadeIndex(positionWS);
            if (cascade >= MAX_SHADOW_CASCADES) return 1.0;
        #endif
        float4x4 worldToShadow = _MainLightWorldToShadow[cascade];
        float3 coord = mul(worldToShadow, float4(positionWS, 1.0)).xyz;
        if (any(coord.xy < 0.0) || any(coord.xy > 1.0) || BEYOND_SHADOW_FAR(coord))
            return 1.0;

        float occluderDepth = SAMPLE_TEXTURE2D_LOD(
            _MainLightShadowmapTexture, sampler_PointClamp, coord.xy, 0).r;
        #if UNITY_REVERSED_Z
            float depthGap = occluderDepth - coord.z;
        #else
            float depthGap = coord.z - occluderDepth;
        #endif
        float metresPerDepth = rcp(max(length(worldToShadow[2].xyz), 0.000001));
        float separation = max(0.0, depthGap * metresPerDepth);
        float distantOcclusion = smoothstep(max(0.0, _MoonShadowNear),
            max(_MoonShadowNear + 0.001, _MoonShadowFar), separation);
        return lerp(1.0, saturate(attenuation), distantOcclusion);
    #else
        return 1.0;
    #endif
}

#if defined(LIL_URP) && defined(LIL_OUTLINE) && defined(LIL_USE_SHADOW)
    // Native outline lighting does not attenuate the sun. Match the body's
    // distant-occlusion rule so a lit blue/red contour cannot reveal a hidden player.
    #define BEFORE_OUTLINE_COLOR \
        fd.lightColor = max(0.0, input.lightColor - LIL_MAINLIGHT_COLOR) + \
            LIL_MAINLIGHT_COLOR * MoonToonShadowVisibility(fd.positionWS, \
                MainLightRealtimeShadow(TransformWorldToShadowCoord(fd.positionWS))); \
        LIL_CORRECT_LIGHTCOLOR_PS(fd.lightColor);
#endif

#if defined(MOON_TOON_SEPARATE_LIGHTS)
    // lilToon's light ceiling limits diffuse and GGX together. Keep the capped
    // diffuse color, but let excess direct sun drive native specular only.
    // Visibility is sampled before the ceiling, so no HDR sun survives a roof.
    #define OVERRIDE_REFLECTION \
        float3 moonDiffuseLight = fd.lightColor; \
        fd.lightColor += max(0.0, LIL_MAINLIGHT_COLOR - _LightMaxLimit) * \
            MoonToonShadowVisibility(fd.positionWS, fd.attenuation) * (1.0 - _AsUnlit); \
        lilReflection(fd LIL_SAMP_IN(sampler_MainTex) LIL_HDRP_POSITION_INPUT_VAR); \
        fd.lightColor = moonDiffuseLight;

    // Sun visibility was already applied before clamping the lighting color.
    // Passing it through lilToon's receive-shadow ramps again would darken the
    // surviving probe light, removing the indirect fill under punctual shadows.
    // Preserve attenuation for subsequent effects that still need the sun mask.
    #define OVERRIDE_SHADOW \
        float moonSunAttenuation = fd.attenuation; \
        fd.attenuation = 1.0; \
        lilGetShading(fd LIL_SAMP_IN(sampler_MainTex)); \
        fd.attenuation = moonSunAttenuation;
#endif
