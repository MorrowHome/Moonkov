  - m_Id: 2834712165625910
    m_Localized: "Compact first aid for a selected body part. Keep it in pockets or an equipped rig."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625911
    m_Localized: "High-capacity single-use treatment for a selected body part. Use from an equipped rig."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625912
    m_Localized: "A light snack with low stomach occupancy. Consumes a little hydration."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625913
    m_Localized: "Dense field food. Plan drinking water alongside its energy recovery."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625914
    m_Localized: "Compact drinking supply with low stomach occupancy."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625915
    m_Localized: "A large suit-air refill. Use from an equipped rig; excess oxygen is lost."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625916
    m_Localized: "Light chest storage with three narrow compartments. Keeps medical supplies and cells accessible."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625917
    m_Localized: "Roomy chest storage with three broad compartments. Carries larger medical and oxygen supplies within reach."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625918
    m_Localized: "A light backpack for short scavenging trips. Move medicine, oxygen and cells into the rig before use."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625919
    m_Localized: "A heavy pack with a large continuous grid for bulky loot. Total carried weight still applies."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625920
    m_Localized: "Recovered control electronics. Trade goods for the lunar supplier."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625921
    m_Localized: "A dense industrial induction coil. Its sale value comes with extra carried weight."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625922
    m_Localized: "Industrial ceramic stock. A trade good, not wearable armor."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625923
    m_Localized: "An intact precision sensor. Compact trade goods recovered from lunar equipment."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625924
    m_Localized: "An encrypted survey archive. Extract it and sell it for moon dust."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625925
    m_Localized: "A sealed helium-3 research sample. Valuable trade goods; does not refill suit oxygen."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625926
    m_Localized: "A rare quantum processor. High-value cargo to bring back from a raid."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625927
    m_Localized: "A recovered survey recorder. Bulky, valuable cargo worth reserving pack space for."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625928
    m_Localized: "Next cylinder: +{0:0}% oxygen. Keep it in pockets or the chest rig; excess oxygen is lost."
    m_Metadata:
      m_Items: []
  - m_Id: 2834712165625929
    m_Localized: "Next food: {0}. Next drink: {1}. Inspect supplies in inventory for recovery and fullness."
    m_Metadata:
      m_Items: []
