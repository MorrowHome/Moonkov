.session-info-container { align-self: stretch; padding: 10px 16px; background-color: rgba(8,9,12,0.94); border-top-width: 1px; border-top-color: #687487; border-left-width: 3px; border-left-color: #164bff; }
.session-info-container Label { font-size: 12px; color: #c4ccd8; white-space: normal; margin: 0; padding: 0; }
.session-info-container .horizontal-container { flex-direction: row; flex-wrap: wrap; }
.session-info-container .container-top-line { flex-direction: row; flex-shrink: 0; }
.session-info-container .horizontal-grow { flex-grow: 1; }
.session-info-container .binary-info { flex-grow: 1; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 14px; }
.session-info-container .hardware-info, .session-info-container .args-info { margin-top: 5px; }
.session-info-container .connection-info { color: #f1f2ed; }
.session-info-container .connection-info:hover { background-color: #172b54; }
