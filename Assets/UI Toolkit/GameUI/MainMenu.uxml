<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="StashScreen" src="StashScreen.uxml" />
    <ui:Style src="GameUIStyleSheet.uss" />
    <ui:Style src="StashScreen.uss" />
    <ui:Style src="MoonkovTerminal.uss" />
    <ui:Style src="../../Resources/Moonkov/UI/AccessTheme.uss" />
    <ui:Style src="../../Resources/Moonkov/UI/AccountProposal.uss" />
    <ui:VisualElement name="Canvas" picking-mode="Ignore" class="canvas canvas-transparent-background moonkov-login archive-ui archive-light archive-access">
        <ui:VisualElement name="HidingBackground" picking-mode="Ignore" class="background" />
        <ui:VisualElement class="archive-access-exhibit" picking-mode="Ignore"><ui:Label text="MOONKOV" class="archive-access-brand" /><ui:Label text="LUNAR EXPEDITION" class="archive-access-note" /></ui:VisualElement>
        <ui:VisualElement name="Container" picking-mode="Ignore" class="container">
            <ui:VisualElement class="login-heading">
                <ui:Label text="ESCAPE FROM MOONKOV" class="login-title" />
                <ui:Label text="ORBITAL ACCESS / LUNAR EXPEDITION" class="login-caption" />
            </ui:VisualElement>
            <ui:ScrollView name="UIWrapper" class="archive-form-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="ConnectionPanel" picking-mode="Ignore">
                    <ui:VisualElement name="InputPlayerName" class="section-separator">
                        <ui:Label text="Player Name" name="PlayerName" />
                        <ui:TextField name="PlayerNameField" value="_" />
                    </ui:VisualElement>
                    <ui:VisualElement class="section-separator">
                        <ui:Label text="Field operator" />
                        <ui:Label name="FieldOperator" text="DOLLSINGER" />
                    </ui:VisualElement>
                    <ui:VisualElement name="OnlineLobbyHost" />
                    <ui:Foldout text="高级连接 / 旧版直连与中继" name="AdvancedConnection" value="false">
                    <ui:RadioButtonGroup label="Session route" choices="Relay,Direct" value="-1" name="ConnetionModeOption" />
                    <ui:VisualElement name="InputSessionName" class="section-separator">
                        <ui:Label text="Crew session" name="SessionName" />
                        <ui:TextField name="SessionNameField" value="_" />
                    </ui:VisualElement>
                    <ui:Button text="创建中继房间" name="CreateJoinGame" />
                    <ui:VisualElement name="RelayJoinControls" class="section-separator">
                        <ui:Label text="加入好友房间 · 六位房间码" />
                        <ui:TextField name="RelayCodeField" max-length="6" />
                        <ui:Button text="通过房间码加入" name="JoinRelayByCode" />
                        <ui:Label text="房主进入后，可点击屏幕上的房间码复制并分享。房主退出后房间关闭。" class="relay-help" />
                    </ui:VisualElement>
                    <ui:Button text="HOST EXPEDITION" name="StartHost" />
                    <ui:Button text="JOIN EXPEDITION" name="ConnectToServer" />
                    <ui:Button text="Matchmake" name="QuickJoin" class="hidden" />
                    </ui:Foldout>
                    <ui:Button text="QUIT" name="QuitButton" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:Instance template="StashScreen" name="stashScreenHost" class="stash-host" />
        <ui:Button name="ProfileMode" text="SINGLEPLAYER" />
    </ui:VisualElement>
</ui:UXML>
