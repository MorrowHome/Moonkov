/* ==========================================================================
   MOONKOV TERMINAL  /  VANGUARD DARK
   Ink #07080A  Text #ECECE6  Yellow #FFE11A  Cyan #3FE0D0  Red #FF4D3A  Green #3FE07A
   Panels are transparent hosts; TechFrame paints the chamfered body.
   ========================================================================== */

/* ---------- Root / type system ---------- */
.moonkov-terminal { -unity-font-definition: url("../Fonts/Inter-Regular.ttf"); color: #ECECE6; background-color: #07080A; }
.moonkov-terminal Label { color: #ECECE6; }
.stash-root .terminal-eyebrow { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.48); margin-bottom: 12px; white-space: normal; }
.stash-root .terminal-title { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 30px; letter-spacing: 1px; color: #ECECE6; white-space: normal; margin-top: 4px; margin-bottom: 16px; }
.stash-root .terminal-heading { -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); font-size: 17px; letter-spacing: 1px; color: #ECECE6; white-space: normal; margin-top: 6px; margin-bottom: 10px; }
.stash-root .terminal-hero-title { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 64px; letter-spacing: 2px; color: #ECECE6; white-space: normal; margin-top: 18px; margin-bottom: 12px; }
.stash-root .terminal-lead { -unity-font-definition: url("../Fonts/Roboto-Light.ttf"); font-size: 21px; color: rgba(236, 236, 230, 0.8); white-space: normal; margin-bottom: 20px; }
.stash-root .terminal-copy { -unity-font-definition: url("../Fonts/Inter-Regular.ttf"); font-size: 13px; color: rgba(236, 236, 230, 0.6); white-space: normal; margin-top: 8px; margin-bottom: 16px; }
.stash-root .terminal-warning { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 12px; letter-spacing: 2px; color: #FF4D3A; margin-top: 14px; margin-bottom: 10px; white-space: normal; }
.stash-root .terminal-positive { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 12px; letter-spacing: 2px; color: #3FE07A; margin-top: 14px; margin-bottom: 10px; white-space: normal; }

/* ---------- Header in terminal mode ---------- */
.moonkov-terminal .stash-header { border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08); }
.moonkov-terminal .stash-brand-title { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 24px; letter-spacing: 5px; color: #ECECE6; }
.moonkov-terminal .stash-page-title { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 20px; letter-spacing: 2px; color: #ECECE6; }
.moonkov-terminal .stash-eyebrow { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 9px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.42); }
.moonkov-terminal .stash-account-name { -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); font-size: 13px; letter-spacing: 2px; color: #ECECE6; }

/* ---------- Navigation ---------- */
.terminal-nav { flex-direction: row; height: 42px; flex-shrink: 0; align-items: center; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08); }
.terminal-nav-tabs { flex-direction: row; flex-grow: 1; height: 100%; align-items: stretch; position: relative; }
.stash-root .terminal-tab { background-color: transparent; height: 100%; margin: 0; padding-left: 34px; padding-right: 16px; -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); font-size: 11px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.45); -unity-text-align: middle-left; border-radius: 0; border-width: 0; transition-property: background-color, color; transition-duration: 0.18s; }
.stash-root .terminal-tab:hover { background-color: rgba(255, 255, 255, 0.04); color: #ECECE6; }
.stash-root .terminal-tab:focus { background-color: transparent; }
.stash-root .terminal-tab-selected, .stash-root .terminal-tab-selected:hover, .stash-root .terminal-tab-selected:focus { background-color: rgba(255, 225, 26, 0.06); color: #ECECE6; }
.stash-root .terminal-tab-index { position: absolute; left: 13px; top: 0; bottom: 0; -unity-text-align: middle-left; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 9px; letter-spacing: 0; color: rgba(236, 236, 230, 0.3); }
.stash-root .terminal-tab-selected .terminal-tab-index { color: #FFE11A; }
.terminal-nav-indicator { position: absolute; bottom: -1px; height: 3px; background-color: #FFE11A; }
.terminal-nav-status { flex-direction: row; align-items: center; flex-shrink: 0; padding-left: 18px; }
.terminal-nav-dot { width: 6px; height: 6px; background-color: #3FE07A; margin-right: 8px; rotate: 45deg; transition-property: opacity; transition-duration: 0.4s; }
.terminal-nav-dot-dim { opacity: 0.2; }
.stash-root .terminal-nav-link { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 2px; color: #3FE07A; margin-right: 18px; }
.stash-root .terminal-nav-clock { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 11px; letter-spacing: 1px; color: #ECECE6; padding-left: 12px; border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.15); }

/* ---------- Content scaffolding ---------- */
.terminal-content { flex-grow: 1; min-height: 0; padding-top: 22px; padding-bottom: 12px; position: relative; }
.terminal-row { flex-direction: row; flex-shrink: 0; }
.terminal-content > .terminal-row { flex-grow: 1; min-height: 0; }
.stash-root .terminal-page-index { position: absolute; right: -6px; top: -40px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 190px; letter-spacing: -6px; color: rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(236, 236, 230, 0.1); -unity-text-align: upper-right; }
.terminal-panel { padding: 24px; margin-right: 16px; min-width: 0; flex-grow: 1; background-color: transparent; position: relative; }
.terminal-wide { width: 68%; }
.terminal-side { width: 28%; }
.terminal-trader { width: 30%; flex-basis: 0; }
.terminal-hero { width: 68%; padding-top: 45px; }
.terminal-wide > .tech-frame { --frame-fill: rgba(10, 12, 16, 0.84); --frame-line: rgba(255, 255, 255, 0.14); --frame-accent: #FFE11A; --frame-cut: 24; }
.terminal-side > .tech-frame, .terminal-resources > .tech-frame { --frame-fill: rgba(14, 16, 21, 0.88); --frame-line: rgba(255, 255, 255, 0.12); --frame-accent: #3FE0D0; --frame-cut: 14; }
.terminal-trader > .tech-frame { --frame-fill: rgba(12, 14, 18, 0.86); --frame-line: rgba(255, 255, 255, 0.13); --frame-cut: 20; }
.terminal-trader-0 > .tech-frame { --frame-accent: #FFE11A; }
.terminal-trader-1 > .tech-frame { --frame-accent: #3FE0D0; }
.terminal-trader-2 > .tech-frame { --frame-accent: #FF4D3A; }
.terminal-console > .tech-frame { --frame-fill: rgba(255, 255, 255, 0.03); --frame-line: rgba(255, 255, 255, 0.12); --frame-accent: rgba(236, 236, 230, 0.6); --frame-cut: 10; }

/* ---------- Page head / foot ---------- */
.terminal-content > .terminal-page-head { flex-grow: 0; align-items: flex-end; justify-content: space-between; margin-bottom: 18px; padding-right: 16px; }
.terminal-page-heading { flex-direction: column; }
.stash-root .terminal-page-heading .terminal-title { margin-bottom: 0; font-size: 38px; }
.stash-root .terminal-page-meta { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 11px; letter-spacing: 3px; color: #FFE11A; padding-bottom: 6px; }
.terminal-content > .terminal-page-foot { flex-grow: 0; align-items: center; justify-content: space-between; margin-top: 14px; padding-right: 16px; height: 50px; }
.stash-root .terminal-page-foot .terminal-copy { margin: 0; }
.stash-root .terminal-page-foot .terminal-button { width: 260px; margin-top: 0; }
.stash-root .terminal-content > .terminal-title { flex-shrink: 0; font-size: 38px; }

/* ---------- Stats / fields ---------- */
.terminal-stat { justify-content: space-between; align-items: center; padding-top: 9px; padding-bottom: 9px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.07); }
.stash-root .terminal-stat-name { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.45); flex-shrink: 1; white-space: normal; margin-right: 12px; }
.stash-root .terminal-stat-value { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 12px; letter-spacing: 1px; color: #ECECE6; white-space: normal; -unity-text-align: middle-right; }
.terminal-carry-field { height: 38px; margin-top: 8px; margin-bottom: 10px; margin-left: 0; margin-right: 0; }
.terminal-carry-field .unity-base-field__label { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 11px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.6); min-width: 210px; -unity-text-align: middle-left; }
.terminal-carry-field .unity-base-field__input { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 16px; color: #FFE11A; background-color: rgba(255, 225, 26, 0.06); border-width: 0; border-bottom-width: 2px; border-bottom-color: #FFE11A; border-radius: 0; padding-left: 12px; }

/* ---------- Buttons ---------- */
.stash-root .terminal-button { margin-top: 8px; margin-left: 0; margin-right: 0; height: 38px; padding-left: 16px; -unity-text-align: middle-left; -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); font-size: 11px; letter-spacing: 2px; color: #ECECE6; background-color: rgba(255, 255, 255, 0.04); border-radius: 0; border-width: 0; border-left-width: 2px; border-left-color: rgba(236, 236, 230, 0.3); transition-property: background-color, color, border-color, padding-left; transition-duration: 0.18s; }
.stash-root .terminal-button:hover, .stash-root .terminal-button:focus { background-color: rgba(255, 225, 26, 0.1); color: #FFE11A; border-left-color: #FFE11A; padding-left: 22px; }
.stash-root .terminal-button:active { background-color: #FFE11A; color: #07080A; }
.stash-root .terminal-primary { margin-top: 8px; margin-left: 0; margin-right: 0; height: 46px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 15px; letter-spacing: 4px; background-color: #FFE11A; color: #07080A; border-radius: 0; -unity-text-align: middle-center; border-width: 0; border-right-width: 6px; border-right-color: rgba(7, 8, 10, 0.85); transition-property: background-color, color, border-color; transition-duration: 0.18s; }
.stash-root .terminal-primary:hover, .stash-root .terminal-primary:focus { background-color: #FFEC5C; color: #07080A; border-right-color: #3FE0D0; }
.stash-root .terminal-primary:active { background-color: #ECECE6; color: #07080A; }
.stash-root .terminal-button:disabled, .stash-root .terminal-primary:disabled { opacity: 0.3; }

/* ---------- Consoles / art ---------- */
.terminal-consoles { flex-grow: 0; height: 144px; flex-shrink: 0; }
.terminal-console { flex-basis: 0; padding: 16px; }
.stash-root .terminal-console .terminal-copy { font-size: 12px; margin-bottom: 8px; }
.terminal-character-art { position: absolute; left: 30%; right: 18%; top: -40px; bottom: 30px; background-image: none; }
.terminal-trader-art { height: 130px; margin-top: 24px; margin-bottom: 24px; }

/* ==========================================================================
   SHIP / HOME
   ========================================================================== */
.terminal-scene-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lunar-backdrop-tag, .lunar-backdrop-coords { position: absolute; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.45); white-space: nowrap; }
.lunar-backdrop-tag { color: #FFE11A; }
.terminal-is-ship .terminal-nav, .terminal-is-ship .stash-footer { display: none; }
.terminal-is-ship .stash-brand, .terminal-is-ship .stash-page-heading { display: none; }
.terminal-is-ship .stash-header { justify-content: flex-end; height: 64px; border-bottom-width: 0; }
.terminal-is-ship .stash-account .stash-eyebrow { display: none; }
.terminal-is-ship .stash-account-name { font-size: 11px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.6); }
.stash-root.terminal-is-ship .stash-small-button { background-color: transparent; color: rgba(236, 236, 230, 0.55); font-size: 10px; letter-spacing: 2px; border-width: 1px; border-color: rgba(255, 255, 255, 0.16); border-radius: 0; }
.stash-root.terminal-is-ship .stash-small-button:hover { border-color: #FF4D3A; color: #FF4D3A; background-color: rgba(255, 77, 58, 0.08); }
.terminal-is-ship .terminal-content { padding-top: 0; padding-bottom: 0; }
.terminal-is-ship .terminal-character-art { left: 14%; right: 36%; top: -64px; bottom: 0; }

/* Hero mark */
.terminal-home-hero { position: absolute; left: 0; top: 0; }
.stash-root .terminal-home-kicker { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 12px; letter-spacing: 9px; color: #FFE11A; margin-bottom: -10px; margin-left: 6px; }
.terminal-home-mark { position: relative; }
.stash-root .terminal-home-title { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 112px; letter-spacing: -2px; color: #ECECE6; margin: 0; padding: 0; white-space: nowrap; }
.stash-root .terminal-home-title-ghost { position: absolute; left: 10px; top: 10px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 112px; letter-spacing: -2px; color: rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(255, 225, 26, 0.55); margin: 0; padding: 0; white-space: nowrap; }
.terminal-home-bar { flex-direction: row; align-items: center; margin-top: -4px; margin-left: 6px; }
.stash-root .terminal-home-caption { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 13px; letter-spacing: 6px; color: #07080A; background-color: #FFE11A; padding: 3px 12px 3px 10px; margin-right: 14px; }
.stash-root .terminal-home-version { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.5); }
.stash-root .terminal-home-description { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.38); margin-top: 14px; margin-left: 6px; padding-left: 10px; border-left-width: 2px; border-left-color: #3FE0D0; }

/* Command menu */
.terminal-home-menu { position: absolute; right: 0; top: 2%; width: 31%; min-width: 380px; max-width: 520px; }
.terminal-home-menu-head { justify-content: space-between; align-items: flex-end; padding-bottom: 8px; margin-bottom: 14px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.16); }
.stash-root .terminal-home-menu-head .terminal-eyebrow { margin-bottom: 0; color: #ECECE6; }
.stash-root .terminal-home-menu-count { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 9px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.4); }

.stash-root .terminal-home-action { position: relative; height: 104px; margin: 0 0 10px 0; padding: 14px 16px; background-color: transparent; border-radius: 0; border-width: 0; justify-content: flex-end; align-items: flex-start; overflow: hidden; }
.stash-root .terminal-home-action:hover, .stash-root .terminal-home-action:focus, .stash-root .terminal-home-action:active { background-color: transparent; }
.terminal-home-action > .tech-frame { --frame-fill: rgba(12, 14, 18, 0.78); --frame-line: rgba(255, 255, 255, 0.14); --frame-accent: #FFE11A; --frame-cut: 14; }
.terminal-home-action:hover > .tech-frame, .terminal-home-action:focus > .tech-frame { --frame-fill: rgba(34, 31, 10, 0.92); --frame-line: #FFE11A; }
.stash-root .terminal-home-action-index { position: absolute; right: 14px; top: 4px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 40px; letter-spacing: -1px; color: rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(236, 236, 230, 0.22); }
.stash-root .terminal-home-action-name { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 17px; letter-spacing: 2px; color: #ECECE6; margin-bottom: 3px; transition-property: color; transition-duration: 0.18s; }
.stash-root .terminal-home-action-caption { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 9px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.42); white-space: normal; }
.terminal-home-action-arrow { position: absolute; right: 18px; bottom: 18px; width: 9px; height: 9px; border-top-width: 2px; border-right-width: 2px; border-color: rgba(236, 236, 230, 0.45); rotate: 45deg; transition-property: translate, border-color; transition-duration: 0.22s; }
.terminal-home-action:hover .terminal-home-action-arrow, .terminal-home-action:focus .terminal-home-action-arrow { translate: 6px 0; border-color: #FFE11A; }
.stash-root .terminal-home-action:hover .terminal-home-action-name, .stash-root .terminal-home-action:focus .terminal-home-action-name { color: #FFE11A; }
.stash-root .terminal-home-action:hover .terminal-home-action-index, .stash-root .terminal-home-action:focus .terminal-home-action-index { -unity-text-outline-color: rgba(255, 225, 26, 0.6); }

.stash-root .terminal-home-deploy { height: 132px; margin-bottom: 12px; padding: 18px 22px; }
.terminal-home-deploy > .tech-frame { --frame-fill: #FFE11A; --frame-line: rgba(7, 8, 10, 0.35); --frame-accent: #07080A; --frame-cut: 22; }
.terminal-home-deploy:hover > .tech-frame, .terminal-home-deploy:focus > .tech-frame { --frame-fill: #FFEC5C; --frame-line: #07080A; }
.terminal-home-deploy-stripes { position: absolute; right: 0; top: 0; bottom: 0; width: 42%; }
.stash-root .terminal-home-deploy .terminal-home-action-index, .stash-root .terminal-home-deploy:hover .terminal-home-action-index, .stash-root .terminal-home-deploy:focus .terminal-home-action-index { font-size: 64px; top: -4px; right: 20px; -unity-text-outline-color: rgba(7, 8, 10, 0.45); }
.stash-root .terminal-home-deploy .terminal-home-action-name, .stash-root .terminal-home-deploy:hover .terminal-home-action-name, .stash-root .terminal-home-deploy:focus .terminal-home-action-name { font-size: 40px; letter-spacing: 1px; color: #07080A; margin-bottom: 2px; }
.stash-root .terminal-home-deploy .terminal-home-action-caption { color: rgba(7, 8, 10, 0.7); font-size: 10px; }
.terminal-home-deploy .terminal-home-action-arrow, .terminal-home-deploy:hover .terminal-home-action-arrow, .terminal-home-deploy:focus .terminal-home-action-arrow { width: 14px; height: 14px; border-top-width: 3px; border-right-width: 3px; border-color: #07080A; right: 28px; bottom: 30px; }
.terminal-home-deploy:hover .terminal-home-action-arrow, .terminal-home-deploy:focus .terminal-home-action-arrow { translate: 10px 0; }
.stash-root .terminal-home-deploy:disabled { opacity: 0.45; }

.terminal-home-grid { margin-left: -5px; margin-right: -5px; }
.stash-root .terminal-home-grid .terminal-home-action { flex-grow: 1; flex-basis: 0; margin-left: 5px; margin-right: 5px; height: 112px; }

.terminal-home-services { margin-left: -4px; margin-right: -4px; margin-top: 2px; }
.stash-root .terminal-home-chip { flex-grow: 1; flex-basis: 0; height: 46px; margin: 0 4px; padding: 0 0 7px 10px; -unity-text-align: lower-left; -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); font-size: 10px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.75); background-color: rgba(255, 255, 255, 0.04); border-radius: 0; border-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(255, 255, 255, 0.16); transition-property: background-color, color, border-color; transition-duration: 0.18s; }
.stash-root .terminal-home-chip:hover, .stash-root .terminal-home-chip:focus { background-color: rgba(63, 224, 208, 0.1); color: #3FE0D0; border-bottom-color: #3FE0D0; }
.stash-root .terminal-home-chip-index { position: absolute; left: 10px; top: 6px; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 8px; letter-spacing: 1px; color: #3FE0D0; }

.terminal-home-resources { margin-top: 18px; padding-top: 14px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.1); }
.terminal-home-resource { flex-grow: 1; flex-basis: 0; padding-left: 10px; border-left-width: 2px; border-left-color: rgba(255, 225, 26, 0.7); margin-right: 10px; }
.stash-root .terminal-home-resource-name { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 8px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.42); }
.stash-root .terminal-home-resource-value { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 24px; color: #ECECE6; margin-top: 2px; }

/* Operator card */
.terminal-home-operator-card { position: absolute; left: 0; bottom: 58px; width: 300px; padding: 18px 20px 16px 20px; }
.terminal-home-operator-card > .tech-frame { --frame-fill: rgba(9, 10, 13, 0.82); --frame-line: rgba(255, 255, 255, 0.16); --frame-accent: #3FE0D0; --frame-cut: 16; }
.stash-root .terminal-home-operator-card .terminal-eyebrow { margin-bottom: 6px; color: #3FE0D0; }
.stash-root .terminal-home-operator { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 30px; letter-spacing: 2px; color: #ECECE6; }
.stash-root .terminal-home-player { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.5); margin-top: 2px; }
.stash-root .terminal-home-operator-card .terminal-positive, .stash-root .terminal-home-operator-card .terminal-warning { margin-top: 12px; margin-bottom: 0; font-size: 10px; padding-top: 10px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.1); }

/* Ticker */
.terminal-ticker { overflow: hidden; height: 26px; flex-shrink: 0; flex-grow: 1; justify-content: center; }
.terminal-ticker-track { flex-direction: row; flex-wrap: nowrap; flex-shrink: 0; position: absolute; left: 0; top: 0; bottom: 0; align-items: center; }
.stash-root .terminal-ticker-text { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: rgba(236, 236, 230, 0.4); white-space: nowrap; flex-shrink: 0; padding-right: 80px; }
.terminal-home-ticker { position: absolute; left: 0; right: 0; bottom: 10px; border-top-width: 1px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.08); }

/* ==========================================================================
   HALO
   ========================================================================== */
.terminal-halo-schematic { position: relative; flex-grow: 1; min-height: 240px; }
.stash-root .terminal-node { position: absolute; width: 20%; height: 42px; margin: 0; font-size: 10px; padding: 4px; white-space: normal; -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); letter-spacing: 1px; color: #ECECE6; background-color: rgba(7, 8, 10, 0.9); border-radius: 0; border-width: 1px; border-color: rgba(63, 224, 208, 0.45); border-left-width: 3px; border-left-color: #3FE0D0; -unity-text-align: middle-center; transition-property: background-color, color, border-color; transition-duration: 0.18s; }
.stash-root .terminal-node:hover, .stash-root .terminal-node:focus { background-color: rgba(255, 225, 26, 0.12); color: #FFE11A; border-color: #FFE11A; }
.stash-root .terminal-node-index { position: absolute; left: 6px; top: 2px; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 8px; color: #3FE0D0; letter-spacing: 0; }
.terminal-meters { justify-content: space-around; margin-top: 4px; margin-bottom: 16px; }
.arc-meter { width: 96px; height: 96px; flex-shrink: 0; align-items: center; justify-content: center; }
.stash-root .terminal-meter-value { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 22px; color: #ECECE6; -unity-text-align: middle-center; }
.stash-root .terminal-meter-name { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 8px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.45); -unity-text-align: middle-center; margin-top: 2px; }

/* ==========================================================================
   SUPPLIERS
   ========================================================================== */
.terminal-trader { padding: 22px; }
.stash-root .terminal-trader-index { position: absolute; right: 18px; top: 8px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 72px; letter-spacing: -2px; color: rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(236, 236, 230, 0.16); }
.terminal-trader-stage { position: relative; height: 34%; min-height: 120px; margin-top: 4px; margin-bottom: 14px; overflow: hidden; background-color: rgba(255, 255, 255, 0.025); border-bottom-width: 2px; border-bottom-color: #FFE11A; flex-shrink: 0; }
.terminal-trader-1 .terminal-trader-stage { border-bottom-color: #3FE0D0; }
.terminal-trader-2 .terminal-trader-stage { border-bottom-color: #FF4D3A; }
.terminal-trader-stripes { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.terminal-trader-stage > .terminal-trader-art { position: absolute; left: 18%; right: 18%; top: 12px; bottom: 12px; height: auto; margin: 0; }
.stash-root .terminal-trader-role { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: #FFE11A; }
.stash-root .terminal-trader-1 .terminal-trader-role { color: #3FE0D0; }
.stash-root .terminal-trader-2 .terminal-trader-role { color: #FF4D3A; }
.stash-root .terminal-trader .terminal-heading { font-size: 22px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); margin-top: 6px; margin-bottom: 4px; }
.stash-root .terminal-trader .terminal-copy { flex-grow: 1; }
.terminal-standing { flex-direction: row; margin-top: 4px; margin-bottom: 8px; }
.terminal-standing-pip { flex-grow: 1; height: 4px; margin-right: 3px; background-color: rgba(255, 255, 255, 0.1); }

/* ==========================================================================
   OPERATION
   ========================================================================== */
.terminal-content > .terminal-stepper { height: 48px; flex-grow: 0; flex-shrink: 0; margin-bottom: 14px; margin-right: 16px; position: relative; }
.terminal-stepper-rail { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background-color: rgba(255, 255, 255, 0.1); }
.terminal-stepper-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #FFE11A; }
.terminal-stepper Button { flex-grow: 1; flex-basis: 0; margin-right: 8px; }
.stash-root .terminal-stepper .terminal-button { margin-top: 0; margin-bottom: 6px; margin-right: 8px; height: 40px; border-left-width: 0; background-color: rgba(255, 255, 255, 0.03); color: rgba(236, 236, 230, 0.4); padding-left: 14px; }
.stash-root .terminal-stepper .terminal-button:hover, .stash-root .terminal-stepper .terminal-button:focus { color: #ECECE6; padding-left: 14px; background-color: rgba(255, 255, 255, 0.07); }
.stash-root .terminal-stepper .terminal-step-done { color: rgba(255, 225, 26, 0.75); }
.stash-root .terminal-stepper .terminal-tab-selected, .stash-root .terminal-stepper .terminal-tab-selected:hover, .stash-root .terminal-stepper .terminal-tab-selected:focus { background-color: #FFE11A; color: #07080A; }
.stash-root .terminal-step-counter { -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 46px; letter-spacing: -1px; color: #FFE11A; margin-bottom: -4px; }
.terminal-operator-row { flex-grow: 1; margin-top: 4px; }
.terminal-operator-card { margin-right: 12px; }
.terminal-operator-card .terminal-trader-art { height: auto; flex-grow: 1; min-height: 90px; margin: 8px 0; }
.terminal-operator-selected > .tech-frame { --frame-fill: rgba(255, 225, 26, 0.08); --frame-line: #FFE11A; --frame-accent: #FFE11A; }
.terminal-operation-map { height: 260px; flex-grow: 1; position: relative; margin-bottom: 8px; }
.stash-root .terminal-map-tag { position: absolute; left: 12px; bottom: 10px; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: #3FE0D0; }
.terminal-cargo-gauge { height: 8px; background-color: rgba(255, 255, 255, 0.08); margin-bottom: 8px; flex-shrink: 0; }
.terminal-cargo-gauge-fill { height: 100%; background-color: #FFE11A; }
.terminal-hazard-banner { position: relative; height: 64px; justify-content: center; padding-left: 20px; margin-top: 8px; margin-bottom: 12px; overflow: hidden; border-width: 1px; border-color: rgba(255, 77, 58, 0.6); background-color: rgba(255, 77, 58, 0.06); flex-shrink: 0; }
.terminal-hazard-stripes { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.stash-root .terminal-hazard-banner .terminal-warning { margin: 0; font-size: 14px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); letter-spacing: 4px; }
.stash-root .terminal-launch { height: 64px; font-size: 18px; margin-top: 18px; }
.terminal-content > .terminal-page-actions { height: 58px; flex-grow: 0; justify-content: space-between; align-items: center; margin-top: 12px; margin-right: 16px; }
.terminal-page-actions Button { width: 180px; }
.stash-root .terminal-page-actions .terminal-button, .stash-root .terminal-page-actions .terminal-primary { margin-top: 0; }

/* ==========================================================================
   TASKS
   ========================================================================== */
.terminal-task-progress { align-items: center; margin-bottom: 8px; }
.terminal-task-progress-copy { flex-grow: 1; flex-shrink: 1; padding-left: 14px; }
.stash-root .terminal-task-progress-copy .terminal-title { margin: 0; font-size: 24px; }
.stash-root .terminal-task-progress-copy .terminal-heading { margin: 0; font-size: 11px; color: #3FE0D0; -unity-font-definition: url("../RobotoMono-Medium.ttf"); letter-spacing: 2px; }
.terminal-task-chain { margin-top: 8px; padding-top: 12px; border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.1); }
.terminal-objectives { margin-top: 8px; margin-bottom: 8px; padding-left: 14px; border-left-width: 2px; border-left-color: #FFE11A; }

/* ==========================================================================
   BASE
   ========================================================================== */
.terminal-blueprint-panel { flex-direction: column; }
.terminal-blueprint { flex-grow: 1; min-height: 200px; }
.terminal-content > .terminal-module-row { flex-grow: 0; height: 168px; margin-top: 14px; }
.terminal-module { padding: 16px 18px; }
.stash-root .terminal-module-index { position: absolute; right: 14px; top: 6px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 40px; color: rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(236, 236, 230, 0.16); }
.stash-root .terminal-module .terminal-positive, .stash-root .terminal-module .terminal-warning { margin-top: 2px; margin-bottom: 4px; }
.terminal-module-online > .tech-frame { --frame-fill: rgba(63, 224, 122, 0.06); --frame-line: rgba(63, 224, 122, 0.5); --frame-accent: #3FE07A; }

/* ==========================================================================
   COMMS
   ========================================================================== */
.terminal-contact { align-items: center; height: 40px; padding-left: 4px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.07); }
.terminal-contact-led { width: 6px; height: 6px; rotate: 45deg; background-color: rgba(255, 77, 58, 0.7); margin-right: 12px; }
.stash-root .terminal-contact-name { flex-grow: 1; -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); font-size: 11px; letter-spacing: 2px; color: #ECECE6; }
.stash-root .terminal-contact-state { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 9px; letter-spacing: 2px; color: rgba(255, 77, 58, 0.8); }
.terminal-comms-wave { flex-grow: 1; min-height: 160px; position: relative; }
.stash-root .terminal-wave-tag { position: absolute; left: 0; top: 4px; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 10px; letter-spacing: 3px; color: #3FE0D0; }

/* ==========================================================================
   SETTINGS
   ========================================================================== */
.terminal-slider { margin-top: 25px; margin-bottom: 32px; margin-left: 0; margin-right: 0; }
.terminal-slider .unity-label { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 11px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.6); }
.terminal-slider .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.14); border-width: 0; height: 4px; border-radius: 0; }
.terminal-slider .unity-base-slider__dragger { background-color: #FFE11A; border-width: 0; width: 12px; border-radius: 0; }
.stash-root Toggle { color: #ECECE6; margin-top: 15px; margin-bottom: 18px; margin-left: 0; }
.stash-root Toggle .unity-label { -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 11px; letter-spacing: 2px; color: rgba(236, 236, 230, 0.6); }
.stash-root Toggle .unity-toggle__checkmark { border-width: 1px; border-color: rgba(255, 255, 255, 0.3); border-radius: 0; background-color: rgba(255, 255, 255, 0.04); width: 16px; height: 16px; -unity-background-image-tint-color: #07080A; }
.stash-root Toggle:checked .unity-toggle__checkmark { background-color: #FFE11A; border-color: #FFE11A; }
.terminal-settings-wave { height: 110px; flex-shrink: 0; margin-top: 8px; }
.stash-root .terminal-keys .terminal-stat-value { color: #FFE11A; }

/* ==========================================================================
   WINDOWS / TOAST / WIPE
   ========================================================================== */
.terminal-window-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.terminal-window { position: absolute; width: 440px; padding: 24px; background-color: transparent; }
.terminal-context { position: absolute; width: 260px; padding: 12px; background-color: transparent; }
.terminal-window > .tech-frame { --frame-fill: rgba(9, 10, 13, 0.97); --frame-line: rgba(255, 255, 255, 0.22); --frame-accent: #FFE11A; --frame-cut: 20; }
.terminal-context > .tech-frame { --frame-fill: rgba(9, 10, 13, 0.98); --frame-line: rgba(63, 224, 208, 0.45); --frame-accent: #3FE0D0; --frame-cut: 10; }
.terminal-window-header { flex-direction: row; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.1); }
.terminal-window-header Label { flex-grow: 1; }
.stash-root .terminal-window-header .terminal-heading { margin: 0; font-size: 13px; letter-spacing: 3px; }
.stash-root .terminal-window-close { background-color: transparent; width: 30px; height: 30px; margin: 0; font-size: 22px; padding: 0; color: rgba(236, 236, 230, 0.5); border-radius: 0; border-width: 0; -unity-text-align: middle-center; }
.stash-root .terminal-window-close:hover, .stash-root .terminal-window-close:focus { background-color: #FF4D3A; color: #07080A; }
.stash-root .terminal-context .terminal-button { height: 32px; margin-top: 4px; }
.terminal-inspect-art { height: 170px; margin-top: 12px; margin-bottom: 12px; background-color: rgba(255, 255, 255, 0.025); }
.terminal-toast { position: absolute; left: 30%; right: 30%; bottom: 84px; padding: 14px 20px; background-color: rgba(9, 10, 13, 0.96); border-width: 1px; border-color: rgba(255, 255, 255, 0.16); border-left-width: 4px; border-left-color: #FFE11A; -unity-font-definition: url("../RobotoMono-Medium.ttf"); font-size: 12px; letter-spacing: 1px; color: #ECECE6; white-space: normal; -unity-text-align: middle-center; }
.terminal-wipe-caption { position: absolute; left: 0; top: 42%; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); font-size: 84px; letter-spacing: 10px; color: #ECECE6; white-space: nowrap; }

/* ==========================================================================
   LOGIN
   ========================================================================== */
.moonkov-login { background-image: none; background-color: #07080A; background-size: cover; -unity-font-definition: url("../Fonts/Inter-Regular.ttf"); }
.moonkov-login .background { background-color: rgba(7, 8, 10, 0.25); }
.moonkov-login .container { background-image: none; border-width: 0; border-radius: 0; background-color: rgba(9, 10, 13, 0.9); border-left-width: 3px; border-left-color: #FFE11A; padding: 32px; width: 440px; }
.moonkov-login Button { border-width: 0; border-radius: 0; background-color: rgba(255, 255, 255, 0.06); color: #ECECE6; height: 42px; font-size: 13px; letter-spacing: 3px; -unity-font-definition: url("../Fonts/Roboto-Bold.ttf"); scale: 1; transition-property: background-color, color; transition-duration: 0.18s; }
.moonkov-login Button:hover { background-color: #FFE11A; color: #07080A; scale: 1; }
.moonkov-login Button:active, .moonkov-login Button:focus { scale: 1; }
.moonkov-login Label { color: rgba(236, 236, 230, 0.7); font-size: 13px; white-space: normal; }
.moonkov-login TextField { height: 40px; margin-top: 8px; margin-bottom: 8px; margin-left: 0; margin-right: 0; }
.moonkov-login TextField .unity-text-field__input { background-color: rgba(255, 255, 255, 0.05); border-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.25); border-radius: 0; color: #ECECE6; -unity-font-definition: url("../RobotoMono-Medium.ttf"); }
.moonkov-login TextField:focus .unity-text-field__input { border-bottom-color: #FFE11A; }
.moonkov-login RadioButtonGroup { margin-top: 14px; margin-bottom: 14px; }
.login-heading { margin-bottom: 24px; }
.moonkov-login .login-title { font-size: 44px; letter-spacing: 2px; -unity-font-definition: url("../Fonts/Roboto-Black.ttf"); color: #ECECE6; }
.moonkov-login .login-caption { font-size: 10px; letter-spacing: 3px; -unity-font-definition: url("../RobotoMono-Medium.ttf"); color: #FFE11A; margin-top: 8px; }
