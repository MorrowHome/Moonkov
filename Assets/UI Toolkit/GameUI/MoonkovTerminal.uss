.moonkov-terminal { -unity-font: url("project://database/Assets/UnityTechnologies/ParticlePack/TextMesh Pro/Fonts/LiberationSans.ttf"); }
.terminal-nav { flex-direction: row; height: 42px; flex-shrink: 0; align-items: center; }
.stash-root .terminal-tab { background-color: transparent; font-size: 12px; padding-left: 13px; padding-right: 13px; height: 36px; color: #505050; }
.stash-root .terminal-tab-selected { background-color: rgba(255, 255, 255, 0.14); color: #191919; }
.terminal-content { flex-grow: 1; min-height: 0; padding-top: 22px; padding-bottom: 12px; }
.terminal-row { flex-direction: row; flex-shrink: 0; }
.terminal-content > .terminal-row { flex-grow: 1; min-height: 0; }
.terminal-panel { padding: 24px; margin-right: 16px; min-width: 0; flex-grow: 1; }
.terminal-wide { width: 68%; background-color: rgba(255, 255, 255, 0.72); border-radius: 12px; }
.terminal-side { width: 28%; background-color: rgba(255, 255, 255, 0.65); border-radius: 12px; }
.terminal-hero { width: 68%; padding-top: 45px; background-color: transparent; }
.terminal-hero > .terminal-primary { width: 280px; margin-top: 24px; }
.terminal-hero .terminal-copy { max-width: 350px; }
.terminal-ship-telemetry { align-self: flex-start; padding-top: 45px; background-color: rgba(255, 255, 255, 0.3); }
.stash-root .terminal-hero-title { font-size: 66px; -unity-font-style: bold; white-space: normal; color: #191919; margin-top: 22px; margin-bottom: 20px; }
.stash-root .terminal-title { font-size: 28px; white-space: normal; color: #191919; margin-top: 14px; margin-bottom: 20px; }
.stash-root .terminal-heading { font-size: 19px; white-space: normal; color: #191919; margin-top: 8px; margin-bottom: 12px; }
.stash-root .terminal-eyebrow { font-size: 11px; color: #5d5d5d; margin-bottom: 14px; }
.stash-root .terminal-lead { font-size: 21px; color: #363636; white-space: normal; margin-bottom: 20px; }
.stash-root .terminal-copy { font-size: 14px; color: #494949; white-space: normal; margin-top: 10px; margin-bottom: 20px; }
.stash-root .terminal-warning { font-size: 15px; color: #4a4a4a; margin-top: 20px; margin-bottom: 14px; }
.stash-root .terminal-positive { font-size: 15px; color: #313131; margin-top: 20px; margin-bottom: 14px; white-space: normal; }
.terminal-stat { justify-content: space-between; align-items: center; padding-top: 10px; padding-bottom: 10px; }
.stash-root .terminal-stat-name { font-size: 11px; color: #666666; flex-shrink: 1; white-space: normal; margin-right: 12px; }
.stash-root .terminal-stat-value { font-size: 13px; color: #1b1b1b; white-space: normal; -unity-text-align: middle-right; }
.terminal-stat-value { -unity-font: url("../RobotoMono-Medium.ttf"); }
.terminal-carry-field { height: 36px; margin-top: 8px; margin-bottom: 12px; }
.terminal-carry-field .unity-base-field__label { color: #494949; min-width: 210px; }
.terminal-carry-field .unity-base-field__input { color: #191919; background-color: rgba(255, 255, 255, 0.14); border-width: 0; border-radius: 4px; }
.stash-root .terminal-button { margin-top: 8px; height: 38px; -unity-text-align: middle-left; }
.stash-root .terminal-primary { margin-top: 8px; height: 46px; font-size: 16px; background-color: rgba(255, 255, 255, 0.14); color: #191919; }
.stash-root .terminal-primary:hover { background-color: rgba(255, 255, 255, 0.14); }
.terminal-consoles { flex-grow: 0; height: 144px; flex-shrink: 0; }
.terminal-console { flex-basis: 0; background-color: rgba(255, 255, 255, 0.25); border-radius: 8px; padding: 16px; }
.terminal-console .terminal-copy { font-size: 12px; margin-bottom: 8px; }
.terminal-character-art { position: absolute; left: 30%; right: 18%; top: -40px; bottom: 30px; background-image: none; }
.terminal-trader { width: 30%; background-color: rgba(255, 255, 255, 0.6); border-radius: 12px; }
.terminal-trader-art { height: 130px; margin-top: 24px; margin-bottom: 24px; }
.terminal-halo-schematic { position: relative; flex-grow: 1; min-height: 240px; }
.stash-root .terminal-node { position: absolute; width: 20%; height: 42px; font-size: 10px; padding: 4px; white-space: normal; background-color: rgba(255, 255, 255, 0.14); color: #212121; }
.terminal-operation-map { height: 260px; }
.terminal-stepper { height: 50px; flex-grow: 0; flex-shrink: 0; margin-bottom: 10px; }
.terminal-stepper Button { flex-grow: 1; margin-right: 8px; }
.terminal-page-actions { height: 58px; flex-grow: 0; justify-content: space-between; margin-top: 10px; }
.terminal-page-actions Button { width: 160px; }
.terminal-resources { background-color: rgba(255, 255, 255, 0.5); border-radius: 12px; }
.terminal-slider { margin-top: 25px; margin-bottom: 32px; }
.terminal-slider .unity-base-slider__tracker { background-color: #494949; height: 4px; }
.terminal-slider .unity-base-slider__dragger { background-color: #c9c9c9; width: 12px; }
.stash-root Toggle { color: #242424; margin-top: 15px; margin-bottom: 18px; }
.stash-root Toggle .unity-toggle__checkmark { border-width: 0; background-color: #424242; }
.terminal-window-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.terminal-window { position: absolute; width: 440px; padding: 24px; background-color: rgba(255, 255, 255, 0.98); border-radius: 10px; }
.terminal-context { position: absolute; width: 260px; padding: 12px; background-color: rgba(255, 255, 255, 0.98); border-radius: 8px; }
.terminal-window-header { flex-direction: row; align-items: center; margin-bottom: 10px; }
.terminal-window-header Label { flex-grow: 1; }
.stash-root .terminal-window-close { background-color: transparent; width: 30px; font-size: 26px; padding: 0; }
.terminal-inspect-art { height: 170px; margin-top: 12px; margin-bottom: 12px; }
.terminal-toast { position: absolute; left: 25%; right: 25%; bottom: 80px; padding: 16px; background-color: rgba(255, 255, 255, 0.97); border-radius: 6px; font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
.moonkov-login .container { background-image: none; border-width: 0; border-radius: 12px; background-color: rgba(255, 255, 255, 0.88); padding: 32px; width: 440px; }
.moonkov-login { background-image: none; background-color: #f2f2ef; background-size: cover; }
.moonkov-login .background { background-color: rgba(255, 255, 255, 0.18); }
.moonkov-login Button { border-width: 0; border-radius: 4px; background-color: rgba(255, 255, 255, 0.14); color: #1f1f1f; height: 42px; font-size: 14px; scale: 1; }
.moonkov-login Button:hover { background-color: rgba(255, 255, 255, 0.14); scale: 1; }
.moonkov-login Button:active, .moonkov-login Button:focus { scale: 1; }
.moonkov-login Label { color: #303030; font-size: 13px; white-space: normal; }
.moonkov-login TextField { height: 40px; margin-top: 8px; margin-bottom: 8px; }
.moonkov-login TextField .unity-text-field__input { background-color: rgba(255, 255, 255, 0.14); border-width: 0; border-radius: 4px; color: #191919; }
.moonkov-login RadioButtonGroup { margin-top: 14px; margin-bottom: 14px; }
.login-heading { margin-bottom: 24px; }
.moonkov-login .login-title { font-size: 37px; -unity-font-style: bold; color: #191919; }
.moonkov-login .login-caption { font-size: 11px; color: #5b5b5b; margin-top: 8px; }


.terminal-scene-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.terminal-is-ship .terminal-nav, .terminal-is-ship .stash-footer { display: none; }
.terminal-is-ship .stash-brand, .terminal-is-ship .stash-page-heading { display: none; }
.terminal-is-ship .stash-header { justify-content: flex-end; height: 70px; }
.terminal-is-ship .stash-account .stash-eyebrow { display: none; }
.terminal-is-ship .stash-account-name { font-size: 12px; color: #5f5f5f; }
.terminal-is-ship .stash-small-button { background-color: transparent; color: #888888; font-size: 11px; }
.terminal-is-ship .terminal-content { padding-top: 0; }
.terminal-home-menu { width: 360px; margin-left: 4%; padding-top: 12%; }
.stash-root .terminal-home-caption { font-size: 11px; color: #666666; margin-bottom: 14px; }
.stash-root .terminal-home-title { font-size: 52px; color: #191919; -unity-font-style: bold; margin-bottom: 14px; }
.stash-root .terminal-home-description { font-size: 13px; color: #555555; margin-bottom: 52px; }
.stash-root .terminal-home-action { width: 290px; height: 54px; margin-bottom: 10px; padding-left: 0; padding-right: 0; -unity-text-align: middle-left; font-size: 19px; background-color: transparent; color: #393939; border-radius: 0; }
.stash-root .terminal-home-action:hover, .stash-root .terminal-home-action:focus { background-color: transparent; color: #191919; }
.terminal-is-ship .terminal-character-art { left: 45%; right: 10%; top: 4%; bottom: 5%; }
.stash-root .terminal-home-operator { position: absolute; right: 22%; bottom: 25px; font-size: 12px; color: #5b5b5b; }

.stash-root { background-color: #f2f2ef; }
.stash-root .terminal-tab { background-color: transparent; color: #676767; }
.stash-root .terminal-tab-selected { background-color: #242424; color: #ffffff; }
.stash-root Button:hover { color: #111111; background-color: rgba(0, 0, 0, 0.07); }
.stash-root Button:focus { background-color: rgba(0, 0, 0, 0.06); }
.stash-root .terminal-primary, .stash-root .stash-deploy-button { background-color: #dfe66d; color: #202020; border-radius: 0; }
.stash-root .terminal-primary:hover, .stash-root .stash-deploy-button:hover { background-color: #e7ed85; color: #111111; }
.stash-root .stash-filter-active { background-color: #252525; color: #ffffff; }
.stash-root .stash-item { background-color: #e4e4df; border-color: #c5c5bf; }
.stash-root .stash-item:hover { background-color: #eeeeeb; border-color: #222222; }
.stash-root .stash-item-selected { border-color: #222222; }
.stash-root .stash-item-locked { border-color: #7a7a72; }
.stash-root .stash-item-favorite { border-top-color: #949a50; }
.terminal-wide, .terminal-side, .terminal-trader, .terminal-resources { background-color: rgba(255, 255, 255, 0.93); border-radius: 0; }
.terminal-window, .terminal-context { background-color: #f5f5f1; border-radius: 0; }
.stash-root .terminal-node { background-color: #e5e5df; color: #282828; border-radius: 0; }
.stash-root .terminal-stat-value { color: #333333; }
.stash-root .terminal-positive { color: #3c6755; }
.stash-root .terminal-warning { color: #7f5445; }
.stash-root .terminal-home-title { color: #202020; font-size: 48px; margin-bottom: 10px; }
.stash-root .terminal-home-caption { color: #666666; }
.stash-root .terminal-home-description { color: #808080; font-size: 10px; margin-bottom: 44px; }
.terminal-home-menu { position: absolute; right: 4%; top: 19%; width: 32%; margin-left: 0; padding-top: 0; }
.stash-root .terminal-home-action { width: 100%; height: 56px; font-size: 18px; padding-left: 18px; color: #454545; margin-bottom: 12px; }
.stash-root .terminal-home-action:hover, .stash-root .terminal-home-action:focus { background-color: #e5e5de; color: #111111; }
.stash-root .terminal-home-deploy { height: 72px; background-color: #dfe66d; color: #222222; -unity-font-style: bold; font-size: 24px; margin-bottom: 26px; }
.stash-root .terminal-home-deploy:hover, .stash-root .terminal-home-deploy:focus { background-color: #e8ef84; color: #111111; }
.terminal-is-ship .terminal-character-art { left: 2%; right: 42%; top: 0; bottom: 4%; }
.stash-root .terminal-home-operator { left: 9%; right: auto; bottom: 30px; color: #525252; font-size: 13px; }
.terminal-is-ship .stash-account-name { color: #4a4a4a; }
.terminal-is-ship .stash-small-button { color: #777777; }
