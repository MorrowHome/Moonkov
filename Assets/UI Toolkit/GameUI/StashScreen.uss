.stash-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}
.stash-root {
    flex-grow: 1;
    background-color: rgba(17, 18, 17, 0.98);
    color: #d9d7ce;
    padding-left: 44px;
    padding-right: 44px;
    font-size: 16px;
}
.stash-root Label { color: #d9d7ce; margin: 0; }
.stash-header {
    height: 108px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: #46463c;
}
.stash-brand { width: 270px; }
.stash-root .stash-brand-title { font-size: 36px; -unity-font-style: bold; color: #b7b29b; }
.stash-root .stash-eyebrow { font-size: 12px; color: #929287; margin-top: 4px; }
.stash-page-heading { flex-grow: 1; }
.stash-root .stash-page-title { font-size: 28px; -unity-font-style: bold; }
.stash-account { margin-right: 24px; align-items: flex-end; }
.stash-root .stash-account-name { font-size: 19px; color: #cbc8b7; }
.stash-body { flex-grow: 1; flex-direction: row; min-height: 0; padding-top: 24px; padding-bottom: 20px; }
.stash-character-pane { width: 470px; flex-shrink: 0; margin-right: 34px; }
.stash-storage-pane { flex-grow: 1; min-width: 0; }
.stash-section-header { height: 35px; flex-shrink: 0; flex-direction: row; justify-content: space-between; align-items: center; border-bottom-width: 1px; border-bottom-color: #49493f; }
.stash-root .stash-section-title { font-size: 19px; -unity-font-style: bold; color: #bbb79e; }
.stash-root .stash-muted { font-size: 12px; color: #85867c; }
.stash-character-heading { flex-direction: row; justify-content: space-between; align-items: center; height: 60px; flex-shrink: 0; }
.stash-root .stash-character-name { font-size: 23px; -unity-font-style: bold; }
.stash-equipment { flex-direction: row; flex-wrap: wrap; }
.stash-equipment-slot { width: 48%; height: 126px; margin-right: 2%; margin-bottom: 10px; border-width: 1px; border-color: #4c4c40; background-color: #23241f; position: relative; }
.stash-equipped-slot { border-color: #79745b; background-color: #2b2c24; }
.stash-root .stash-slot-label { position: absolute; left: 8px; top: 6px; font-size: 12px; color: #9d9b88; }
.stash-root .stash-slot-caption { position: absolute; right: 8px; bottom: 6px; font-size: 11px; color: #96947e; }
.stash-slot-art { position: absolute; left: 20px; right: 20px; top: 24px; bottom: 22px; }
.stash-root .stash-slot-empty { flex-grow: 1; -unity-text-align: middle-center; color: #53554b; font-size: 12px; }
.stash-subsection { margin-top: 13px; }
.stash-pockets { flex-direction: row; height: 62px; margin-top: 10px; flex-shrink: 0; }
.stash-pocket { width: 60px; margin-right: 7px; background-color: #1b1c19; border-width: 1px; border-color: #42443b; }
.stash-pack { height: 150px; flex-shrink: 0; margin-top: 10px; border-width: 1px; border-color: #47483f; }
.stash-root .stash-loadout-note { margin-top: 12px; font-size: 13px; color: #83857b; white-space: normal; }
.stash-balance-bar { height: 80px; flex-direction: row; flex-shrink: 0; align-items: center; }
.stash-balance { margin-right: 32px; min-width: 90px; }
.stash-root .stash-balance-value { font-size: 24px; -unity-font-style: bold; margin-top: 2px; }
.stash-root .stash-dust-text { color: #a8bac0; }
.stash-root .stash-alloy-text { color: #c1b28d; }
.stash-root .stash-cell-text { color: #a8acd1; }
.stash-balance-spacer { flex-grow: 1; }
.stash-root .stash-sync-status { font-size: 11px; color: #989b85; margin-right: 14px; }
.stash-toolbar { flex-direction: row; align-items: center; height: 48px; flex-shrink: 0; margin-bottom: 10px; }
.stash-root Button {
    background-color: #282a24;
    background-image: none;
    color: #aaa896;
    border-width: 1px;
    border-color: #4c4e42;
    border-radius: 0;
    margin: 0;
    padding-left: 14px;
    padding-right: 14px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    font-size: 13px;
    height: 34px;
    min-height: 0;
    min-width: 0;
    flex-shrink: 0;
}
.stash-root Button:hover { background-color: #3e4033; border-color: #939076; color: #e1dfd2; }
.stash-root Button:focus { border-color: #bbb38d; }
.stash-root Button:active { background-color: #55533d; }
.stash-root Button:disabled { background-color: #23241f; border-color: #34362e; color: #626456; }
.stash-root .stash-filter { margin-right: 5px; padding-left: 14px; padding-right: 14px; background-color: #1d1e1a; }
.stash-root .stash-filter-active { color: #dfdcc7; border-bottom-width: 2px; border-bottom-color: #aca57e; background-color: #38392e; }
.stash-root .stash-search { flex-grow: 1; min-width: 80px; height: 34px; margin-left: 16px; margin-right: 12px; }
.stash-root .stash-search .unity-text-field__input { border-width: 1px; border-color: #41433a; border-radius: 0; background-color: #1a1c18; color: #d9d7ce; font-size: 14px; padding-left: 9px; }
.stash-root .stash-search .unity-text-field__input:focus { border-color: #a39a74; }
.stash-inventory-body { flex-grow: 1; flex-direction: row; min-height: 0; }
.stash-scroll { flex-grow: 1; min-width: 0; border-width: 1px; border-color: #45473d; background-color: #181a17; }
.stash-grid-host { flex-shrink: 0; width: 100%; }
.stash-grid { position: relative; }
.stash-root .stash-item {
    position: absolute;
    height: auto;
    flex-shrink: 0;
    border-width: 1px;
    border-color: #6a705d;
    padding: 0;
    background-color: #30352c;
    overflow: hidden;
}
.stash-root .stash-item-dust { background-color: #293135; border-color: #657880; }
.stash-root .stash-item-alloy { background-color: #353329; border-color: #81795c; }
.stash-root .stash-item-cell { background-color: #2c2e3a; border-color: #727796; }
.stash-root .stash-item:hover { background-color: #454739; border-color: #d1c9a8; }
.stash-root .stash-item-selected { border-width: 2px; border-color: #dad1aa; }
.stash-item-art { position: absolute; left: 12%; right: 12%; top: 18%; bottom: 18%; }
.stash-root .stash-item-name { position: absolute; left: 6px; top: 4px; font-size: 12px; color: #d0cfbf; }
.stash-root .stash-item-quantity { position: absolute; right: 5px; bottom: 4px; font-size: 14px; -unity-font-style: bold; color: #eeebd9; }
.stash-root .stash-empty-title { position: absolute; top: 180px; left: 16px; right: 16px; font-size: 22px; -unity-text-align: middle-center; color: #8b8e7e; }
.stash-root .stash-empty-description { position: absolute; top: 220px; left: 32px; right: 32px; font-size: 14px; white-space: normal; -unity-text-align: middle-center; color: #686d5e; }
.stash-inspector { width: 242px; flex-shrink: 0; margin-left: 20px; padding-left: 18px; border-left-width: 1px; border-left-color: #3b3e34; }
.stash-inspect-art { height: 168px; flex-shrink: 0; margin-top: 20px; margin-bottom: 20px; border-width: 1px; border-color: #3b3e34; background-color: #20221d; }
.stash-root .stash-inspect-name { font-size: 23px; -unity-font-style: bold; white-space: normal; }
.stash-root .stash-inspect-category { font-size: 12px; color: #a4a084; margin-top: 6px; }
.stash-detail-rule { height: 1px; background-color: #44473a; margin-top: 20px; margin-bottom: 18px; }
.stash-root .stash-inspect-description { white-space: normal; font-size: 15px; color: #a2a394; margin-bottom: 25px; }
.stash-detail-row { flex-direction: row; justify-content: space-between; margin-bottom: 12px; }
.stash-root .stash-detail-value { font-size: 14px; color: #cdc9b3; }
.stash-inspector-spacer { flex-grow: 1; }
.stash-root .stash-inspect-help { font-size: 12px; color: #7c8070; white-space: normal; margin-top: 15px; margin-bottom: 10px; }
.stash-root .stash-storage-caption { font-size: 11px; color: #727766; margin-top: 10px; }
.stash-footer { height: 84px; flex-shrink: 0; flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: #45473c; }
.stash-root .stash-footer-button { height: 42px; padding-left: 22px; padding-right: 22px; font-size: 16px; }
.stash-root .stash-footer-caption { margin-left: 22px; font-size: 12px; color: #7e8270; }
.stash-footer-spacer { flex-grow: 1; }
.stash-root .stash-footer-hint { font-size: 12px; color: #969a84; margin-right: 25px; }
.stash-root .stash-deploy-button { height: 48px; width: 218px; font-size: 22px; -unity-font-style: bold; background-color: #bbb28b; color: #1a1d16; border-color: #d2c8a1; }
.stash-root .stash-deploy-button:hover { background-color: #d9d0a6; color: #12150f; }
