<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="StashScreen.uss" />
    <ui:Style src="MoonkovTerminal.uss" />
    <ui:Style src="../../Resources/Moonkov/UI/TerminalLayout.uss" />
    <ui:VisualElement name="stashScreen" class="stash-root moonkov-terminal">
        <ui:VisualElement class="stash-header">
            <ui:VisualElement class="stash-brand">
                <ui:Label text="MOONKOV" class="stash-brand-title" />
                <ui:Label text="LUNAR OPERATIONS" class="stash-eyebrow" />
            </ui:VisualElement>
            <ui:VisualElement class="stash-page-heading">
                <ui:Label text="CHARACTER" class="stash-page-title" />
                <ui:Label text="EQUIPMENT / PERSONAL STORAGE" class="stash-eyebrow" />
            </ui:VisualElement>
            <ui:VisualElement class="stash-account">
                <ui:Label name="stashAccountName" class="stash-account-name" />
                <ui:Label text="PERSONAL STASH" class="stash-eyebrow" />
            </ui:VisualElement>
            <ui:Button name="stashLogout" text="LOG OUT" class="stash-small-button" />
        </ui:VisualElement>
        <ui:VisualElement class="terminal-nav" name="terminalNav">
            <ui:ScrollView class="terminal-nav-scroll" mode="Horizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Auto">
                <ui:VisualElement class="terminal-nav-tabs" name="terminalNavTabs">
                    <ui:Button class="terminal-tab" tooltip="SHIP" text="" name="terminalTab0">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="01" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="SHIP" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="CHARACTER" text="" name="terminalTab1">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="02" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="CHARACTER" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="HALO BUILD" text="" name="terminalTab2">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="03" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="HALO BUILD" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="SUPPLIERS" text="" name="terminalTab3">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="04" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="SUPPLIERS" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="OPERATIONS" text="" name="terminalTab4">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="05" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="OPERATIONS" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="TASKS" text="" name="terminalTab5">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="06" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="TASKS" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="BASE" text="" name="terminalTab6">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="07" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="BASE" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="COMMS" text="" name="terminalTab7">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="08" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="COMMS" />
                    </ui:Button>
                    <ui:Button class="terminal-tab" tooltip="SETTINGS" text="" name="terminalTab8">
                        <ui:Label class="terminal-tab-index" picking-mode="Ignore" text="09" />
                        <ui:Label class="terminal-tab-label" picking-mode="Ignore" text="SETTINGS" />
                    </ui:Button>
                    <ui:VisualElement class="terminal-nav-indicator" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="terminal-nav-status">
                <ui:VisualElement class="terminal-nav-dot" />
                <ui:Label class="terminal-nav-link" text="UPLINK STABLE" />
                <ui:Label class="terminal-nav-clock" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="stash-body">
            <ui:VisualElement class="stash-character-pane">
                <ui:VisualElement class="stash-character-heading">
                    <ui:Label name="stashCharacterName" text="DOLLSINGER" class="stash-character-name" />
                    <ui:Label text="FIELD LOADOUT" class="stash-eyebrow" />
                </ui:VisualElement>
                <ui:VisualElement name="stashCharacterStage" class="stash-character-stage">
                    <ui:VisualElement name="stashEquipment" class="stash-equipment" />
                </ui:VisualElement>
                <ui:VisualElement name="stashPockets" style="display: none;" />
                <ui:VisualElement name="stashPack" style="display: none;" />
                <ui:Label name="stashLoadoutNote" class="stash-loadout-note" />
            </ui:VisualElement>
            <ui:VisualElement class="stash-storage-pane">
                <ui:VisualElement class="stash-section-header">
                    <ui:Label text="STASH" class="stash-section-title" />
                    <ui:Label name="stashStackCount" text="0 STACKS" class="stash-muted" />
                </ui:VisualElement>
                <ui:VisualElement class="stash-balance-bar">
                    <ui:VisualElement class="stash-balance">
                        <ui:Label text="MOON DUST" class="stash-eyebrow" />
                        <ui:Label name="stashDustCount" text="0" class="stash-balance-value stash-dust-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stash-balance">
                        <ui:Label text="ALLOY" class="stash-eyebrow" />
                        <ui:Label name="stashAlloyCount" text="0" class="stash-balance-value stash-alloy-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stash-balance">
                        <ui:Label text="ENERGY CELLS" class="stash-eyebrow" />
                        <ui:Label name="stashCellsCount" text="0" class="stash-balance-value stash-cell-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stash-balance-spacer" />
                    <ui:Label name="stashSyncStatus" text="UP TO DATE" class="stash-sync-status" />
                    <ui:Button name="stashRefresh" text="REFRESH" class="stash-small-button" />
                </ui:VisualElement>
                <ui:VisualElement class="stash-toolbar">
                    <ui:Button name="stashFilterAll" text="ALL" class="stash-filter stash-filter-active" />
                    <ui:Button name="stashFilterMaterials" text="MATERIALS" class="stash-filter" />
                    <ui:Button name="stashFilterEnergy" text="ENERGY" class="stash-filter" />
                    <ui:TextField name="stashSearch" class="stash-search" tooltip="Search supplies by name" />
                    <ui:Button name="stashSort" text="SORT: NAME" class="stash-small-button" />
                </ui:VisualElement>
                <ui:VisualElement class="stash-inventory-body">
                    <ui:ScrollView name="stashScroll" mode="Vertical" class="stash-scroll" horizontal-scroller-visibility="Hidden">
                        <ui:VisualElement name="stashGridHost" class="stash-grid-host" />
                    </ui:ScrollView>
                    <ui:VisualElement class="stash-inspector">
                        <ui:Label text="ITEM INSPECTION" class="stash-eyebrow" />
                        <ui:VisualElement name="stashInspectArt" class="stash-inspect-art" />
                        <ui:Label name="stashInspectName" text="SELECT AN ITEM" class="stash-inspect-name" />
                        <ui:Label name="stashInspectCategory" text="PERSONAL STORAGE" class="stash-inspect-category" />
                        <ui:VisualElement class="stash-detail-rule" />
                        <ui:Label name="stashInspectDescription" text="Select a supply stack to inspect its contents." class="stash-inspect-description" />
                        <ui:VisualElement class="stash-detail-row">
                            <ui:Label text="OWNED" class="stash-muted" />
                            <ui:Label name="stashInspectQuantity" text="--" class="stash-detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stash-detail-row">
                            <ui:Label text="STORAGE" class="stash-muted" />
                            <ui:Label text="STASH" class="stash-detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stash-inspector-spacer" />
                        <ui:Label text="Click to inspect.\nScroll to browse your storage." class="stash-inspect-help" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="PERSONAL STORAGE / RECOVERED SUPPLIES" class="stash-storage-caption" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="terminalContent" class="terminal-content" picking-mode="Ignore" />
        <ui:VisualElement class="stash-footer">
            <ui:Button name="stashMainMenu" text="MAIN MENU" class="stash-footer-button" />
            <ui:Label text="MOON / DEPLOYMENT TERMINAL" class="stash-footer-caption" />
            <ui:VisualElement class="stash-footer-spacer" />
            <ui:Label text="Choose your connection in raid preparation." class="stash-footer-hint" />
            <ui:Button name="stashDeploy" text="PREPARE RAID" class="stash-deploy-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
