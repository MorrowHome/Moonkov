<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameUI/GameUIStyleSheet.uss?fileID=7433441132597879392&amp;guid=35b9b2a65173fdb47ad41dfdb0b5a02a&amp;type=3#GameUIStyleSheet"/>
    <ui:Style src="PauseMenu.uss" />
    <ui:Template name="ActionCard" src="../../Resources/Moonkov/UI/Components/ActionCard.uxml" />
    <ui:VisualElement name="Canvas" class="canvas canvas-transparent-background moonkov-controls moonkov-pause">
        <ui:VisualElement name="Container" picking-mode="Ignore" class="container container-in-game">
            <ui:VisualElement name="UIWrapper" picking-mode="Ignore">
                <ui:VisualElement name="InGamePanel" picking-mode="Ignore">
                    <ui:Label text="MOONKOV / MENU" class="pause-caption" picking-mode="Ignore" />
                    <ui:Instance template="ActionCard" name="ResumeCard">
                        <ui:AttributeOverrides element-name="actionTitle" text="Resume" />
                        <ui:AttributeOverrides element-name="actionIndex" text="01" />
                    </ui:Instance>
                    <ui:Instance template="ActionCard" name="MainMenuCard">
                        <ui:AttributeOverrides element-name="actionTitle" text="Main Menu" />
                        <ui:AttributeOverrides element-name="actionIndex" text="02" />
                    </ui:Instance>
                    <ui:Instance template="ActionCard" name="QuitCard">
                        <ui:AttributeOverrides element-name="actionTitle" text="Quit" />
                        <ui:AttributeOverrides element-name="actionIndex" text="03" />
                    </ui:Instance>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
