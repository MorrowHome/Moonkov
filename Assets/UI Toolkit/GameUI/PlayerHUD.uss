/* Native field instruments: readable on both sunlit regolith and dark interiors. */
#hud-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
#weapon-info-container, #health-info-container { position: absolute; bottom: 28px; width: 258px; padding: 12px 16px; background-color: rgba(8,9,12,0.88); border-width: 1px; border-color: #5c626d; border-radius: 0; }
#health-info-container { left: 28px; border-left-width: 3px; border-left-color: #f1f2ed; }
#weapon-info-container { right: 28px; align-items: flex-end; border-right-width: 3px; border-right-color: #f1f2ed; }
#health-heading { flex-direction: row; justify-content: space-between; margin-bottom: 8px; }
#health-state, #health-value { color: #f1f2ed; font-size: 13px; letter-spacing: 0; }
#health-info-container.health-critical { border-left-color: #f28c78; }
#health-info-container.health-critical #health-state { color: #ffb0a0; }
#player-health-bar, #player-ammo-bar { width: 100%; height: 5px; min-height: 5px; flex-shrink: 0; }
.kits-progress-bar .unity-progress-bar { min-height: 5px; max-height: 5px; background-color: transparent; border-radius: 0; }
.kits-progress-bar .unity-progress-bar__background { height: 5px; min-height: 5px; max-height: 5px; background-color: #444a55; border-width: 0; border-radius: 0; }
.kits-progress-bar .unity-progress-bar__progress { height: 5px; border-radius: 0; background-color: #f1f2ed; }
.kits-progress-bar .unity-progress-bar__title { display: none; }
#ammo-container { width: 100%; flex-direction: column; align-items: flex-end; }
#ammo-label { color: #f1f2ed; font-size: 26px; letter-spacing: 1px; margin-bottom: 8px; -unity-font-definition: url("../RobotoMono-Medium.ttf"); }
#ammo-label.low-ammo { color: #edc279; }
#ammo-label.no-ammo { color: #ff9d8c; }
#reloading-label { color: #14171e; background-color: #f1f2ed; padding: 4px 10px; margin-bottom: 8px; font-size: 13px; letter-spacing: 0; }
#weapon-type-label, #ammo-reserve-label { color: #b1b6c2; font-size: 12px; }
#weapon-icon { width: 180px; height: 40px; background-size: contain; }
#reticle-container { position: relative; width: 100%; height: 100%; justify-content: center; align-items: center; }
#player-reticle { width: 256px; height: 256px; background-size: 100% 100%; -unity-background-scale-mode: scale-to-fit; transform-origin: center; }
.kits-reticle-cross{
    background-image: url("project://database/Assets/AddressableAssetsData/Art/Textures/reticle_cross.png?fileID=2800000&guid=ce642e64c261f4108a7153fa8cda2397&type=3#reticle_cross");
}

.kits-reticle-opencircular{
    background-image: url("project://database/Assets/AddressableAssetsData/Art/Textures/reticle_opencircular.png?fileID=2800000&guid=f1ed4489e26334a3584296723c7c5b9b&type=3#reticle_opencircular");
}

.kits-reticle-tcross{
    background-image: url("project://database/Assets/AddressableAssetsData/Art/Textures/reticle_tcross.png?fileID=2800000&guid=3b472d971cf4e42188683834e6f05a4b&type=3#reticle_tcross");
}

.kits-reticle-circularcross{
    background-image: url("project://database/Assets/AddressableAssetsData/Art/Textures/reticle_circularcross.png?fileID=2800000&guid=c957e948b81d34cc38ace0a4d898348f&type=3#reticle_circularcross");
}

.kits-icon-reload{
    background-image: url("project://database/Assets/AddressableAssetsData/Art/Textures/reticle_reload_circle.png?fileID=2800000&guid=f4b5f52c4eeaa494b874f69ad3ad6502&type=3#reticle_reload_circle");
}
/* Reticle anchors to the viewport, independently of preceding HUD instruments. */
#reticle-container { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
