.lab {
    flex-grow: 1;
    background-color: #10181f;
    color: #e5edf2;
    -unity-font-definition: url("project://database/Assets/Localization/Fonts/NotoSansCJKsc.asset");
    padding: 14px;
}
.heading { flex-direction: row; align-items: center; margin-bottom: 8px; }
.title { font-size: 25px; -unity-font-style: bold; margin-right: 20px; }
.subtitle { flex-grow: 1; color: #94acb9; font-size: 14px; }
.toolbar { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 7px; }
Button { color: #e5edf2; background-color: #263b48; border-color: #426173; border-width: 1px; border-radius: 4px; padding: 6px 12px; margin: 2px 6px 2px 0; }
Button:hover { background-color: #37586a; }
Button:active, Button.selected { background-color: #2e7186; border-color: #8ce0e5; }
Toggle { margin-left: 7px; margin-right: 10px; }
.settings Slider { flex-grow: 1; min-width: 210px; margin-right: 12px; }
.settings .unity-base-field__label { min-width: 65px; }
.views { flex-grow: 1; min-height: 0; }
.view-row { flex-direction: row; flex-grow: 1; flex-basis: 0; min-height: 0; }
.view-card { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; background-color: #1b2830; margin: 4px; border-color: #3b5261; border-width: 1px; }
.view-title { margin: 0; border-width: 0; border-bottom-width: 1px; border-radius: 0; -unity-text-align: middle-left; }
.view-image { flex-grow: 1; min-height: 0; }
.status { color: #a7dce3; font-size: 13px; margin-top: 8px; }
.help { color: #97a9b3; font-size: 12px; margin-top: 4px; white-space: normal; }
.hidden { display: none; }
.unity-base-text-field__input { background-color: #192b36; color: #e5edf2; }
.unity-toggle__input { min-width: 24px; }
.unity-base-slider__text-field { color: #e5edf2; }
