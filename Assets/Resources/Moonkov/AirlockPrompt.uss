.airlock-ui { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; align-items: center; justify-content: flex-end; padding-bottom: 40px; color: #ECECE6; -unity-font-definition: url("../../UI Toolkit/Fonts/Inter-Regular.ttf"); }
.airlock-ui.is-visible { display: flex; }
.airlock-card { width: 420px; max-width: 90%; padding: 16px 20px; background-color: rgba(7, 8, 10, 0.90); border-left-width: 3px; border-left-color: #f1f2ed; }
.airlock-caption { font-size: 11px; color: #f1f2ed; margin-bottom: 8px; }
.airlock-heading { flex-direction: row; align-items: center; margin-bottom: 10px; }
.airlock-key { border-width: 1px; border-color: #f1f2ed; color: #f1f2ed; font-size: 22px; width: 38px; height: 34px; margin-right: 12px; -unity-text-align: middle-center; }
.airlock-action { font-size: 20px; -unity-font-style: bold; white-space: normal; flex-shrink: 1; }
.airlock-range { font-size: 11px; color: #92999B; margin-bottom: 6px; }
.airlock-pressure { font-size: 14px; margin-bottom: 8px; color: #CACBC4; }
.airlock-row { padding: 5px 9px; font-size: 14px; color: #959B9D; border-left-width: 2px; border-left-color: rgba(0, 0, 0, 0); }
.airlock-row.is-selected { color: #f1f2ed; border-left-color: #f1f2ed; background-color: rgba(241,242,237,0.10); }
.airlock-feedback { font-size: 13px; margin-top: 9px; color: #d8e9dc; white-space: normal; }
.airlock-feedback.is-blocked { color: #EEAF85; }
.airlock-hint { font-size: 11px; color: #92999B; margin-top: 7px; }
.airlock-marker { position: absolute; width: 42px; height: 32px; border-width: 2px; border-color: #f1f2ed; background-color: rgba(241,242,237,0.10); }
.airlock-marker.is-blocked { border-color: #EEAF85; background-color: rgba(238, 175, 133, 0.08); }

.airlock-row.is-selected { border-left-width: 4px; border-left-color: #164bff; }
.airlock-key { background-color: #f1f2ed; color: #14171e; }
