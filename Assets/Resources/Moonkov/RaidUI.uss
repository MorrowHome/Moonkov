.raid-ui { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: #ECECE6; -unity-font-definition: url("../../UI Toolkit/Fonts/Inter-Regular.ttf"); }
.raid-ui Label { color: #ECECE6; -unity-text-align: middle-left; white-space: normal; }
.raid-status { position: absolute; left: 3%; bottom: 4%; padding: 18px 22px; background-color: rgba(7, 8, 10, 0.78); border-left-width: 3px; border-left-color: #FFE11A; border-radius: 0; }
.raid-caption { font-size: 10px; letter-spacing: 3px; margin-bottom: 14px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.raid-ui .raid-caption { color: #FFE11A; }
.raid-timer { font-size: 30px; letter-spacing: 2px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.raid-copy { font-size: 13px; white-space: normal; margin-top: 12px; margin-bottom: 14px; }
.raid-ui .raid-copy { color: rgba(236, 236, 230, 0.65); }
.raid-interaction-anchor { position: absolute; left: 24px; right: 24px; top: 58%; align-items: center; }
.raid-interaction { flex-direction: row; align-items: center; max-width: 500px; min-height: 62px; padding: 10px 17px 10px 11px; background-color: rgba(12, 17, 18, 0.88); border-width: 1px; border-color: rgba(220, 218, 198, 0.16); border-left-width: 2px; border-left-color: #d8c59a; opacity: 0; translate: 0 6px; transition-property: opacity, translate, border-left-color; transition-duration: 0.16s; }
.raid-interaction.is-visible { opacity: 1; translate: 0 0; }
.raid-ui .raid-interaction-key { width: 46px; height: 36px; flex-shrink: 0; margin: 0 13px 0 0; border-width: 1px; border-color: rgba(222, 215, 193, 0.48); border-bottom-width: 3px; background-color: rgba(222, 215, 193, 0.1); color: #ebe2cc; font-size: 11px; letter-spacing: 1px; -unity-text-align: middle-center; }
.raid-interaction-copy { flex-shrink: 1; min-width: 0; }
.raid-ui .raid-prompt { margin: 0; font-size: 14px; letter-spacing: 1px; color: #eee9dd; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Bold.ttf"); }
.raid-interaction-details { flex-direction: row; margin-top: 5px; }
.raid-ui .raid-interaction-state { margin: 0; color: #b8c5b7; font-size: 10px; letter-spacing: 2px; }
.raid-ui .raid-interaction-range { margin: 0 0 0 18px; color: #9da8a6; font-size: 10px; letter-spacing: 1px; }
.raid-interaction.is-empty { border-left-color: #7c8c88; }
.raid-ui .raid-interaction.is-empty .raid-interaction-state { color: #919d98; }
.raid-interaction.is-error { border-left-color: #dd9077; }
.raid-ui .raid-interaction.is-error .raid-interaction-key { border-color: #c88874; color: #efaa91; }
.raid-ui .raid-interaction.is-error .raid-prompt { color: #efb8a4; }
.raid-extraction-panel { position: absolute; right: 3%; top: 7%; min-width: 260px; max-width: 440px; padding: 13px 17px 15px 17px; background-color: rgba(12, 22, 22, 0.88); border-width: 1px; border-color: rgba(133, 195, 178, 0.22); border-right-width: 2px; border-right-color: #98ccba; opacity: 0; translate: 5px 0; transition-property: opacity, translate; transition-duration: 0.18s; }
.raid-extraction-panel.is-visible { opacity: 1; translate: 0 0; }
.raid-ui .raid-extraction { margin: 0; font-size: 16px; letter-spacing: 2px; -unity-text-align: middle-right; color: #c0e5d7; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Bold.ttf"); }
.raid-extraction-track { height: 3px; margin-top: 12px; background-color: rgba(161, 204, 187, 0.15); }
.raid-extraction-fill { height: 3px; width: 0; background-color: #b0dec9; transition-property: width; transition-duration: 0.12s; transition-timing-function: linear; }
.raid-receipt { position: absolute; right: 3%; bottom: 7%; min-width: 210px; padding: 11px 16px; background-color: rgba(12, 22, 22, 0.88); border-left-width: 2px; border-left-color: #a4c3aa; opacity: 0; translate: 8px 0; transition-property: opacity, translate; transition-duration: 0.2s; }
.raid-receipt.is-visible { opacity: 1; translate: 0 0; }
.raid-ui .raid-receipt-caption { margin: 0 0 6px 0; color: #92b09c; font-size: 10px; letter-spacing: 3px; }
.raid-ui .raid-receipt-copy { margin: 0; color: #dce9da; font-size: 14px; letter-spacing: 1px; }
.raid-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(7, 8, 10, 0.6); display: none; }
.raid-window { width: 620px; padding: 32px; background-color: rgba(9, 10, 13, 0.96); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); border-top-width: 3px; border-top-color: #FFE11A; border-radius: 0; }
.raid-inventory-window { width: 94%; height: 90%; padding: 24px; background-color: rgba(7, 8, 10, 0.96); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-top-width: 3px; border-top-color: #FFE11A; border-radius: 0; }
.raid-inventory-header { height: 42px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.raid-ui .raid-inventory-title { color: #ECECE6; font-size: 26px; letter-spacing: 4px; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Black.ttf"); }
.raid-inventory-host { flex-grow: 1; min-height: 0; }
.raid-health-host { display: none; }
.raid-inventory-tabs { flex-direction: row; flex-shrink: 0; margin-bottom: 10px; }
.raid-ui .raid-inventory-tabs .raid-tab { margin: 0 10px 0 0; height: 32px; min-width: 140px; color: #506354; background-color: #c8cebe; letter-spacing: 1px; }
.raid-ui .raid-inventory-tabs .raid-tab-active { color: #f1eee2; background-color: #485f51; }
.raid-oxygen-warning { position: absolute; left: 3%; top: 8%; max-width: 440px; padding: 12px 18px; background-color: rgba(20, 16, 10, 0.84); border-left-width: 3px; border-left-color: #e0ac51; font-size: 13px; white-space: normal; display: none; }
.raid-ui .raid-oxygen-warning { color: #edc279; }
.raid-ui .raid-oxygen-warning.oxygen-critical { color: #ff8c78; border-left-color: #e26049; }
.raid-ui .raid-inventory-header Button { color: #ECECE6; background-color: rgba(255, 255, 255, 0.06); }
.raid-ui .raid-inventory-header Button:hover { color: #07080A; background-color: #FF4D3A; }
.raid-ui .inventory-view Button { min-width: 0; margin: 0; min-height: 0; height: auto; }
.raid-ui .inventory-view .inventory-slot { height: 24%; }
.raid-title { font-size: 34px; letter-spacing: 3px; margin-bottom: 10px; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Black.ttf"); }
.raid-pack-grid { flex-direction: row; flex-wrap: wrap; height: 192px; }
.raid-pack-cell { width: 24%; height: 60px; margin-right: 1%; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.1); border-radius: 0; align-items: center; justify-content: center; }
.raid-pack-cell Label { font-size: 11px; }
.raid-pack-filled { background-color: rgba(255, 225, 26, 0.08); border-color: rgba(255, 225, 26, 0.45); }
.raid-result-overlay { background-color: rgba(7, 8, 10, 0.97); }
.raid-result-window { width: 780px; padding: 44px; }
.raid-stepper { flex-direction: row; margin-top: 12px; margin-bottom: 32px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.1); padding-bottom: 10px; }
.raid-stepper Label { flex-grow: 1; font-size: 11px; letter-spacing: 2px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.raid-ui .raid-stepper Label { color: rgba(236, 236, 230, 0.3); }
.raid-ui .raid-stepper .raid-step-active { color: #FFE11A; }
.raid-result-text { min-height: 200px; font-size: 26px; white-space: normal; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Light.ttf"); }
.raid-result-actions { flex-direction: row; flex-wrap: wrap; margin-top: 22px; }
.raid-ui Button { height: 42px; min-width: 120px; margin-right: 8px; margin-top: 8px; border-width: 0; border-radius: 0; color: #ECECE6; background-color: rgba(255, 255, 255, 0.06); font-size: 12px; letter-spacing: 3px; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Bold.ttf"); transition-property: background-color, color; transition-duration: 0.15s; }
.raid-ui Button:hover { background-color: rgba(255, 225, 26, 0.14); color: #FFE11A; }
.raid-ui Button:active { background-color: #FFE11A; color: #07080A; }
.raid-ui Button:disabled { color: rgba(236, 236, 230, 0.35); background-color: rgba(255, 255, 255, 0.03); }
.raid-ui .raid-primary { background-color: #FFE11A; color: #07080A; }
.raid-ui .raid-primary:hover { background-color: #ECECE6; color: #07080A; }
.raid-loadout { margin-top: 8px; }
.raid-loadout IntegerField { height: 34px; }
.raid-loadout .unity-base-field__label { color: rgba(236, 236, 230, 0.6); min-width: 220px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.raid-loadout .unity-base-field__input { color: #ECECE6; background-color: rgba(255, 255, 255, 0.05); border-width: 0; border-bottom-width: 1px; border-bottom-color: rgba(255, 225, 26, 0.5); border-radius: 0; }

.raid-inventory-window { width: 92%; max-width: 1440px; height: 88%; padding: 20px; background-color: #d9d7cc; border-color: #91a08c; border-top-width: 4px; border-top-color: #485f51; }
.raid-inventory-header { height: 44px; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: #acb2a0; padding-bottom: 10px; }
.raid-ui .raid-inventory-title { color: #2b3b32; font-size: 22px; letter-spacing: 2px; }
.raid-ui .raid-inventory-header Button { color: #334b3d; background-color: #c4cbb7; height: 32px; margin-top: 0; }
.raid-ui .raid-inventory-header Button:hover { color: #f1eee2; background-color: #884c43; }
