<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="RaidUI.uss" />
    <ui:Style src="UI/FieldTheme.uss" />
    <ui:VisualElement name="raidPresentation" class="raid-ui archive-ui" picking-mode="Ignore">
        <ui:VisualElement name="raidStatus" class="raid-status" picking-mode="Ignore">
            <ui:Label text="LUNAR EXPEDITION" class="raid-caption" />
            <ui:Label name="raidTimer" class="raid-timer" />
            <ui:Label name="raidClock" class="raid-caption" />

        </ui:VisualElement>
        <ui:VisualElement class="raid-cargo-instrument" picking-mode="Ignore"><ui:Label name="raidBag" class="raid-copy" /><ui:Label name="raidGrenade" class="raid-grenade" /></ui:VisualElement>
        <ui:VisualElement name="raidOxygenPanel" class="raid-oxygen-panel" picking-mode="Ignore">
            <ui:VisualElement class="raid-oxygen-heading" picking-mode="Ignore">
                <ui:Label name="raidOxygenReserve" class="raid-oxygen-reserve" picking-mode="Ignore" />
                <ui:Label name="raidOxygenTime" class="raid-oxygen-time" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="raid-oxygen-track" picking-mode="Ignore">
                <ui:VisualElement name="raidOxygenFill" class="raid-oxygen-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="raidOxygenAir" class="raid-oxygen-air" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="raidOxygenWarning" class="raid-oxygen-warning" picking-mode="Ignore" />
        <ui:VisualElement class="raid-interaction-anchor" picking-mode="Ignore">
            <ui:VisualElement name="raidInteraction" class="raid-interaction" picking-mode="Ignore">
                <ui:Label name="raidInteractionKey" text="E" class="raid-interaction-key" picking-mode="Ignore" />
                <ui:VisualElement class="raid-interaction-copy" picking-mode="Ignore">
                    <ui:Label name="raidPrompt" class="raid-prompt" picking-mode="Ignore" />
                    <ui:VisualElement name="raidInteractionDetails" class="raid-interaction-details" picking-mode="Ignore">
                        <ui:Label name="raidInteractionState" class="raid-interaction-state" picking-mode="Ignore" />
                        <ui:Label name="raidInteractionRange" class="raid-interaction-range" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="raidExtractionPanel" class="raid-extraction-panel" picking-mode="Ignore">
            <ui:Label name="raidExtraction" class="raid-extraction" picking-mode="Ignore" />
            <ui:VisualElement name="raidExtractionTrack" class="raid-extraction-track" picking-mode="Ignore">
                <ui:VisualElement name="raidExtractionFill" class="raid-extraction-fill" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="raidReceipt" class="raid-receipt" picking-mode="Ignore">
            <ui:Label text="CARGO" class="raid-receipt-caption" picking-mode="Ignore" />
            <ui:Label name="raidReceiptText" class="raid-receipt-copy" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="raidInventory" class="raid-overlay">
            <ui:VisualElement class="raid-inventory-window">
                <ui:VisualElement class="raid-inventory-header">
                    <ui:Label text="CHARACTER / CARRIED INVENTORY" class="raid-inventory-title" />
                    <ui:Button name="raidPackClose" text="CLOSE / TAB" />
                </ui:VisualElement>
                <ui:VisualElement class="raid-inventory-tabs">
                    <ui:Button name="raidEquipmentTab" text="EQUIPMENT" class="raid-tab raid-tab-active" />
                    <ui:Button name="raidHealthTab" text="HEALTH" class="raid-tab" />
                </ui:VisualElement>
                <ui:VisualElement name="raidInventoryHost" class="raid-inventory-host" />
                <ui:VisualElement name="raidHealthHost" class="raid-inventory-host raid-health-host" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="raidResult" class="raid-overlay raid-result-overlay">
            <ui:VisualElement class="raid-result-exhibit" picking-mode="Ignore" />
            <ui:VisualElement class="raid-result-window">
                <ui:Label text="EXPEDITION DEBRIEF" class="raid-caption" />
                <ui:VisualElement class="raid-stepper">
                    <ui:Label name="raidStep0" text="01 / RESULT" />
                    <ui:Label name="raidStep1" text="02 / CARGO" />
                    <ui:Label name="raidStep2" text="03 / STORAGE" />
                </ui:VisualElement>
                <ui:Label name="raidResultHeading" class="raid-result-heading" />
                <ui:Label name="raidResultText" class="raid-result-text" />
                <ui:VisualElement name="raidManifest" class="raid-manifest">
                    <ui:VisualElement class="raid-manifest-row"><ui:Label text="MOON DUST" class="raid-manifest-name" /><ui:Label name="raidManifestDust" class="raid-manifest-value" /></ui:VisualElement>
                    <ui:VisualElement class="raid-manifest-row"><ui:Label text="ALLOY" class="raid-manifest-name" /><ui:Label name="raidManifestAlloy" class="raid-manifest-value" /></ui:VisualElement>
                    <ui:VisualElement class="raid-manifest-row"><ui:Label text="ENERGY CELLS" class="raid-manifest-name" /><ui:Label name="raidManifestCells" class="raid-manifest-value" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="raidSaveStatus" class="raid-copy" />
                <ui:VisualElement name="raidLoadout" class="raid-loadout">
                    <ui:IntegerField name="raidCarryCells" label="ENERGY CELLS TO CARRY" is-delayed="true" />
                    <ui:Label name="raidLoadoutNote" class="raid-copy" />
                </ui:VisualElement>
                <ui:VisualElement class="raid-result-actions">
                    <ui:Button name="raidResultBack" text="BACK" />
                    <ui:Button name="raidResultNext" text="CONTINUE" />
                    <ui:Button name="raidDeploy" text="DEPLOY AGAIN" class="raid-primary" />
                    <ui:Button name="raidReturn" text="RETURN TO SHIP" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
