@import url("ArchiveTheme.uss");
@import url("Components/MoonkovControls.uss");
.bounty-mode-entry { min-height: 32px; padding: 6px 12px; margin-left: 12px; color: #f1f2ed; background-color: #111318; border-width: 1px; border-color: #565c69; font-size: 12px; }
.bounty-mode-entry:hover, .bounty-mode-entry:focus { border-color: #164BFF; }
.bounty-mode-modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(8,9,12,.90); }
.bounty-mode-window { width: 660px; max-width: 92%; max-height: 92%; }
.bounty-mode-modal .bounty-archive-window { position: relative; width: 100%; max-width: 100%; max-height: 100%; }
.bounty-mode-modal .terminal-window-header { flex-direction: row; border-bottom-width: 1px; padding-bottom: 12px; }
.bounty-mode-title { color: var(--archive-ink); font-size: 25px; }
.bounty-mode-copy { color: var(--archive-muted); font-size: 13px; white-space: normal; margin-bottom: 16px; }
.bounty-mode-modal .bounty-mode-card { min-height: 100px; flex-shrink: 0; flex-direction: column; height: auto; padding: 14px 18px; margin-bottom: 10px; align-items: flex-start; }
.bounty-mode-card-title { color: var(--mk-ink); font-size: 19px; margin-bottom: 6px; }
.bounty-mode-card-copy { color: var(--mk-muted); font-size: 13px; white-space: normal; }
.bounty-mode-modal .bounty-mode-selected { border-left-width: 3px; border-left-color: var(--mk-accent); }
.bounty-mode-selected > .mk-state-fx { opacity: .08; }
.bounty-mode-close { min-height: 34px; align-self: flex-end; padding: 6px 18px; }
.bounty-mode-message { color: var(--archive-muted); font-size: 12px; white-space: normal; margin-bottom: 10px; }
.bounty-hidden { display: none; }
