<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="home-card-contents" picking-mode="Ignore">
        <ui:VisualElement class="home-card-plate" picking-mode="Ignore" />
        <ui:VisualElement class="home-card-image" picking-mode="Ignore" />
        <ui:Label name="cardIndex" class="terminal-home-action-index" picking-mode="Ignore" />
        <ui:VisualElement class="home-card-copy" picking-mode="Ignore">
            <ui:Label name="cardTitle" class="terminal-home-action-name" picking-mode="Ignore" />
            <ui:Label name="cardSubtitle" class="terminal-home-action-caption" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label text="→" class="terminal-home-action-arrow" picking-mode="Ignore" />
        <ui:VisualElement class="home-card-focus-mark" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
