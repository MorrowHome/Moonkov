<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:moon="Unity.MP_FPS.Client">
    <ui:VisualElement name="primaryNavigation" class="terminal-nav" picking-mode="Ignore">
        <ui:ScrollView class="terminal-nav-scroll" mode="Horizontal" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Auto">
            <ui:VisualElement class="terminal-nav-tabs" name="terminalNavTabs">
                <ui:Button name="terminalTab0" class="terminal-tab" tooltip="SHIP"><ui:Label text="01" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="SHIP" class="terminal-tab-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab4" class="terminal-tab terminal-tab-major" tooltip="OPERATIONS"><moon:ArchiveCardFrame class="archive-card-frame" /><ui:VisualElement class="nav-entry-art nav-entry-operation" picking-mode="Ignore" /><ui:Label text="02" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="OPERATIONS" class="terminal-tab-label" picking-mode="Ignore" /><ui:Label text="↗" class="nav-entry-arrow" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab1" class="terminal-tab terminal-tab-major" tooltip="EQUIPMENT / PERSONAL STORAGE"><moon:ArchiveCardFrame class="archive-card-frame" /><ui:VisualElement class="nav-entry-art nav-entry-storage" picking-mode="Ignore" /><ui:Label text="03" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="STASH" class="terminal-tab-label" picking-mode="Ignore" /><ui:Label text="↗" class="nav-entry-arrow" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab2" class="terminal-tab terminal-tab-major" tooltip="HALO BUILD"><moon:ArchiveCardFrame class="archive-card-frame" /><ui:VisualElement class="nav-entry-art nav-entry-halo" picking-mode="Ignore" /><ui:Label text="04" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="HALO BUILD" class="terminal-tab-label" picking-mode="Ignore" /><ui:Label text="↗" class="nav-entry-arrow" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab3" class="terminal-tab" tooltip="SUPPLIERS"><ui:Label text="05" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="SUPPLIERS" class="terminal-tab-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab5" class="terminal-tab" tooltip="TASKS"><ui:Label text="06" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="TASKS" class="terminal-tab-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab6" class="terminal-tab" tooltip="BASE"><ui:Label text="07" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="BASE" class="terminal-tab-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab7" class="terminal-tab" tooltip="COMMS"><ui:Label text="08" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="COMMS" class="terminal-tab-label" picking-mode="Ignore" /></ui:Button>
                <ui:Button name="terminalTab8" class="terminal-tab" tooltip="SETTINGS"><ui:Label text="09" class="terminal-tab-index" picking-mode="Ignore" /><ui:Label text="SETTINGS" class="terminal-tab-label" picking-mode="Ignore" /></ui:Button>
                <ui:VisualElement class="terminal-nav-indicator" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:VisualElement class="terminal-nav-status" picking-mode="Ignore"><ui:VisualElement class="terminal-nav-dot" /><ui:Label class="terminal-nav-clock" /></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
