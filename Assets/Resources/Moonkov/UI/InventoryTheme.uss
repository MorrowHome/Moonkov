@import url("Components/MoonkovControls.uss");
@import url("ApprovedPages.uss");
.inventory-view { background-color: var(--mk-surface); color: var(--mk-ink); padding: 12px; }
.inventory-view Label { color: var(--mk-ink); }
.inventory-view Button { color: var(--mk-ink); letter-spacing: 0; }
.inventory-view .inventory-character { width: 43%; margin-right: 16px; }
.inventory-view.inventory-with-stash .inventory-character { width: 32%; margin-right: 16px; }
.inventory-view.inventory-with-stash .inventory-containers { width: 28%; margin-right: 16px; }
.inventory-view .inventory-stash,
.inventory-view .inventory-loot-pane { background-color: var(--mk-panel); border-color: var(--mk-line); border-top-color: var(--mk-ink); padding: 12px; }
.inventory-view.inventory-with-stash .inventory-character { border-width: 1px; border-color: var(--mk-line); padding: 12px; }
.inventory-view.inventory-with-stash .inventory-character-title { border-bottom-width: 1px; border-bottom-color: var(--mk-line); padding-bottom: 8px; margin-bottom: 8px; }
.inventory-view .inventory-character-title { font-size: 24px; letter-spacing: 1px; }
.inventory-view .inventory-character-title, .inventory-view .inventory-section-title { -unity-font-style: bold; }
.inventory-view .inventory-section-title { font-size: 20px; }
.inventory-view .inventory-caption { color: var(--mk-muted); font-size: 12px; letter-spacing: 0; }
.inventory-view .inventory-slot { width: 23%; height: 22%; background-color: var(--mk-panel); border-color: #636c7a; border-left-color: #636c7a; padding: 8px; }
.inventory-view .inventory-slot:hover { background-color: var(--archive-raised); border-color: var(--mk-ink); }
.inventory-view .inventory-slot:active { background-color: #172b54; }
.inventory-view .inventory-slot-0 { left: 0; top: 2%; }
.inventory-view .inventory-slot-1 { left: 0; top: 34%; }
.inventory-view .inventory-slot-2 { left: 0; top: 68%; }
.inventory-view .inventory-slot-3 { left: 77%; top: 9%; }
.inventory-view .inventory-slot-4 { left: 77%; top: 42%; }
.inventory-view .inventory-slot-5 { left: 77%; top: 76%; }
.inventory-view .stash-character-render { left: 10%; right: 10%; }
.inventory-view .inventory-slot-label { font-size: 11px; letter-spacing: 0; color: var(--mk-muted); }
.inventory-view .inventory-slot-item { font-size: 11px; color: var(--mk-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inventory-view .inventory-equipped { background-color: var(--mk-panel); border-left-width: 3px; border-left-color: var(--mk-accent); }
.inventory-view .inventory-container { border-bottom-color: var(--mk-line); margin-bottom: 16px; padding-bottom: 10px; }
.inventory-view .inventory-section-title { font-size: 16px; letter-spacing: 0; margin-bottom: 8px; }
.inventory-view .inventory-region-title { font-size: 11px; letter-spacing: 0; color: var(--mk-muted); }
.inventory-view .inventory-grid { background-color: var(--mk-panel); }
.inventory-view .inventory-item { border-width: 1px; border-color: var(--mk-line); background-color: var(--mk-surface); }
.inventory-view .inventory-item:hover { background-color: var(--mk-panel); border-color: var(--mk-ink); }
.inventory-view .inventory-item:focus,
.inventory-view .inventory-selected { border-width: 2px; border-color: var(--mk-accent); }
.inventory-view .inventory-selected > .mk-state-fx { opacity: 0.12; }
.inventory-view .inventory-item-label { font-size: 10px; color: var(--mk-ink); letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inventory-view .inventory-item-quantity { font-size: 11px; color: var(--mk-ink); background-color: var(--mk-panel); }
.inventory-view .inventory-hint { color: var(--mk-muted); border-top-color: var(--mk-line); font-size: 12px; }
.inventory-view .inventory-weight { font-size: 12px; }
.inventory-view .inventory-ghost { background-color: var(--mk-surface); border-color: var(--mk-accent); }
.inventory-view .terminal-window,
.inventory-view .terminal-context { background-color: var(--mk-surface); border-color: var(--mk-line); border-top-color: var(--mk-accent); }
.inventory-view .terminal-window-header { border-bottom-color: var(--mk-line); }
.inventory-view .terminal-window-header .terminal-heading { color: var(--mk-ink); font-size: 16px; }
.inventory-view .terminal-button { background-color: var(--mk-panel); color: var(--mk-ink); }
.inventory-view .terminal-button:hover { border-color: var(--mk-accent); }
.inventory-view .terminal-button:focus { border-width: 2px; border-color: var(--mk-accent); }
.inventory-view .terminal-button:disabled { color: var(--mk-muted); opacity: 0.45; }
.inventory-view .unity-base-field__label { color: var(--mk-muted); }
.inventory-view .unity-base-field__input { color: var(--mk-ink); background-color: var(--mk-panel); }

.inventory-view .archive-workshop { width: 720px; height: 78%; max-height: 88%; }
.inventory-view .inventory-item-label { font-size: 11px; }
.inventory-view .inventory-section-title { font-size: 20px; }
.inventory-view .inventory-item-art { margin-top: 12px; }
.inventory-view .inventory-item:hover { background-color: #20252d; }
.inventory-view.moonkov-controls-light .inventory-item:hover { background-color: #203252; }
/* High-density storage: three work areas, clean engraved cells, clear item focus. */
.inventory-view.inventory-with-stash { padding: 0; background-color: transparent; }
.inventory-view.inventory-with-stash .inventory-character { width: 34%; margin-right: 14px; padding: 12px; background-color: #08090c; border-color: #69717e; }
.inventory-view.inventory-with-stash .inventory-containers { width: 27%; margin-right: 14px; padding: 12px; background-color: #08090c; border-width: 1px; border-color: #69717e; }
.inventory-view.inventory-with-stash .inventory-stash { padding: 12px; background-color: #08090c; border-color: #69717e; }
.inventory-view .inventory-grid { background-color: #080b10; }
.inventory-view .inventory-item { border-width: 1px; border-color: #434a56; background-color: #101319; }
.inventory-view .inventory-item-art { left: 7%; right: 7%; top: 15%; bottom: 14%; }
.inventory-view .inventory-item-label { font-size: 11px; color: #bfc6d1; background-color: rgba(8,9,12,0.8); }
.inventory-view .inventory-item-quantity { font-size: 13px; color: #f1f2ed; background-color: #08090c; padding: 1px 3px; }
.inventory-view .inventory-item:hover { border-color: #f1f2ed; background-color: #1c2432; }
.inventory-view .inventory-item:focus,
.inventory-view .inventory-selected { border-width: 2px; border-color: #164bff; background-color: #112044; }
.inventory-view .inventory-slot { background-color: rgba(8,9,12,0.96); border-color: #7b8595; height: 23%; width: 26%; }
.inventory-view .inventory-slot-0 { left: 0; top: 0; }
.inventory-view .inventory-slot-1 { left: 0; top: 35%; }
.inventory-view .inventory-slot-2 { left: 0; top: 72%; }
.inventory-view .inventory-slot-3 { left: 74%; top: 6%; }
.inventory-view .inventory-slot-4 { left: 74%; top: 43%; }
.inventory-view .inventory-slot-5 { left: 74%; top: 76%; }
.inventory-view .inventory-slot-label { font-size: 12px; color: #bfc6d1; }
.inventory-view .inventory-character-title { font-size: 22px; -unity-font-style: normal; }
.inventory-view .inventory-section-title { font-size: 18px; -unity-font-style: normal; border-left-width: 3px; border-left-color: #164bff; padding-left: 8px; }
.inventory-view .inventory-hint { font-size: 12px; min-height: 32px; color: #d0d5dd; background-color: #08090c; padding: 6px 10px; }
.inventory-view.moonkov-controls-light { background-color: #101318; }
.inventory-view.moonkov-controls-light .inventory-grid { background-color: #10151e; }
.inventory-view.moonkov-controls-light .inventory-item { background-color: #101318; border-color: #929ba5; }
.inventory-view.moonkov-controls-light .inventory-item-label,
.inventory-view.moonkov-controls-light .inventory-item-quantity { color: #f1f2ed; background-color: #101318; }
.inventory-view.moonkov-controls-light .inventory-selected { border-color: #164bff; background-color: #122c67; }
.inventory-view.moonkov-controls-light .inventory-slot { background-color: #101318; border-color: #929ba5; }
.inventory-view.moonkov-controls-light .inventory-slot-label { color: #b1bbcc; }
.inventory-view.moonkov-controls-light .inventory-slot-item { color: #f1f2ed; }
