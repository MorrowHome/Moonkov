<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="RaidHealthStyles.uss" />
    <ui:VisualElement name="raidHealthPage" class="raid-health-page">
        <ui:VisualElement name="healthDiagram" class="health-diagram" />
        <ui:VisualElement class="health-actions">
            <ui:Button name="healthTreat" text="TREAT" />
            <ui:Button name="healthRefillOxygen" text="REFILL O₂" />
            <ui:Button name="healthEat" text="EAT" />
            <ui:Button name="healthDrink" text="DRINK" />
        </ui:VisualElement>
        <ui:VisualElement class="health-air-details">
            <ui:Label name="healthAir" class="health-caption" />
            <ui:Label name="healthOxygenTime" class="health-caption" />
        </ui:VisualElement>
        <ui:Label name="healthMedicalStatus" class="health-caption" />
        <ui:ScrollView class="health-conditions" mode="Vertical" horizontal-scroller-visibility="Hidden">
            <ui:Label name="healthConsequences" class="health-caption" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
