.research-quest {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 10px 16px 16px;
    background-color: #0a0a0e;
    color: #eeedf1;
    -unity-font-definition: url("../../../Localization/Fonts/NotoSansCJKsc-Regular.otf");
}

.research-quest.research-quest-en {
    -unity-font-definition: url("../../../UI Toolkit/Fonts/Inter-Regular.ttf");
}

.research-quest-header {
    height: 72px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
}

.research-quest .research-quest-back,
.research-quest .research-quest-legacy,
.research-quest .research-quest-listen,
.research-quest .research-quest-primary {
    margin: 0;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 0;
    border-width: 1px;
    border-color: #33333d;
    background-color: #15151b;
    color: #f0eff4;
    font-size: 17px;
}

.research-quest .research-quest-back {
    border-width: 0;
    background-color: #0a0a0e;
    padding-left: 0;
    padding-right: 20px;
}

.research-quest .research-quest-legacy {
    margin-left: 20px;
}

.research-quest-heading {
    flex-grow: 1;
    font-size: 40px;
    -unity-font-style: bold;
}

.research-quest-count {
    color: #adabb9;
    font-size: 17px;
}

.research-quest-viewport {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
}

.research-quest-wall {
    position: absolute;
    top: -10px;
    bottom: -10px;
    left: -13px;
    right: -13px;
}

.research-quest-cell {
    position: absolute;
    padding: 3px;
}

.research-quest .research-quest-card {
    flex-grow: 1;
    align-items: stretch;
    justify-content: flex-end;
    margin: 0;
    padding: 0;
    border-radius: 0;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.09);
    background-color: #17171c;
    overflow: hidden;
    color: #f2f1f6;
    transition-property: border-color;
    transition-duration: 145ms;
}

.research-quest .research-quest-paper {
    background-color: #d8d7df;
    color: #17171f;
}

.research-quest .research-quest-card:hover,
.research-quest .research-quest-card:focus {
    border-color: #6859ff;
}

.research-quest .research-quest-card:active {
    border-color: #b1a7ff;
}

.research-quest-art,
.research-quest-art-image {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
}

.research-quest-art-image {
    opacity: 0.88;
}

.research-quest-art-behind-prop {
    opacity: 0.57;
}

.research-quest-prop {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 0;
    bottom: 10%;
}

.research-quest-card-locked .research-quest-art {
    opacity: 0.76;
}

.research-quest-card-number {
    position: absolute;
    left: 19px;
    top: 16px;
    padding: 3px 8px;
    font-size: 13px;
    -unity-font-style: bold;
    color: white;
    background-color: #4637df;
}

.research-quest-card-copy {
    align-items: flex-start;
    padding: 10px 19px 14px;
    background-color: rgba(12, 12, 17, 0.92);
}

.research-quest-paper .research-quest-card-copy {
    background-color: rgba(235, 234, 240, 0.96);
}

.research-quest-card-title {
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.research-quest-card-state {
    margin-top: 1px;
    font-size: 13px;
    color: #c0bdcd;
}

.research-quest-paper .research-quest-card-state {
    color: #555362;
}

.research-quest-card-live .research-quest-card-state {
    color: #a89bff;
}

.research-quest-paper.research-quest-card-live .research-quest-card-state {
    color: #3e28ba;
}

.research-quest-detail {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.research-quest-poster {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    background-color: #15151a;
}

.research-quest-poster .research-quest-prop {
    left: 4%;
    right: 4%;
    top: 3%;
    bottom: 3%;
}

.research-quest-info {
    width: 42%;
    min-width: 350px;
    padding: 30px;
    margin-left: 6px;
    background-color: #14141a;
}

.research-quest-text {
    flex-grow: 1;
    min-height: 0;
}

.research-quest-line,
.research-quest-actions {
    flex-direction: row;
    align-items: center;
}

.research-quest-number {
    padding: 5px 9px;
    margin-right: 10px;
    background-color: #4637df;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
}

.research-quest-status {
    color: #c0bacf;
    font-size: 17px;
}

.research-quest-title {
    margin: 16px 0 18px;
    color: #f7f6fb;
    font-size: 40px;
    -unity-font-style: bold;
    white-space: normal;
}

.research-quest-goal {
    padding: 13px 12px;
    margin-bottom: 12px;
    border-left-width: 3px;
    border-left-color: #6859ff;
    background-color: #22212c;
    color: #f1eff8;
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.research-quest-copy,
.research-quest-feedback {
    color: #c1bdcc;
    font-size: 17px;
    white-space: normal;
}

.research-quest-feedback {
    color: #ffc4d0;
    margin-bottom: 10px;
}

.research-quest-actions {
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 14px;
}

.research-quest .research-quest-primary {
    background-color: #4637df;
    border-color: #6859ff;
    -unity-font-style: bold;
}

.research-quest .research-quest-primary:hover,
.research-quest .research-quest-primary:focus {
    background-color: #5846f5;
}

.research-quest .research-quest-listen:hover,
.research-quest .research-quest-listen:focus,
.research-quest .research-quest-legacy:hover,
.research-quest .research-quest-legacy:focus,
.research-quest .research-quest-back:hover,
.research-quest .research-quest-back:focus {
    color: #c2b9ff;
    border-color: #6859ff;
}

.research-quest .research-quest-primary:disabled {
    opacity: 0.58;
}

.research-quest-narrow .research-quest-header,
.research-quest-short .research-quest-header {
    height: 56px;
}

.research-quest-narrow .research-quest-card-number,
.research-quest-short .research-quest-card-number {
    top: 11px;
    left: 14px;
}

.research-quest-narrow .research-quest-card-copy,
.research-quest-short .research-quest-card-copy {
    padding: 5px 14px 11px;
}

.research-quest-narrow .research-quest-card-title,
.research-quest-short .research-quest-card-title {
    font-size: 17px;
}

.research-quest-narrow .research-quest-info,
.research-quest-short .research-quest-info {
    width: 51%;
    min-width: 0;
    padding: 14px;
}

.research-quest-narrow .research-quest-title,
.research-quest-short .research-quest-title {
    font-size: 26px;
    margin: 8px 0 10px;
}

.research-quest-reduced .research-quest-card {
    transition-duration: 0s;
}

.research-quest-raid-list {
    padding: 3px 0;
    flex-shrink: 0;
    -unity-font-definition: url("../../../Localization/Fonts/NotoSansCJKsc-Regular.otf");
}

.research-quest-raid-line {
    color: #f2f1f7;
    padding: 3px 7px;
    font-size: 13px;
    white-space: normal;
    background-color: rgba(14, 12, 22, 0.82);
}

.research-quest-interaction {
    position: absolute;
    left: 35%;
    right: 35%;
    bottom: 29%;
    align-items: center;
    -unity-font-definition: url("../../../Localization/Fonts/NotoSansCJKsc-Regular.otf");
}

.research-quest-interaction .research-quest-raid-line {
    -unity-text-align: middle-center;
    padding: 7px 13px;
    border-left-width: 3px;
    border-left-color: #6859ff;
}
