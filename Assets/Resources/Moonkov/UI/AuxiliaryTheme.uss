/* Non-raid records and diagnostics retain their existing bindings and visibility. */
.archive-records { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(8,9,12,0.68); }
.archive-records .score-table { width: 72%; max-width: 1100px; max-height: 80%; padding: 24px; background-color: #10141e; border-radius: 0; border-width: 1px; border-color: #687487; border-top-width: 4px; border-top-color: #164bff; }
.archive-records .archive-records-title { font-size: 30px; color: #f1f2ed; margin: 0 0 22px; }
.archive-records .table-header { padding: 12px 0; background-color: #172b54; border-bottom-width: 1px; border-bottom-color: #687487; }
.archive-records .header-cell { font-size: 14px; color: #f1f2ed; }
.archive-records .row-cell { font-size: 14px; color: #f1f2ed; padding: 8px; }
.archive-records #score-items { min-height: 64px; }
.archive-feed .action-feed-entry { border-radius: 0; padding: 6px 12px; font-size: 13px; color: #f1f2ed; background-color: rgba(8,9,12,0.9); border-left-width: 2px; border-left-color: #164bff; -unity-font-style: normal; }
.archive-diagnostics { position: absolute; left: 24px; top: 24px; width: 360px; padding: 14px; background-color: rgba(8,9,12,0.94); border-width: 1px; border-color: #687487; border-left-width: 3px; border-left-color: #164bff; }
.archive-diagnostics Label { color: #d4dae4; font-size: 13px; white-space: normal; margin-bottom: 8px; }
.archive-death { background-color: rgba(8,9,12,0.82); }
.archive-death .container { opacity: 1; background-color: transparent; background-image: none; border-width: 0; width: 70%; padding: 32px; }
.archive-death .archive-death-title { color: #f1f2ed; font-size: 48px; letter-spacing: 0; white-space: normal; border-left-width: 5px; border-left-color: #ad5144; padding-left: 20px; }
.archive-death .archive-death-caption { color: #b1b6c2; font-size: 13px; margin-top: 16px; }
