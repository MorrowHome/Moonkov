<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../ContainerUI.uss" />
    <ui:Style src="InventoryTheme.uss" />
    <ui:VisualElement name="containerInventory" class="inventory-view inventory-with-stash moonkov-controls" focusable="true">
        <ui:VisualElement name="inventoryBody" class="inventory-body">
            <ui:VisualElement name="lootPane" class="inventory-loot-pane" />
            <ui:VisualElement name="characterPane" class="inventory-character">
                <ui:Label text="DOLLSINGER" class="inventory-character-title" picking-mode="Ignore" />
                <ui:Label text="EQUIPMENT / FIELD LOADOUT" class="inventory-caption" picking-mode="Ignore" />
                <ui:VisualElement name="characterStage" class="inventory-character-stage">
                    <ui:VisualElement name="slotLayer" picking-mode="Ignore" class="inventory-slot-layer" />
                </ui:VisualElement>
                <ui:Label name="inventoryWeight" class="inventory-weight" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:ScrollView name="containerPane" mode="Vertical" class="inventory-containers" />
            <ui:VisualElement name="stashPane" class="inventory-stash" />
        </ui:VisualElement>
        <ui:Label name="inventoryHint" text="Drag to move · R rotate · Double click containers · Ctrl click transfer" class="inventory-hint" picking-mode="Ignore" />
        <ui:VisualElement name="inventoryGhost" class="inventory-ghost" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
