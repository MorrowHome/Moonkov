<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="RaidMapView.uss" />
    <ui:Label name="raidMapHint" text="[M] MAP" class="raid-map-hint" picking-mode="Ignore" />
    <ui:VisualElement name="raidMapOverlay" class="raid-map-overlay archive-ui">
        <ui:VisualElement name="raidMapWindow" class="raid-map-window">
            <ui:VisualElement name="raidMapCanvasHost" class="raid-map-canvas-host" />
            <ui:VisualElement class="map-place">
                <ui:VisualElement class="map-place-copy" picking-mode="Ignore">
                    <ui:Label text="THEOPHILUS" class="map-place-name" />
                    <ui:Label name="raidMapStatus" class="map-place-status" />
                </ui:VisualElement>
                <ui:Button name="raidMapDetails" text="MAP INFO" class="map-text-button" />
            </ui:VisualElement>
            <ui:Button name="raidMapClose" text="×" tooltip="CLOSE / M" class="map-close map-control" />
            <ui:VisualElement name="raidMapSidebar" class="map-info">
                <ui:Label name="raidMapExtraction" class="map-info-exit" />
                <ui:Label name="raidMapObjective" class="map-info-copy" />
                <ui:Label name="raidMapSupplies" class="map-info-copy" />
                <ui:Label name="raidMapPosition" class="map-info-copy" />
                <ui:Label name="raidMapLegend" class="map-info-caption" />
                <ui:VisualElement name="raidMapSupplyKey" class="map-key">
                    <ui:Label text="SUPPLIES" class="map-key-supply" />
                    <ui:Label text="MEDICAL" class="map-key-medical" />
                    <ui:Label text="INDUSTRIAL" class="map-key-industrial" />
                    <ui:Label text="EQUIPMENT" class="map-key-equipment" />
                </ui:VisualElement>
                <ui:Label name="raidMapNavigation" class="map-info-copy" />
                <ui:Button name="raidMapClearPin" text="CLEAR PIN" class="map-text-button map-clear" />
            </ui:VisualElement>
            <ui:VisualElement class="map-layers map-control-group">
                <ui:Button name="raidMapSuppliesLayer" text="SUPPLY LAYER" class="map-text-button" />
            </ui:VisualElement>
            <ui:VisualElement class="map-navigation">
                <ui:VisualElement class="map-control-group map-single-control">
                    <ui:Button name="raidMapFull" tooltip="FULL MAP" class="map-control"><ui:VisualElement class="map-icon map-full-icon" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="map-control-group map-single-control">
                    <ui:Button name="raidMapCenter" tooltip="CENTER ON ME" class="map-control"><ui:VisualElement class="map-icon map-center-icon" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="map-control-group">
                    <ui:Button name="raidMapZoomIn" tooltip="ZOOM IN" class="map-control"><ui:VisualElement class="map-icon map-in-icon" picking-mode="Ignore" /></ui:Button>
                    <ui:Button name="raidMapZoomOut" tooltip="ZOOM OUT" class="map-control map-separated"><ui:VisualElement class="map-icon map-out-icon" picking-mode="Ignore" /></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="raidMapZoom" class="map-zoom" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
