.lan-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.lan-entry { position: absolute; right: 28px; top: 22px; min-width: 156px; height: 38px; padding: 4px 16px; background-color: #d9ec9b; color: #161b19; font-size: 14px; border-width: 1px; border-color: #839357; border-radius: 0; }
.lan-entry:hover { background-color: #ebffc0; }
.lan-modal { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(6,12,17,0.94); }
.lan-window { width: 960px; max-width: 95%; height: 700px; max-height: 94%; padding: 24px 28px 16px; background-color: #e9e7dd; color: #192120; border-width: 1px; border-color: #888d81; border-top-width: 5px; border-top-color: #c5df80; }
.lan-header { flex-direction: row; justify-content: space-between; align-items: flex-start; border-bottom-width: 1px; border-color: #9b9f95; padding-bottom: 16px; flex-shrink: 0; }
.lan-eyebrow { font-size: 11px; letter-spacing: 3px; color: #54615a; margin-bottom: 8px; }
.lan-title { font-size: 32px; -unity-font-style: bold; letter-spacing: 2px; }
.lan-close { min-width: 90px; height: 32px; }
.lan-subtitle { margin: 12px 0 18px; color: #536459; font-size: 13px; flex-shrink: 0; }
.lan-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.lan-browse, .lan-roster { width: 53%; padding-right: 26px; border-right-width: 1px; border-color: #a7ad9f; }
.lan-create, .lan-briefing { flex-grow: 1; padding-left: 26px; min-width: 0; }
.lan-section-heading { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.lan-section-title { font-size: 17px; -unity-font-style: bold; margin-bottom: 12px; }
.lan-section-heading .lan-section-title { margin-bottom: 0; }
.lan-room-list { flex-grow: 1; min-height: 60px; }
.lan-members { flex-grow: 1; margin-top: 12px; }
.lan-room-row { height: auto; min-height: 68px; flex-direction: column; align-items: flex-start; justify-content: center; margin: 0 0 8px; padding: 10px 14px; border-left-width: 3px; border-left-color: #5c7965; background-color: #d8ddcf; }
.lan-row-title { font-size: 16px; color: #192120; }
.lan-row-detail { font-size: 11px; color: #54615a; margin-top: 5px; }
.lan-direct { margin-top: 16px; padding-top: 14px; border-top-width: 1px; border-color: #a7ad9f; flex-shrink: 0; }
.lan-window .unity-base-field { margin: 0 0 10px; min-height: 30px; flex-shrink: 0; }
.lan-window .unity-base-field__label { min-width: 124px; color: #465448; font-size: 13px; align-self: center; }
.lan-window .unity-base-field__input { background-color: #f5f4ed; border-color: #9b9f95; border-width: 1px; color: #192120; padding: 4px 8px; font-size: 14px; }
.lan-window Button { border-radius: 0; border-width: 1px; border-color: #879584; background-color: #e1e5d8; color: #263b2c; padding: 6px 12px; min-height: 32px; font-size: 13px; flex-shrink: 0; }
.lan-window Button:hover { border-color: #3b5d44; background-color: #d0dbc3; }
.lan-window Button:focus { border-color: #205b44; }
.lan-window .lan-primary { background-color: #b7d87e; color: #192120; border-color: #648740; min-height: 42px; margin: 12px 0 0; -unity-font-style: bold; }
.lan-window .lan-primary:hover { background-color: #ccec95; }
.lan-window .lan-dark-button { background-color: #24382c; color: #e7f1db; min-height: 38px; margin: 10px 0 0; }
.lan-window .lan-dark-button:hover { background-color: #38533e; }
.lan-window .lan-danger { color: #8c423b; background-color: transparent; margin-top: 12px; border-color: #ba9d91; }
.lan-window Button:disabled { opacity: 0.45; }
.lan-small, .lan-muted { color: #657061; font-size: 12px; white-space: normal; margin: 8px 0; flex-shrink: 0; }
.lan-body { font-size: 15px; white-space: normal; color: #2b4032; margin: 0 0 12px; }
.lan-address { background-color: #d9dfce; color: #243c2b; padding: 10px 12px; font-size: 12px; white-space: normal; margin: 0 0 8px; }
.lan-member-row { flex-direction: row; align-items: center; min-height: 48px; margin-bottom: 6px; padding: 8px; background-color: #dce0d3; border-bottom-width: 1px; border-color: #c0c8b6; }
.lan-member-index { width: 30px; font-size: 12px; color: #78926c; }
.lan-member-name { flex-grow: 1; font-size: 15px; white-space: normal; }
.lan-member-state { font-size: 11px; color: #687361; }
.lan-is-ready .lan-member-state { color: #2a743e; -unity-font-style: bold; }
.lan-footer { flex-direction: row; justify-content: space-between; border-top-width: 1px; border-color: #a7ad9f; margin-top: 18px; padding-top: 12px; flex-shrink: 0; }
.lan-status { color: #486241; font-size: 12px; white-space: normal; flex-grow: 1; }
.lan-status.lan-error { color: #ad3833; }
.lan-footer-code { color: #7a8275; font-size: 10px; margin-left: 12px; align-self: flex-end; }
.lan-hidden { display: none; }
