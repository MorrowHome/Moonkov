.lan-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-font-definition: url("/Assets/Localization/Fonts/NotoSansCJKsc-Regular.otf"); }
.lan-entry { position: absolute; right: 28px; top: 22px; height: 40px; padding: 0 20px; background-color: #15233e; color: #eff3ff; border-width: 1px; border-color: #5975b3; border-radius: 4px; font-size: 15px; }
.lan-entry:hover, .lan-entry:focus { background-color: #254bb3; border-color: #96b0ff; }
.lan-screen { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #080e1a; color: #f0f3fa; }
.lan-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("ApprovedHome/HomeDarkBackdrop.png"); background-size: cover; background-position: center; opacity: 0.14; }
.lan-shell { flex-grow: 1; padding: 34px 44px 20px; }
.lan-header { flex-direction: row; align-items: center; margin-bottom: 28px; flex-shrink: 0; }
.lan-heading { flex-grow: 1; }
.lan-title { font-size: 34px; -unity-font-style: bold; color: #f0f3fa; margin: 0 0 6px; }
.lan-subtitle { font-size: 14px; color: #a9b7d2; }
.lan-identity { width: 230px; margin: 0 24px 0 12px; }
.lan-identity .unity-base-field__label { min-width: 64px; font-size: 13px; color: #a9b7d2; align-self: center; }
.lan-screen Button { min-height: 38px; padding: 8px 18px; margin: 0; border-width: 1px; border-color: transparent; border-radius: 4px; color: #e6edfc; background-color: transparent; font-size: 14px; transition-property: background-color, border-color; transition-duration: 0.14s; }
.lan-screen Button:hover { background-color: #24314c; }
.lan-screen Button:focus { border-color: #9bb5ff; }
.lan-screen Button:active { background-color: #344d80; }
.lan-screen Button:disabled { color: #8492ae; background-color: #1b273d; border-color: #293753; opacity: 1; }
.lan-screen .lan-primary { min-height: 46px; min-width: 164px; background-color: #2455e6; color: #ffffff; -unity-font-style: bold; }
.lan-screen .lan-primary:hover { background-color: #396af6; }
.lan-screen .lan-primary:active { background-color: #1c42b4; }
.lan-screen .lan-primary:disabled { background-color: #1d2c4b; color: #8799bf; }
.lan-screen .lan-secondary { border-color: #495d82; background-color: #142139; }
.lan-screen .lan-secondary:hover { background-color: #233859; border-color: #7895cc; }
.lan-screen .lan-quiet { color: #c4aeb3; }
.lan-screen .lan-quiet:hover { color: #ffd9df; background-color: #3c2434; }
.lan-screen .lan-back { min-width: 82px; }
.lan-browser, .lan-lobby { flex-grow: 1; min-height: 0; }
.lan-navigation { flex-direction: row; margin-bottom: 22px; border-bottom-width: 1px; border-color: #344159; flex-shrink: 0; }
.lan-screen .lan-tab { padding: 10px 24px 14px; margin-right: 20px; min-height: 48px; color: #a9b7d2; border-radius: 0; border-bottom-width: 2px; }
.lan-screen .lan-tab.lan-selected { color: #ffffff; border-bottom-color: #668dff; background-color: transparent; }
.lan-workspace { flex-direction: row; flex-grow: 1; min-height: 0; }
.lan-primary-area { flex-grow: 2; flex-basis: 0; min-width: 0; margin-right: 30px; background-color: rgba(11,20,36,0.94); border-radius: 8px; padding: 22px 26px; }
.lan-page { flex-grow: 1; min-height: 0; }
.lan-list-heading { flex-direction: row; align-items: center; margin-bottom: 16px; flex-shrink: 0; }
.lan-section-title { font-size: 21px; -unity-font-style: bold; margin: 0 0 20px; color: #f0f3fa; }
.lan-list-heading .lan-section-title { margin: 0; }
.lan-count { font-size: 13px; color: #a9b7d2; margin-left: 14px; flex-grow: 1; }
.lan-room-list { flex-grow: 1; min-height: 0; }
.lan-room-list > .unity-scroll-view__content-viewport { min-width: 0; }
.lan-screen .lan-room-row { flex-direction: row; align-items: center; padding: 16px 10px; min-height: 96px; border-radius: 0; border-bottom-width: 1px; border-bottom-color: #2b3b58; flex-shrink: 0; }
.lan-screen .lan-room-row:hover, .lan-screen .lan-room-row:focus { background-color: #1b3058; }
.lan-room-art { width: 72px; height: 62px; flex-shrink: 0; background-image: url("ApprovedHome/CardMoon.png"); background-size: cover; border-radius: 4px; margin-right: 18px; }
.lan-clash-art { background-image: url("ApprovedHome/CardIndustrial.png"); }
.lan-row-copy { flex-grow: 1; min-width: 0; }
.lan-row-title { color: #f0f3fa; font-size: 17px; margin-bottom: 7px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; }
.lan-row-detail { color: #a9b7d2; font-size: 12px; -unity-text-align: middle-left; }
.lan-row-count { color: #cbd7ef; font-size: 14px; margin: 0 20px; }
.lan-row-action { color: #9fbbff; font-size: 14px; }
.lan-empty-state { flex-grow: 1; justify-content: center; align-items: center; min-height: 160px; padding: 20px; }
.lan-empty-title { font-size: 22px; color: #f0f3fa; margin-bottom: 12px; }
.lan-empty-state .lan-copy { -unity-text-align: middle-center; margin-bottom: 22px; }
.lan-companion { flex-grow: 1; flex-basis: 0; min-width: 260px; max-width: 420px; background-color: #101b30; border-radius: 8px; overflow: hidden; }
.lan-moon-art { flex-grow: 1; min-height: 130px; background-image: url("ApprovedHome/CardMoon.png"); background-size: cover; background-position: center; }
.lan-companion-copy { padding: 24px; }
.lan-feature-title { font-size: 25px; -unity-font-style: bold; color: #f0f3fa; margin-bottom: 14px; }
.lan-copy { color: #c0cce2; font-size: 14px; white-space: normal; margin: 0 0 14px; }
.lan-muted { color: #a4b3cf; font-size: 12px; white-space: normal; margin: 8px 0; }
.lan-note-rule { height: 1px; background-color: #34445f; margin: 14px 0 20px; }
.lan-note-title { color: #d3def3; font-size: 14px; margin-bottom: 8px; }
.lan-form-scroll { flex-grow: 1; min-height: 0; }
.lan-screen .lan-field { flex-direction: column; margin: 0 0 16px; flex-shrink: 0; }
.lan-screen .lan-field .unity-base-field__label { color: #c0cce2; font-size: 14px; margin: 0 0 9px; padding: 0; min-width: 0; }
.lan-screen .unity-base-field__input { min-height: 38px; padding: 6px 12px; background-color: #0b1426; color: #f0f3fa; border-width: 1px; border-color: #4c6086; border-radius: 4px; }
.lan-screen .unity-base-text-field__input { color: #f0f3fa; font-size: 15px; }
.lan-screen .unity-base-field__input:focus { border-color: #91acff; }
.lan-field-label { color: #c0cce2; font-size: 14px; margin-bottom: 9px; }
.lan-mode-choices { flex-direction: row; margin-bottom: 18px; flex-shrink: 0; }
.lan-screen .lan-mode-choice { flex-grow: 1; flex-basis: 0; flex-direction: column; align-items: flex-start; padding: 15px; border-color: #3b4d6c; margin-right: 10px; background-color: #111d32; min-height: 84px; }
.lan-screen .lan-mode-choice.lan-selected { border-color: #7699ff; background-color: #1b3470; }
.lan-mode-name { font-size: 18px; color: #f0f3fa; margin-bottom: 7px; }
.lan-mode-description { font-size: 12px; white-space: normal; color: #bdcbea; }
.lan-form-action { flex-direction: row; align-items: center; justify-content: space-between; border-top-width: 1px; border-color: #344159; padding-top: 16px; margin-top: 12px; flex-shrink: 0; }
.lan-form-action .lan-muted { margin-right: 18px; flex-shrink: 1; }
.lan-advanced { margin: 12px 0; flex-shrink: 0; }
.lan-screen .lan-advanced > .unity-foldout__toggle { background-color: transparent; color: #bac9e5; font-size: 13px; margin: 0; padding: 8px 0; }
.lan-screen .lan-advanced > .unity-foldout__content { margin: 12px 0 0; }
.lan-screen .unity-toggle__text { color: #bac9e5; }
.lan-lobby-content { flex-direction: row; flex-grow: 1; min-height: 0; }
.lan-roster { flex-grow: 2; flex-basis: 0; min-width: 0; padding: 26px; margin-right: 30px; background-color: rgba(11,20,36,0.94); border-radius: 8px; }
.lan-room-title { font-size: 27px; -unity-font-style: bold; color: #f0f3fa; margin-bottom: 16px; white-space: normal; }
.lan-roster-heading { flex-direction: row; align-items: center; margin-bottom: 12px; }
.lan-roster-heading .lan-copy { margin: 0; }
.lan-roster-heading .lan-count { -unity-text-align: middle-right; }
.lan-members { flex-grow: 1; min-height: 0; }
.lan-member-row { flex-direction: row; align-items: center; min-height: 82px; padding: 14px 4px; border-bottom-width: 1px; border-color: #2a3a55; }
.lan-member-avatar { width: 44px; height: 44px; background-color: #243859; border-radius: 6px; margin-right: 15px; align-items: center; justify-content: center; }
.lan-member-initial { font-size: 18px; color: #d4e1fc; }
.lan-member-copy { flex-grow: 1; min-width: 0; }
.lan-member-name { font-size: 17px; color: #f0f3fa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lan-member-role { font-size: 12px; color: #a6b8d9; margin-top: 5px; }
.lan-member-state { font-size: 13px; color: #f0c7a0; min-width: 62px; -unity-text-align: middle-right; }
.lan-ready-dot { width: 6px; height: 6px; border-radius: 3px; margin: 0 9px; background-color: #d6a97a; }
.lan-is-ready .lan-ready-dot { background-color: #85d9ba; }
.lan-is-ready .lan-member-state { color: #9ae5cc; }
.lan-briefing { flex-grow: 1; flex-basis: 0; min-width: 260px; max-width: 420px; background-color: #101b30; border-radius: 8px; padding: 0 22px 18px; }
.lan-mode-art { height: 150px; margin: 0 -22px 22px; background-image: url("ApprovedHome/CardMoon.png"); background-size: cover; background-position: center; }
.lan-mode-art.lan-clash-art { background-image: url("ApprovedHome/CardIndustrial.png"); }
.lan-address { white-space: normal; font-size: 13px; color: #c1d0ed; margin-bottom: 12px; }
.lan-launch-bar { flex-direction: row; align-items: center; padding: 20px 0 0; margin-top: 22px; border-top-width: 1px; border-color: #344159; flex-shrink: 0; }
.lan-launch-summary { flex-grow: 1; min-width: 0; }
.lan-launch-title { font-size: 19px; color: #f0f3fa; }
.lan-launch-bar Button { margin-left: 14px; }
.lan-launch-bar .lan-muted { margin-bottom: 0; }
.lan-footer { flex-direction: row; align-items: center; margin-top: 22px; flex-shrink: 0; min-height: 22px; }
.lan-status-dot { width: 5px; height: 5px; border-radius: 3px; background-color: #7899d9; margin-right: 10px; }
.lan-status { color: #b0c1df; font-size: 12px; flex-grow: 1; white-space: normal; }
.lan-status.lan-error { color: #ffafb9; }
.lan-footer-note { font-size: 12px; color: #96a9ca; margin-left: 24px; }
.lan-compact .lan-shell { padding: 22px 24px 16px; }
.lan-compact .lan-header { margin-bottom: 18px; }
.lan-compact .lan-companion { min-width: 220px; }
.lan-compact .lan-primary-area, .lan-compact .lan-roster { padding: 18px; margin-right: 18px; }
.lan-compact .lan-companion-copy { padding: 18px; }
.lan-compact .lan-companion-copy .lan-note-rule, .lan-compact .lan-companion-copy .lan-note-title, .lan-compact .lan-companion-copy .lan-muted { display: none; }
.lan-compact .lan-launch-bar Button { margin-left: 8px; min-width: 0; padding: 8px 14px; }
.lan-compact .lan-room-art { width: 54px; height: 54px; margin-right: 12px; }
.lan-compact .lan-row-count { margin: 0 12px; }
.lan-small .lan-companion, .lan-small .lan-briefing { display: none; }
.lan-small .lan-primary-area, .lan-small .lan-roster { margin-right: 0; }
.lan-small .lan-identity { width: 180px; margin-right: 12px; }
.lan-small .lan-identity .unity-base-field__label { display: none; }
.lan-small .lan-launch-bar { flex-wrap: wrap; }
.lan-small .lan-launch-summary { flex-basis: 100%; margin-bottom: 14px; }
.lan-small .lan-launch-bar Button { margin-left: 0; margin-right: 10px; }
.lan-small .lan-footer-note { display: none; }
.lan-hidden { display: none; }
