<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="OnlineSquadStyles.uss" />
    <ui:VisualElement name="onlineLobby" class="online-squad-screen">
        <ui:VisualElement class="online-header">
            <ui:Button name="onlineBack" text="仓库" class="online-back" />
            <ui:Label text="远征小队" class="online-title" />
            <ui:Label name="onlineCount" class="online-secondary" />
            <ui:Button name="onlineCopy" text="复制队伍码" class="online-code" />
        </ui:VisualElement>
        <ui:VisualElement name="onlineStageHost" class="online-stage-host">
            <ui:Image name="onlineStage" class="online-stage" picking-mode="Ignore" />
            <ui:VisualElement name="onlineMembers" class="online-members" />
        </ui:VisualElement>
        <ui:VisualElement class="online-controls">
            <ui:VisualElement class="online-personal">
                <ui:DropdownField name="onlineCharacter" label="角色" choices="DOLLSINGER,HATSUNE MIKU,SHIAN" index="0" />
                <ui:DropdownField name="onlinePose" label="姿态" choices="自动,抱臂,敬礼,比心,撒娇" index="0" />
            </ui:VisualElement>
            <ui:VisualElement name="onlineEntry" class="online-entry">
                <ui:Button name="onlineCreate" text="创建小队" class="online-primary" />
                <ui:TextField name="onlineInvite" label="队伍码" max-length="8" />
                <ui:Button name="onlineJoin" text="加入小队" />
            </ui:VisualElement>
            <ui:VisualElement name="onlineParty" class="online-party">
                <ui:VisualElement name="onlineSettings" class="online-settings">
                    <ui:RadioButtonGroup name="onlineMode" label="玩法" choices="合作,好友对抗" value="0" />
                    <ui:Toggle name="onlinePublic" label="寻找其他队伍" />
                </ui:VisualElement>
                <ui:RadioButtonGroup name="onlineTeam" label="队伍" choices="A 队,B 队" value="0" />
                <ui:VisualElement class="online-actions">
                    <ui:Button name="onlineLeave" text="离队" class="online-quiet" />
                    <ui:Button name="onlineCancel" text="取消等待" />
                    <ui:Button name="onlineRetry" text="重试加入" />
                    <ui:Button name="onlineReturn" text="返回小队" />
                    <ui:Button name="onlineReady" text="准备" />
                    <ui:Button name="onlineStart" text="出发" class="online-primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="online-bottom">
            <ui:Label name="onlineStatus" class="online-status" />
            <ui:Foldout name="onlineOptions" text="连接设置" value="false" class="online-options">
                <ui:Toggle name="onlineReduceMotion" label="减少动态效果" />
                <ui:VisualElement name="onlineAdvancedHost" />
            </ui:Foldout>
        </ui:VisualElement>
        <ui:VisualElement name="onlineReconnectHost" class="online-reconnect" />
    </ui:VisualElement>
</ui:UXML>
