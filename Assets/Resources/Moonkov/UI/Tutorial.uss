.tutorial-card {
    position: absolute;
    left: 24px;
    bottom: 64px;
    width: 480px;
    max-width: 90%;
    padding: 20px;
    background-color: rgb(24, 25, 27);
    border-left-width: 2px;
    border-left-color: rgb(112, 184, 255);
    color: rgb(237, 238, 240);
    flex-shrink: 0;
}
.tutorial-card .tutorial-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 10px; white-space: normal; }
.tutorial-card .tutorial-copy { font-size: 18px; white-space: normal; margin-bottom: 14px; color: rgb(206, 208, 213); }
.tutorial-card .tutorial-actions { flex-direction: row; flex-wrap: wrap; }
.tutorial-card Button { font-size: 18px; min-height: 36px; margin-right: 8px; margin-bottom: 6px; padding-left: 12px; padding-right: 12px; }
.tutorial-off { display: none; }

.tutorial-card.tutorial-inline { position: relative; left: auto; bottom: auto; width: auto; max-width: none; flex-direction: row; align-items: center; margin-top: 10px; padding: 12px 18px; min-height: 78px; }
.tutorial-inline .tutorial-title { display: none; }
.tutorial-inline .tutorial-copy { flex-grow: 1; flex-shrink: 1; margin-bottom: 0; margin-right: 18px; }
.tutorial-inline .tutorial-actions { flex-shrink: 0; }
