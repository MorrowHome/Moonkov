.tutorial-card {
    position: absolute;
    left: 24px;
    bottom: 20px;
    width: 392px;
    max-width: 92%;
    padding: 12px 14px;
    background-color: rgb(24, 25, 27);
    border-left-width: 2px;
    border-left-color: rgb(112, 184, 255);
    color: rgb(237, 238, 240);
    flex-shrink: 0;
}
.tutorial-card .tutorial-title { font-size: 18px; -unity-font-style: bold; margin: 0 0 4px; white-space: normal; }
.tutorial-card .tutorial-copy { font-size: 15px; white-space: normal; margin: 0 0 10px; color: rgb(206, 208, 213); }
.tutorial-card .tutorial-actions { flex-direction: row; flex-wrap: wrap; }
.tutorial-card Button {
    font-size: 14px; min-height: 36px; margin: 0 8px 4px 0; padding: 0 10px;
    background-image: none; background-color: #252a31; color: #edeef0;
    border-width: 1px; border-color: #515a67;
}
.tutorial-card Button:hover, .tutorial-card Button:focus { background-color: #333c49; border-color: #9ab0ce; }
.tutorial-card .tutorial-primary { background-color: #70b8ff; color: #0c1a2a; border-color: #70b8ff; -unity-font-style: bold; }
.tutorial-card .tutorial-primary:hover, .tutorial-card .tutorial-primary:focus { background-color: #a6d3ff; border-color: #c5e1ff; }
.tutorial-card Button:active { opacity: 0.82; }
.tutorial-off { display: none; }
#stashScreen.halos-subject-open > .tutorial-card { display: none; }
#stashScreen.terminal-is-loadout.tutorial-guiding #stashDeploy { display: none; }

.tutorial-card.tutorial-inline { position: relative; left: auto; bottom: auto; width: auto; max-width: none; flex-direction: row; align-items: center; margin-top: 6px; padding: 6px 12px; min-height: 48px; }
.tutorial-inline .tutorial-title { display: none; }
.tutorial-inline .tutorial-copy { flex-grow: 1; flex-shrink: 1; margin-bottom: 0; margin-right: 18px; }
.tutorial-inline .tutorial-actions { flex-shrink: 0; }
