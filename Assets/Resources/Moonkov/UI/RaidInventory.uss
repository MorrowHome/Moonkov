.inventory-view.inventory-raid { --mk-surface: #101416; --mk-panel: #191f21; --mk-line: #414b4e; --mk-ink: #eeeee6; --mk-muted: #b3bcb9; --mk-accent: #c8cfaa; background-color: #101416; padding: 0; min-height: 0; -unity-font-definition: url("/Assets/Localization/Fonts/NotoSansCJKsc-Regular.otf"); }
.inventory-raid Label, .inventory-raid Button, .raid-inventory-window Label, .raid-inventory-window Button { -unity-font-definition: url("/Assets/Localization/Fonts/NotoSansCJKsc-Regular.otf"); letter-spacing: 0; }
.inventory-raid .inventory-body { min-height: 0; }
.inventory-raid .inventory-character { width: 26%; max-width: 360px; flex-shrink: 0; margin-right: 0; padding: 8px; background-color: #171c1e; }
.inventory-raid .field-carried, .inventory-raid .field-loot { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; padding: 8px; background-color: #171c1e; }
.inventory-raid .field-carried { flex-grow: 1.25; margin-right: 10px; border-left-width: 1px; border-left-color: #414b4e; }
.inventory-raid .field-loot { background-color: #1c2223; }
.inventory-raid .field-pane-title { font-size: 15px; -unity-font-style: bold; color: #eeeee6; margin-bottom: 6px; flex-shrink: 0; }
.inventory-raid .field-pane-note, .inventory-raid .inventory-caption { display: none; }
.inventory-raid .inventory-weight { font-size: 12px; color: #b3bcb9; margin: 0; flex-shrink: 0; }
.inventory-raid .inventory-character-stage { flex-grow: 1; min-height: 240px; position: relative; }
.inventory-raid .inventory-slot-layer, .inventory-raid .field-operator-portrait { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inventory-raid .field-operator-portrait { background-image: url("FieldOperatorPortrait.png"); -unity-background-scale-mode: scale-to-fit; }
.inventory-raid.inventory-live-operator .field-operator-portrait { display: none; }
.inventory-raid .field-operator-live { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inventory-view.inventory-raid .inventory-slot { position: absolute; min-height: 0; margin: 0; padding: 6px; border-width: 1px; border-color: #66706a; background-color: rgba(15,23,22,0.84); }
.inventory-view.inventory-raid .inventory-slot-label { font-size: 12px; top: 5px; color: #b3bcb9; }
.inventory-view.inventory-raid .inventory-slot-item { font-size: 12px; bottom: 4px; color: #eeeee6; }
.inventory-raid .inventory-slot-art { top: 22px; bottom: 22px; }
.inventory-view.inventory-raid .inventory-equipped { border-left-width: 1px; border-color: #687775; }
.inventory-raid .inventory-containers, .inventory-raid .inventory-loot-pane { flex-grow: 1; min-height: 0; width: auto; margin: 0; padding: 0; border-width: 0; background-color: transparent; display: flex; }
.inventory-raid .inventory-container { flex-grow: 0; flex-shrink: 0; padding: 0; margin-bottom: 8px; border-width: 0; }
.inventory-raid .inventory-section-title { font-size: 13px; -unity-font-style: bold; letter-spacing: 0; border-left-width: 0; padding-left: 0; margin-bottom: 3px; }
.inventory-raid .inventory-region-title { display: none; }
.inventory-raid .inventory-regions, .inventory-raid .inventory-region { flex-grow: 0; flex-shrink: 0; }
.inventory-raid .inventory-region { margin-right: 4px; margin-bottom: 0; }
.inventory-raid .field-container-body { flex-direction: row; align-items: flex-start; }
.inventory-raid .field-container-body > .inventory-regions { flex-grow: 0; flex-shrink: 0; }
.inventory-raid .inventory-regions { flex-wrap: nowrap; }
.inventory-view.inventory-raid .inventory-grid { background-color: #101718; }
.inventory-view.inventory-raid .inventory-item { background-color: #222b2b; border-color: #52605c; }
.inventory-view.inventory-raid .inventory-item:hover, .inventory-view.inventory-raid .inventory-slot:hover, .inventory-raid .inventory-empty-container:hover { background-color: #303b38; border-color: #c8cfaa; }
.inventory-view.inventory-raid .inventory-item:focus, .inventory-view.inventory-raid .inventory-selected, .inventory-raid .inventory-empty-container:focus { background-color: #354139; border-width: 2px; border-color: #c8cfaa; }
.inventory-view.inventory-raid .inventory-item-label { font-size: 12px; background-color: rgba(16,20,22,0.88); color: #eeeee6; }
.inventory-view.inventory-raid .inventory-item-quantity { color: #eeeee6; background-color: #101416; font-size: 13px; }
.inventory-view.inventory-raid .inventory-empty-container { width: 112px; height: 112px; min-height: 112px; flex-shrink: 0; padding: 4px; margin: 0 8px 0 0; background-color: #121819; border-width: 1px; border-color: #58625e; border-radius: 0; color: #b3bcb9; font-size: 12px; -unity-text-align: middle-center; }
.inventory-raid .field-container-art { flex-grow: 1; width: 100%; min-height: 0; }
.inventory-raid .field-empty { padding: 12px; min-height: 70px; justify-content: center; }
.inventory-raid .field-empty-title { font-size: 14px; color: #b3bcb9; white-space: normal; }
.inventory-raid .field-empty-copy { display: none; }
.inventory-raid .field-corpse-equipment { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.inventory-view.inventory-raid .field-corpse-slot { position: relative; width: 48%; height: 74px; margin: 0 2% 4px 0; border-width: 1px; border-color: #52605c; background-color: #222b2b; }
.inventory-raid .field-corpse-slot .inventory-slot-art { top: 22px; bottom: 22px; }
.inventory-raid .field-corpse-slot .inventory-slot-label, .inventory-raid .field-corpse-slot .inventory-slot-item { font-size: 12px; }
.inventory-view.inventory-raid .field-corpse-empty { background-color: #151b1c; border-color: #384244; }
.inventory-raid .inventory-hint { position: absolute; left: 4px; right: 4px; bottom: 62px; height: 20px; min-height: 0; margin: 0; padding: 0; font-size: 12px; color: #e49e92; border-width: 0; background-color: transparent; }
.inventory-warehouse .inventory-hint { bottom: 0; }
.inventory-view.inventory-raid .inventory-drop-valid { background-color: rgba(124,170,131,0.25); border-color: #9dcc9e; }
.inventory-view.inventory-raid .inventory-drop-invalid { background-color: rgba(206,129,119,0.20); border-color: #e49e92; }
.inventory-raid .field-quickbar-dock { min-height: 62px; flex-shrink: 0; padding-top: 4px; }
.raid-ui .raid-inventory-window { width: 98%; max-width: 1800px; height: 97%; padding: 8px; background-color: #101416; border-color: #414b4e; border-top-width: 1px; }
.raid-ui .raid-inventory-window > .raid-inventory-header { height: 28px; margin-bottom: 6px; padding: 0; background-image: none; border-bottom-width: 0; }
.raid-ui .raid-inventory-window .raid-inventory-title { display: none; }
.raid-ui .raid-inventory-tabs { margin-bottom: 6px; }
.raid-ui .raid-inventory-tabs .raid-tab { height: 26px; min-width: 80px; font-size: 13px; letter-spacing: 0; background-color: #191f21; color: #b3bcb9; }
.raid-ui .raid-inventory-tabs .raid-tab-active { background-color: #374236; color: #eeeee6; border-bottom-color: #c8cfaa; }
.raid-ui .raid-inventory-header Button { height: 26px; min-width: 80px; margin: 0 4px 0 0; letter-spacing: 0; font-size: 13px; color: #eeeee6; background-color: #28312e; }
.inventory-view.inventory-warehouse .inventory-character { width: 26%; max-width: 360px; }
.inventory-warehouse .field-loot { flex-grow: 1.2; }
.inventory-warehouse .inventory-slot-item { white-space: normal; }
.inventory-warehouse .inventory-item-label { font-size: 12px; }
.inventory-warehouse .inventory-item-art { left: 8%; right: 8%; top: 23%; bottom: 20%; }
.inventory-raid .field-special-row { flex-direction: row; }
.inventory-view.inventory-raid .field-special-slot { position: relative; width: 52px; height: 52px; flex-shrink: 0; margin: 0 4px 0 0; border-width: 1px; border-color: #58625e; background-color: #121819; }
.inventory-raid .field-special-slot .inventory-slot-label, .inventory-raid .field-special-slot .inventory-slot-item { display: none; }
.inventory-raid .field-special-slot .inventory-slot-art { top: 4px; bottom: 4px; left: 4px; right: 4px; }
.raid-survey-readout { position: absolute; top: 18px; left: 50%; margin-left: -160px; width: 320px; padding: 6px 10px; font-size: 14px; color: #eeeee6; background-color: rgba(16,20,22,0.85); -unity-text-align: middle-center; -unity-font-definition: url("/Assets/Localization/Fonts/NotoSansCJKsc-Regular.otf"); display: none; white-space: normal; }
.inventory-raid .field-corpse-portrait { position: relative; height: 420px; min-height: 420px; flex-shrink: 0; margin-bottom: 8px; }
.inventory-raid .field-corpse-model, .inventory-raid .field-corpse-slot-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inventory-raid .field-corpse-model { background-image: url("FieldOperatorPortrait.png"); -unity-background-scale-mode: scale-to-fit; }
.inventory-view.inventory-raid .field-corpse-body-slot { position: absolute; margin: 0; padding: 4px; background-color: rgba(15,23,22,0.84); }
.inventory-raid .field-corpse-body-slot .inventory-slot-label, .inventory-raid .field-corpse-body-slot .inventory-slot-item { font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
