<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="AccountPanel" class="archive-account-form">
        <ui:VisualElement class="halos-account-brand" picking-mode="Ignore">
            <ui:VisualElement class="halos-emblem" picking-mode="Ignore" />
            <ui:VisualElement class="halos-wordmark" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:TextField name="accountUsername" label="Username" max-length="32" />
        <ui:TextField name="accountPassword" label="Password" max-length="128" password="true" />
        <ui:Label name="accountMessage" class="archive-form-status" />
        <ui:VisualElement class="archive-form-actions">
            <ui:Button name="accountLogin" text="LOG IN" class="archive-button archive-primary" />
            <ui:Button name="accountRegister" text="REGISTER" class="archive-button" />
        </ui:VisualElement>
        <ui:VisualElement name="accountSecondaryActions" class="archive-account-secondary">
            <ui:Button name="accountQuit" text="QUIT" class="archive-button" />
        </ui:VisualElement>
        <ui:Toggle name="accessReduceMotion" text="Reduce motion" class="halos-motion" />
    </ui:VisualElement>
</ui:UXML>
