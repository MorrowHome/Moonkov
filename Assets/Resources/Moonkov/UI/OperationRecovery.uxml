<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../../UI Toolkit/GameUI/StashScreen.uss" />
    <ui:Style src="../../../UI Toolkit/GameUI/MoonkovTerminal.uss" />
    <ui:Style src="ArchiveTheme.uss" />
    <ui:Style src="OperationProposal.uss" />
    <ui:VisualElement name="layoutPreview" class="stash-root moonkov-terminal archive-ui archive-pages archive-page-4 operation-step-3" style="width: 1600px; height: 900px;">
        <ui:VisualElement name="terminalPage" style="flex-grow: 1;">
            <ui:VisualElement class="op-page op-recovery">
                <ui:VisualElement class="op-recovery-heading">
                    <ui:Label text="RECOVERY CONTRACT" class="op-large-title" />
                    <ui:Label text="Drone insurance is not currently offered. You are deploying without a recovery contract. Lost cargo cannot be claimed after death." class="op-copy" />
                </ui:VisualElement>
                <ui:VisualElement class="op-recovery-warning">
                    <ui:VisualElement class="op-photo op-warning-photo" />
                    <ui:VisualElement class="op-warning-copy">
                        <ui:Label text="NO CONTRACT" class="op-danger-title" />
                        <ui:Label text="NO RECOVERY COVERAGE" class="op-title" />
                        <ui:Label text="Recovery insurance is unavailable." class="op-kicker" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="op-recovery-info">
                    <ui:Label text="!" class="op-info-icon" />
                    <ui:Label text="Carried supplies are lost on death or timeout. Storage is credited after a successful server settlement. The session controls the extraction countdown." class="op-copy" />
                </ui:VisualElement>
                <ui:Button name="purchaseContract" class="op-contract" enabled="false">
                    <ui:Label text="PURCHASE CONTRACT" class="op-title" />
                    <ui:Label text="Recovery insurance is unavailable." class="op-copy" />
                    <ui:Label text="⊘" class="op-contract-status" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
