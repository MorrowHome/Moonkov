.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-deploy .terminal-home-action-arrow { color: #f1f2ed; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship #homeAction2 .terminal-home-action-name,
.moon-approved-home.moon-proposal-plates.terminal-is-ship #homeAction2 .terminal-home-action-caption,
