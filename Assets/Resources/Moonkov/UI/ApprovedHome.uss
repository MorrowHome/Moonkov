/* Main menu: printed command cards, with functional type kept separate from imagery. */
.moon-approved-home.terminal-is-ship {
    --home-paper: #f1f2ee;
    --home-ink: #14161c;
    --home-muted: #525967;
    --home-edge: #30353e;
    --home-emphasis: #164BFF;
    background-color: #f1f2ee;
    background-image: url("ApprovedHome/HomeLightBackdrop.png");
    background-size: cover; background-position: center;
}
.moon-home-dark.terminal-is-ship {
    --home-paper: #101724; --home-ink: #f0f1eb; --home-muted: #b9bdc7; --home-edge: #a5aab3;
    background-color: #08090c; background-image: url("ApprovedHome/HomeDarkBackdrop.png");
}
.moon-approved-home.terminal-is-ship .terminal-scene-shade,
.moon-approved-home.terminal-is-ship > .terminal-chrome { display: none; }
.moon-approved-home.terminal-is-ship .terminal-content { overflow: visible; }
.moon-approved-home.terminal-is-ship .terminal-home-hero { left: 0; top: 0; background-color: var(--home-paper); padding: 12px 20px 16px 0; }
.moon-approved-home.terminal-is-ship .terminal-home-title { font-size: 104px; letter-spacing: -3px; color: var(--home-ink); -unity-font-definition: url("../../../UI Toolkit/Fonts/Roboto-Black.ttf"); }
.moon-approved-home.terminal-is-ship .terminal-home-title-ghost { display: none; }
.moon-approved-home.terminal-is-ship .terminal-home-kicker { color: var(--home-ink); font-size: 12px; letter-spacing: 6px; margin-bottom: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-caption { color: var(--home-ink); background-color: transparent; padding: 0; font-size: 11px; letter-spacing: 3px; }
.moon-approved-home.terminal-is-ship .terminal-home-version { display: none; }
.moon-approved-home.terminal-is-ship .terminal-home-description { border-left-color: var(--home-emphasis); color: var(--home-muted); font-size: 11px; margin-top: 8px; }
.moon-approved-home.terminal-is-ship .terminal-character-art { left: 10%; right: 43%; top: 5%; bottom: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-menu { width: 43%; min-width: 430px; max-width: 800px; top: 9%; bottom: 10%; right: 0; }
.moon-approved-home.terminal-is-ship .home-menu-surface { position: absolute; left: -18px; right: -18px; top: -16px; bottom: -14px; background-color: var(--home-paper); }
.moon-approved-home.terminal-is-ship .terminal-home-menu-head { flex-shrink: 0; height: 22px; margin-bottom: 12px; padding-bottom: 5px; border-bottom-width: 1px; border-bottom-color: var(--home-edge); }
.moon-approved-home.terminal-is-ship .terminal-home-menu-head .terminal-eyebrow,
.moon-approved-home.terminal-is-ship .terminal-home-menu-count { color: var(--home-muted); font-size: 11px; letter-spacing: 2px; }
.moon-approved-home.terminal-is-ship .terminal-home-action {
    background-color: var(--home-paper); border-width: 2px; border-color: var(--home-edge);
    padding: 0; margin: 0; border-radius: 0; overflow: hidden;
}
.moon-approved-home.terminal-is-ship .home-command-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.moon-approved-home.terminal-is-ship .home-card-contents { flex-grow: 1; }
.moon-approved-home.terminal-is-ship .home-card-image { position: absolute; left: 0; right: 0; top: 0; bottom: 72px; background-size: cover; background-position: center; }
.moon-approved-home.terminal-is-ship #homeAction0 .home-card-image { background-image: url("ApprovedHome/CardMoon.png"); bottom: 0; }
.moon-approved-home.terminal-is-ship #homeAction1 .home-card-image { background-image: url("ApprovedHome/CardIndustrial.png"); }
.moon-approved-home.terminal-is-ship #homeAction2 .home-card-image { background-image: url("ApprovedHome/CardHalo.png"); }
.moon-approved-home.terminal-is-ship .home-card-copy { position: absolute; left: 0; right: 0; bottom: 0; height: 72px; padding: 10px 70px 10px 20px; background-color: var(--home-paper); border-top-width: 1px; border-top-color: var(--home-edge); justify-content: center; }
.moon-approved-home.terminal-is-ship .terminal-home-action-name { color: var(--home-ink); font-size: 28px; letter-spacing: 0; margin: 0 0 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-font-style: bold; }
.moon-approved-home.terminal-is-ship .terminal-home-action-caption { color: var(--home-muted); font-size: 11px; letter-spacing: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.moon-approved-home.terminal-is-ship .terminal-home-action-index { position: absolute; left: 12px; right: auto; top: 12px; padding: 3px 6px; background-color: #101216; color: #f0f1eb; font-size: 11px; letter-spacing: 2px; -unity-text-outline-width: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-action-arrow { position: absolute; right: 16px; bottom: 16px; width: 42px; height: 38px; rotate: 0deg; translate: 0 0; border-width: 0; background-color: var(--home-ink); color: var(--home-paper); font-size: 28px; -unity-text-align: middle-center; }
.moon-approved-home.terminal-is-ship .home-card-focus-mark { position: absolute; top: 0; right: 0; width: 32px; height: 5px; background-color: var(--home-ink); opacity: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy { height: auto; min-height: 140px; flex-grow: 2; flex-basis: 0; flex-shrink: 1; border-left-width: 7px; border-left-color: var(--home-emphasis); margin-bottom: 12px; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy .home-card-copy { height: 108px; padding: 12px 94px 14px 24px; background-color: #101216; border-top-color: #50555f; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy .terminal-home-action-name { color: #f0f1eb; font-size: 50px; letter-spacing: 0; margin-bottom: 4px; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy .terminal-home-action-caption { color: #c7cbd3; font-size: 12px; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy .terminal-home-action-arrow { width: 56px; height: 50px; right: 20px; bottom: 26px; background-color: #f0f1eb; color: #101216; font-size: 34px; }
.moon-approved-home.terminal-is-ship .terminal-home-grid { flex-grow: 1.45; flex-basis: 0; min-height: 126px; margin: 0 0 12px; }
.moon-approved-home.terminal-is-ship .terminal-home-grid .terminal-home-action { height: auto; margin: 0; padding: 0; }
.moon-approved-home.terminal-is-ship #homeAction1 { margin-right: 12px; }
.moon-approved-home.terminal-is-ship .terminal-home-services { flex-grow: 1; flex-basis: 0; min-height: 88px; margin: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-chip { height: auto; margin: 0 7px 0 0; padding: 0; justify-content: flex-end; border-width: 1px; border-color: var(--home-edge); background-color: var(--home-paper); overflow: hidden; }
.moon-approved-home.terminal-is-ship .home-settings-chip { margin-right: 0; }
.moon-approved-home.terminal-is-ship .home-service-image { position: absolute; left: 0; right: 0; top: 0; bottom: 42px; background-size: cover; background-position: center; opacity: 1; }
.moon-approved-home.terminal-is-ship .home-card-industrial { background-image: url("ApprovedHome/CardIndustrial.png"); }
.moon-approved-home.terminal-is-ship .home-card-moon { background-image: url("ApprovedHome/CardMoon.png"); }
.moon-approved-home.terminal-is-ship .home-card-halo { background-image: url("ApprovedHome/CardHalo.png"); }
.moon-approved-home.terminal-is-ship .home-chip-copy { height: 42px; justify-content: center; padding-left: 8px; padding-right: 31px; background-color: var(--home-paper); border-top-width: 1px; border-top-color: var(--home-edge); }
.moon-approved-home.terminal-is-ship .home-chip-name { color: var(--home-ink); font-size: 15px; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.moon-approved-home.terminal-is-ship .terminal-home-chip-index { color: #f0f1eb; background-color: #101216; font-size: 10px; left: 6px; top: 6px; padding: 2px 4px; }
.moon-approved-home.terminal-is-ship .home-chip-arrow { position: absolute; right: 6px; bottom: 9px; width: 24px; height: 24px; background-color: var(--home-ink); color: var(--home-paper); font-size: 19px; -unity-text-align: middle-center; }
.moon-approved-home.terminal-is-ship .terminal-home-action:hover,
.moon-approved-home.terminal-is-ship .terminal-home-action:focus,
.moon-approved-home.terminal-is-ship .terminal-home-chip:hover,
.moon-approved-home.terminal-is-ship .terminal-home-chip:focus { border-color: var(--home-ink); }
.moon-approved-home.terminal-is-ship .terminal-home-action:hover .home-card-copy,
.moon-approved-home.terminal-is-ship .terminal-home-action:focus .home-card-copy,
.moon-approved-home.terminal-is-ship .terminal-home-chip:hover .home-chip-copy,
.moon-approved-home.terminal-is-ship .terminal-home-chip:focus .home-chip-copy { background-color: var(--home-ink); }
.moon-approved-home.terminal-is-ship .terminal-home-action:hover .terminal-home-action-name,
.moon-approved-home.terminal-is-ship .terminal-home-action:focus .terminal-home-action-name,
.moon-approved-home.terminal-is-ship .terminal-home-action:hover .terminal-home-action-caption,
.moon-approved-home.terminal-is-ship .terminal-home-action:focus .terminal-home-action-caption,
.moon-approved-home.terminal-is-ship .terminal-home-chip:hover .home-chip-name,
.moon-approved-home.terminal-is-ship .terminal-home-chip:focus .home-chip-name { color: var(--home-paper); }
.moon-approved-home.terminal-is-ship .terminal-home-action:hover .terminal-home-action-arrow,
.moon-approved-home.terminal-is-ship .terminal-home-action:focus .terminal-home-action-arrow,
.moon-approved-home.terminal-is-ship .terminal-home-chip:hover .home-chip-arrow,
.moon-approved-home.terminal-is-ship .terminal-home-chip:focus .home-chip-arrow { background-color: var(--home-paper); color: var(--home-ink); translate: 0 0; }
.moon-approved-home.terminal-is-ship .terminal-home-action:focus .home-card-focus-mark { opacity: 1; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy:hover .home-card-copy,
.moon-approved-home.terminal-is-ship .terminal-home-deploy:focus .home-card-copy { background-color: #24272f; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy:hover .terminal-home-action-name,
.moon-approved-home.terminal-is-ship .terminal-home-deploy:focus .terminal-home-action-name { color: #f0f1eb; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy:hover .terminal-home-action-caption,
.moon-approved-home.terminal-is-ship .terminal-home-deploy:focus .terminal-home-action-caption { color: #f0f1eb; }
.moon-approved-home.terminal-is-ship .terminal-home-deploy:hover .terminal-home-action-arrow,
.moon-approved-home.terminal-is-ship .terminal-home-deploy:focus .terminal-home-action-arrow { background-color: #f0f1eb; color: #101216; }
.moon-approved-home.terminal-is-ship .terminal-home-action:active .home-card-copy,
.moon-approved-home.terminal-is-ship .terminal-home-chip:active .home-chip-copy { background-color: #3a3e48; }
.moon-approved-home.terminal-is-ship .terminal-home-action:active .terminal-home-action-name,
.moon-approved-home.terminal-is-ship .terminal-home-action:active .terminal-home-action-caption,
.moon-approved-home.terminal-is-ship .terminal-home-chip:active .home-chip-name { color: #f0f1eb; }
.moon-approved-home.terminal-is-ship .terminal-home-action:disabled,
.moon-approved-home.terminal-is-ship .terminal-home-chip:disabled { opacity: 0.42; }
.moon-approved-home.terminal-is-ship .terminal-home-resources { height: 42px; flex-shrink: 0; margin-top: 14px; padding-top: 6px; border-top-color: var(--home-edge); }
.moon-approved-home.terminal-is-ship .terminal-home-resource { border-left-color: var(--home-edge); }
.moon-approved-home.terminal-is-ship .terminal-home-resource-name { color: var(--home-muted); font-size: 10px; letter-spacing: 1px; }
.moon-approved-home.terminal-is-ship .terminal-home-resource-value { color: var(--home-ink); font-size: 18px; margin-top: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-operator-card { left: 0; bottom: 5%; width: 230px; padding: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-operator-card .terminal-eyebrow { color: var(--home-muted); font-size: 10px; }
.moon-approved-home.terminal-is-ship .terminal-home-operator { color: var(--home-ink); font-size: 27px; letter-spacing: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-player { color: var(--home-muted); font-size: 11px; letter-spacing: 1px; }
.moon-approved-home.terminal-is-ship .terminal-home-operator-card .terminal-positive,
.moon-approved-home.terminal-is-ship .terminal-home-operator-card .terminal-warning { color: var(--home-ink); font-size: 11px; margin-top: 8px; padding-top: 8px; border-top-color: var(--home-edge); }
.moon-approved-home.terminal-is-ship .terminal-home-ticker { display: none; }
.moon-approved-home.terminal-is-ship .home-theme-switch,
.moon-approved-home.terminal-is-ship .home-observe { position: absolute; top: 0; right: 0; height: 30px; padding: 0 12px; border-radius: 0; border-width: 1px; border-color: var(--home-edge); background-color: var(--home-paper); color: var(--home-ink); font-size: 11px; }
.moon-approved-home.terminal-is-ship .home-observe { right: 145px; }
.moon-approved-home.terminal-is-ship .home-theme-switch:focus,
.moon-approved-home.terminal-is-ship .home-observe:focus { border-width: 2px; }
.moon-approved-home.terminal-is-ship .stash-account-name { color: var(--home-ink); }
.moon-approved-home.terminal-is-ship .stash-small-button { color: var(--home-ink); border-color: var(--home-edge); background-color: var(--home-paper); }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact { min-width: 380px; top: 8%; bottom: 8%; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-deploy { min-height: 126px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-deploy .home-card-copy { height: 88px; padding-left: 18px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-deploy .terminal-home-action-name { font-size: 36px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-grid { min-height: 112px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-action-name { font-size: 22px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .home-card-copy { height: 68px; padding-left: 12px; padding-right: 56px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .home-card-image { bottom: 68px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-action-arrow { right: 10px; width: 34px; height: 32px; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .terminal-home-deploy .home-card-image { bottom: 0; }
.moon-approved-home.terminal-is-ship .terminal-home-menu-compact .home-chip-name { font-size: 13px; }
.moon-approved-home.terminal-is-ship .terminal-home-hero { width: 480px; padding: 8px 12px 12px 0; }
.moon-approved-home.terminal-is-ship .terminal-home-title { font-size: 96px; height: 112px; -unity-text-align: middle-left; }
.moon-approved-home.terminal-is-ship .terminal-home-kicker { height: 18px; margin: 0 0 0 6px; }
.moon-approved-home.terminal-is-ship .terminal-home-description { display: none; }
.moon-approved-home.terminal-is-ship .home-chip-name { -unity-font-style: bold; }
/* Clean continuous canvases. Every functional caption below is a real Label. */
.home-card-plate, .home-service-plate, .home-brand-plate { display: none; }
.moon-approved-home.terminal-is-ship { background-image: url("ApprovedHome/HomeCleanC.png"); background-size: 100% 100%; }
.moon-approved-home.moon-home-dark.terminal-is-ship { background-image: url("ApprovedHome/HomeCleanD.png"); }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-content { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 0; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-hero,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .home-menu-surface,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-menu-head,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .home-card-image,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .home-service-image { display: none; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .home-card-plate,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .home-service-plate { display: flex; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-size: 100% 100%; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-menu { top: 18.8%; bottom: auto; right: 2.2%; width: 39.2%; height: 65.8%; min-width: 0; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-chip { background-color: transparent; border-width: 0; margin: 0; padding: 0; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-deploy { min-height: 0; flex-grow: 1.245; flex-basis: 0; margin-bottom: 12px; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-grid { min-height: 0; flex-grow: 1; flex-basis: 0; margin-bottom: 12px; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship #homeAction1 { margin-right: 12px; flex-grow: 0.94; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship #homeAction2 { flex-grow: 1.06; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-services { position: relative; min-height: 0; flex-grow: 0.973; flex-basis: 0; }
