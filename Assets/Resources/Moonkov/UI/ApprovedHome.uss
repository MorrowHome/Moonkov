.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action-caption { font-size: 11px; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-deploy .home-card-copy { height: 55%; padding: 10px 80px 14px 40px; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-deploy .terminal-home-action-name { font-size: 48px; color: #f1f2ed; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-deploy .terminal-home-action-caption { color: #c0c9ec; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action-index { background-color: transparent; color: #aab1bf; }
