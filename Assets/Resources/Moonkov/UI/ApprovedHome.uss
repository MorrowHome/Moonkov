.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship .terminal-home-services { flex-grow: 1.14; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeAction0 .home-card-plate { background-image: url("TextlessControls/HomeD_Deploy.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeAction1 .home-card-plate { background-image: url("TextlessControls/HomeD_Storage.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeAction2 .home-card-plate { background-image: url("TextlessControls/HomeD_Halo.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip1 .home-service-plate { background-image: url("TextlessControls/HomeD_Tasks.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip2 .home-service-plate { background-image: url("TextlessControls/HomeD_Base.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip3 .home-service-plate { background-image: url("TextlessControls/HomeD_Comms.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip0 .home-service-plate { background-image: url("TextlessControls/HomeD_Suppliers.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeAction3 .home-service-plate { background-image: url("TextlessControls/HomeD_Settings.png"); }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship .terminal-home-chip { position: absolute; top: 0; width: 23.5%; height: 54%; margin: 0; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip1 { left: 0; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip2 { left: 25.5%; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip0 { left: 51%; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeChip3 { left: 76.5%; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship #homeAction3 { left: 0; top: 60%; width: 52%; height: 40%; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship .home-chip-copy { height: 50%; padding-left: 16px; }
.moon-approved-home.moon-proposal-plates.moon-home-dark.terminal-is-ship .terminal-home-chip-index { display: none; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action:hover .home-card-copy,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action:focus .home-card-copy,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-chip:hover .home-chip-copy,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-chip:focus .home-chip-copy { background-color: transparent; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action:hover .home-card-plate,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-chip:hover .home-service-plate { -unity-background-image-tint-color: #cad9ff; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action:focus,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-chip:focus { border-width: 2px; border-color: #164bff; }
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-action:active .home-card-plate,
.moon-approved-home.moon-proposal-plates.terminal-is-ship .terminal-home-chip:active .home-service-plate { -unity-background-image-tint-color: #849fe8; }
