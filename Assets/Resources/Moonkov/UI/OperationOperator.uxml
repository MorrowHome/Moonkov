<ui:UXML xmlns:moon="Unity.MP_FPS.Client" xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI Toolkit/GameUI/StashScreen.uss" />
    <ui:Style src="project://database/Assets/UI Toolkit/GameUI/MoonkovTerminal.uss" />
    <ui:Style src="project://database/Assets/Resources/Moonkov/UI/TerminalLayout.uss" />
    <ui:VisualElement name="layoutPreview" class="stash-root moonkov-terminal terminal-layout-preview">
        <ui:VisualElement name="terminalPage">
            <ui:VisualElement class="terminal-operator-showcase">
                <ui:VisualElement class="terminal-operator-portrait">
                    <ui:Image name="operatorPortrait" class="terminal-operator-character" picking-mode="Ignore" />
                    <ui:Label text="FIELD OPERATOR / 01" class="terminal-operator-portrait-caption" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="terminal-operator-profile">
                    <ui:Label text="LUNAR EXPEDITION" class="terminal-eyebrow" />
                    <ui:Label text="DOLLSINGER" class="terminal-title terminal-operator-name" />
                    <ui:Label text="HALO / FIELD LOADOUT" class="terminal-operator-designation" />
                    <ui:VisualElement class="terminal-operator-divider" />
                    <ui:Label text="Your equipment is taken from the character loadout. Check your halo weapons and carried supplies before deployment." class="terminal-copy" />
                    <ui:Label text="OPERATOR CONFIRMED" class="terminal-positive" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
