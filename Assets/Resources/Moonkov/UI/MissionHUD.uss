.mission-hud { position: absolute; top: 360px; right: 24px; width: 300px; padding: 14px; background-color: rgba(13, 17, 24, 0.94); border-left-width: 3px; border-left-color: #c8cfaa; display: none; }
.mission-eyebrow { color: rgb(164, 176, 194); font-size: 12px; margin-bottom: 7px; }
.mission-title { color: rgb(241, 242, 237); font-size: 20px; -unity-font-style: bold; margin-bottom: 9px; white-space: normal; }
.mission-step { color: rgb(241, 242, 237); font-size: 14px; white-space: normal; margin-bottom: 6px; }
.mission-location { color: rgb(182, 193, 209); font-size: 12px; white-space: normal; }
.mission-risk { color: rgb(182, 193, 209); font-size: 12px; white-space: normal; margin-top: 9px; }
.mission-hint { color: rgb(164, 176, 194); font-size: 12px; white-space: normal; margin-top: 11px; }
.mission-track { height: 3px; margin-top: 5px; margin-bottom: 8px; background-color: rgb(43, 52, 69); }
.mission-fill { height: 3px; background-color: #c8cfaa; width: 0; }
.mission-interaction { position: absolute; left: 34%; right: 34%; bottom: 190px; padding: 12px; background-color: rgba(16, 20, 22, 0.96); display: none; }
.mission-modal { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.72); align-items: center; justify-content: center; display: none; }
.mission-sheet { width: 76%; max-width: 840px; max-height: 84%; padding: 24px; background-color: #191f21; border-top-width: 3px; border-top-color: #c8cfaa; }
.mission-scroll { min-height: 120px; max-height: 310px; margin-top: 16px; margin-bottom: 14px; }
.mission-node { padding-top: 9px; padding-bottom: 9px; border-bottom-width: 1px; border-bottom-color: rgb(43, 52, 69); color: rgb(241, 242, 237); font-size: 14px; white-space: normal; }
.mission-node-complete { color: rgb(151, 201, 183); }
.mission-clue { color: rgb(188, 199, 215); font-size: 14px; white-space: normal; margin-top: 10px; }
.mission-actions { flex-direction: row; justify-content: flex-end; margin-top: 20px; }
.mission-actions > Button { min-width: 130px; min-height: 38px; margin-left: 12px; color: rgb(241, 242, 237); background-color: rgb(28, 39, 60); border-width: 1px; border-color: rgb(93, 113, 151); font-size: 14px; }
.mission-actions > Button:hover, .mission-actions > Button:focus { background-color: #c8cfaa; }
.mission-actions > Button:active { background-color: rgb(18, 35, 75); }
.mission-compact .mission-hud { width: 250px; top: 350px; right: 14px; padding: 11px; }
.mission-compact .mission-title { font-size: 20px; }
.mission-compact .mission-interaction { left: 26%; right: 26%; bottom: 145px; }
.mission-controls > Button { min-height: 34px; margin-bottom: 7px; padding-left: 12px; color: rgb(241, 242, 237); background-color: rgb(28, 39, 60); font-size: 14px; -unity-text-align: middle-left; }
.mission-controls > Button:hover, .mission-controls > Button:focus { background-color: #c8cfaa; }
.mission-world-marker { position: absolute; max-width: 185px; padding: 7px; color: rgb(224, 234, 249); background-color: rgba(13, 21, 36, 0.88); font-size: 12px; white-space: normal; border-bottom-width: 2px; border-bottom-color: #c8cfaa; }

.mission-risk-urgent { color: rgb(255, 154, 135); -unity-font-style: bold; }
.mission-ended { border-left-color: rgb(110, 122, 138); }

/* Adapted from IBM Carbon Structured List, Inline Notification and Line Tabs (Apache-2.0),
   and shadcn Kbd (MIT). Modified for UI Toolkit flex layout and Moonkov colours.
   Source paths, scope and license copies: Docs/ThirdParty/InteractionUI/README.md. */
.mission-command-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.mission-command-row > .mission-step { flex-shrink: 1; margin-bottom: 0; }
.mission-kbd { flex-shrink: 0; min-width: 26px; height: 26px; margin-right: 8px; padding-left: 4px; padding-right: 4px; align-items: center; justify-content: center; -unity-text-align: middle-center; border-radius: 3px; background-color: #303b38; color: #eeeee6; font-size: 14px; -unity-font-style: bold; }
.mission-inspection { display: none; }
.mission-inspecting .mission-inspection { display: flex; }
.mission-inspecting .mission-scroll, .mission-inspecting .mission-clue, .mission-inspecting #missionOutcome, .mission-inspecting #missionPin { display: none; }
.mission-line-tabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: #414b4e; margin-bottom: 16px; }
.mission-line-tab { flex-grow: 1; min-height: 40px; margin: 0; padding: 8px 16px; color: #b3bcb9; background-color: transparent; border-width: 0; border-bottom-width: 2px; border-bottom-color: transparent; border-radius: 0; font-size: 14px; }
.mission-line-tab.is-selected { color: #eeeee6; border-bottom-color: #c8cfaa; -unity-font-style: bold; }
.mission-line-tab:hover { background-color: #303b38; }
.mission-line-tab:focus { border-left-width: 1px; border-top-width: 1px; border-right-width: 1px; border-color: #c8cfaa; }
.mission-line-tab:disabled { opacity: 0.45; }
.mission-plate { font-size: 20px; color: #eeeee6; white-space: normal; padding: 16px; border-bottom-width: 1px; border-bottom-color: #414b4e; }
.mission-inline-notification { min-height: 48px; margin-top: 16px; padding: 8px 16px; border-left-width: 3px; border-left-color: #c8cfaa; color: #eeeee6; background-color: #222b2b; white-space: normal; font-size: 14px; }
.mission-controls > .mission-circuit-row { min-height: 48px; margin: 0; padding: 8px 16px; border-width: 0; border-bottom-width: 1px; border-bottom-color: #414b4e; border-radius: 0; background-color: transparent; color: #eeeee6; font-size: 14px; white-space: normal; -unity-text-align: middle-left; }
.mission-controls > .mission-circuit-row:first-child { border-top-width: 1px; border-top-color: #414b4e; }
.mission-controls > .mission-circuit-row:hover { background-color: #303b38; }
.mission-controls > .mission-circuit-row:focus { background-color: #354139; border-left-width: 2px; border-left-color: #c8cfaa; }
.mission-controls > .mission-circuit-row:active { background-color: #354139; }

.field-record { -unity-font-definition: url("../../../Localization/Fonts/NotoSansCJKsc-Regular.otf"); }
.field-record .mission-sheet { max-width: 680px; border-top-color: #5472e4; background-color: #111318; }
.field-record .mission-scroll { flex-shrink: 1; min-height: 48px; margin-top: 4px; }
.field-record-body { color: #c4c8cf; font-size: 17px; white-space: normal; margin: 0 6px 0 0; }
.field-record .mission-actions > Button { margin-left: 0; color: #d6e1ff; background-color: #1d2e62; border-color: #435db1; }
.field-record .mission-actions > Button:hover, .field-record .mission-actions > Button:focus { background-color: #253974; border-color: #5472e4; }
