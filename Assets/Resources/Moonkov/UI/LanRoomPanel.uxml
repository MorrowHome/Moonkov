<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="LanRoomPanel.uss" />
    <ui:Style src="SquadGlassStyles.uss" />
    <ui:Style src="LanSquadStyles.uss" />
    <ui:VisualElement class="lan-layer moonkov-style-font lan-squad-ui" picking-mode="Ignore">
        <ui:Button name="lanEntry" text="好友联机" class="lan-entry" />
        <ui:VisualElement name="lanModal" class="lan-screen lan-hidden">
            <ui:VisualElement name="lanStageHost" class="lan-stage-host" picking-mode="Ignore" />
            <ui:VisualElement class="lan-shell" picking-mode="Ignore">
                <ui:VisualElement class="lan-header squad-glass">
                    <ui:Button name="lanClose" text="返回" class="lan-back" />
                    <ui:Label text="好友联机" class="lan-title" />
                </ui:VisualElement>
                <ui:Foldout text="外观" class="lan-personal squad-glass" value="false">
                    <ui:DropdownField name="lanCharacter" label="角色" choices="DOLLSINGER,HATSUNE MIKU,SHIAN" index="0" />
                    <ui:DropdownField name="lanPose" label="姿势" choices="自动,戒备,侧身,低姿,待命" index="0" />
                    <ui:Toggle name="lanReduceMotion" label="减少动态效果" />
                </ui:Foldout>
                <ui:VisualElement name="lanBrowser" class="lan-browser squad-glass">
                    <ui:VisualElement class="lan-navigation">
                        <ui:Button name="lanBrowseTab" text="寻找房间" class="lan-tab lan-selected" />
                        <ui:Button name="lanCreateTab" text="创建房间" class="lan-tab" />
                        <ui:Button name="lanPeerTab" text="房间码" class="lan-tab" />
                        <ui:Button name="lanDirectTab" text="IP 直连" class="lan-tab" />
                    </ui:VisualElement>
                    <ui:TextField name="lanPlayerName" label="干员代号" value="Operator" max-length="20" class="lan-field lan-identity" />
                    <ui:VisualElement class="lan-workspace">
                        <ui:VisualElement class="lan-primary-area">
                            <ui:VisualElement name="lanBrowsePage" class="lan-page">
                                <ui:VisualElement class="lan-directory-scope">
                                    <ui:Button name="lanBrowsePublic" text="跨网" class="lan-tab lan-selected" />
                                    <ui:Button name="lanBrowseLocal" text="局域网" class="lan-tab" />
                                </ui:VisualElement>
                                <ui:VisualElement class="lan-list-heading">
                                    <ui:Label name="lanDirectoryTitle" text="跨网大厅" class="lan-section-title" />
                                    <ui:Label name="lanRoomCount" class="lan-count" />
                                    <ui:Button name="lanRefresh" text="刷新" class="lan-secondary" />
                                    <ui:Button name="lanCancelApplication" text="撤回申请" class="lan-secondary lan-hidden" />
                                </ui:VisualElement>
                                <ui:ScrollView name="lanRooms" class="lan-room-list lan-hidden" horizontal-scroller-visibility="Hidden" />
                                <ui:VisualElement name="lanEmptyState" class="lan-empty-state lan-hidden"><ui:Label name="lanEmptyTitle" class="lan-empty-title" /><ui:Label name="lanEmpty" text="确认房主已开房、双方处于同一网络。" class="lan-copy lan-hidden" /><ui:Button name="lanEmptyDirect" text="使用 IP 加入" class="lan-secondary lan-hidden" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="lanCreatePage" class="lan-page lan-hidden">
                                <ui:ScrollView class="lan-form-scroll" horizontal-scroller-visibility="Hidden">
                                    <ui:Label text="创建你的房间" class="lan-section-title" />
                                    <ui:TextField name="lanRoomName" label="房间名称" value="Moonkov 小队" max-length="20" class="lan-field" />
                                    <ui:DropdownField name="lanConnectionType" label="连接方式" choices="局域网,跨网" index="0" class="lan-field" />
                                    <ui:Label text="作战玩法" class="lan-field-label" />
                                    <ui:VisualElement class="lan-mode-choices">
                                        <ui:Button name="lanExpedition" class="lan-mode-choice lan-selected"><ui:Label text="远征" class="lan-mode-name" picking-mode="Ignore" /><ui:Label text="探索月面，搜寻物资并撤离" class="lan-mode-description" picking-mode="Ignore" /></ui:Button>
                                        <ui:Button name="lanClash" class="lan-mode-choice"><ui:Label text="极速赏金" class="lan-mode-name" picking-mode="Ignore" /><ui:Label text="组建小队，争夺同一份赏金" class="lan-mode-description" picking-mode="Ignore" /></ui:Button>
                                        <ui:Button name="lanArena" class="lan-mode-choice"><ui:Label text="竞技场" class="lan-mode-name" picking-mode="Ignore" /><ui:Label text="自由对战，免费选装" class="lan-mode-description" picking-mode="Ignore" /></ui:Button>
                                        <ui:Button name="lanClassic" class="lan-mode-choice"><ui:Label text="经典爆破" class="lan-mode-name" picking-mode="Ignore" /><ui:Label name="lanClassicHint" class="lan-mode-description" picking-mode="Ignore" /></ui:Button>
                                    </ui:VisualElement>
                                    <ui:IntegerField name="lanCapacity" label="人数上限" value="8" is-delayed="true" class="lan-field" />
                                    <ui:Label name="lanCapacityHint" text="远征最多 32 人，包含房主。" class="lan-muted" />
                                    <ui:Foldout name="lanCreatePorts" text="高级连接设置" class="lan-advanced" value="false"><ui:IntegerField name="lanControlPort" label="房间端口 / TCP" value="7978" is-delayed="true" class="lan-field" /><ui:IntegerField name="lanGamePort" label="游戏端口 / UDP" value="7979" is-delayed="true" class="lan-field" /></ui:Foldout>
                                </ui:ScrollView>
                                <ui:VisualElement class="lan-form-action"><ui:Label name="lanHostRequirement" text="开房需要包含服务器功能的游戏版本。" class="lan-muted" /><ui:Button name="lanCreate" text="创建房间" class="lan-primary" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="lanPeerPage" class="lan-page lan-hidden">
                                <ui:ScrollView class="lan-form-scroll" horizontal-scroller-visibility="Hidden">
                                    <ui:Label text="加入跨网房间" class="lan-section-title" />
                                    <ui:TextField name="lanPeerCode" label="房间码" max-length="16" class="lan-field" />
                                    <ui:Foldout text="手动邀请" class="lan-advanced" value="false">
                                        <ui:Button name="lanPeerJoin" text="粘贴邀请并复制回执" class="lan-secondary" />
                                    </ui:Foldout>
                                </ui:ScrollView>
                                <ui:VisualElement class="lan-form-action">
                                    <ui:Button name="lanPeerJoinCode" text="加入房间" class="lan-primary" />
                                    <ui:Button name="lanPeerCancelJoin" text="取消加入" class="lan-secondary lan-hidden" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="lanDirectPage" class="lan-page lan-hidden">
                                <ui:ScrollView class="lan-form-scroll" horizontal-scroller-visibility="Hidden"><ui:Label text="通过 IP 加入" class="lan-section-title" /><ui:Label text="向房主获取同一网络下的 IPv4 地址。" class="lan-copy" /><ui:TextField name="lanAddress" label="房主 IPv4" value="192.168.1.100" max-length="15" class="lan-field lan-ip-field" /><ui:Foldout text="更改房间端口" class="lan-advanced" value="false"><ui:IntegerField name="lanJoinPort" label="房间端口 / TCP" value="7978" is-delayed="true" class="lan-field" /></ui:Foldout></ui:ScrollView>
                                <ui:VisualElement class="lan-form-action"><ui:Label text="默认房间端口为 7978。" class="lan-muted" /><ui:Button name="lanJoin" text="加入房间" class="lan-primary" /></ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="lanLobby" class="lan-lobby lan-hidden" picking-mode="Ignore">
                    <ui:VisualElement class="lan-briefing squad-glass">
                        <ui:Label name="lanRoomHeading" class="lan-room-title" />
                        <ui:VisualElement class="lan-roster-heading">
                            <ui:Label name="lanRoomMeta" class="lan-copy" />
                            <ui:Label name="lanReadyCount" class="lan-count" />
                        </ui:VisualElement>
                        <ui:VisualElement name="lanStagePagerHost" />
                        <ui:Label name="lanTrackerTip" text="Equip a T-01 Squad tracker in a special slot to see teammates through walls." class="squad-equipment-tip" picking-mode="Ignore" />
                        <ui:ScrollView class="lan-room-details" horizontal-scroller-visibility="Hidden">
                            <ui:Foldout name="lanPeerApplications" text="加入申请" class="lan-advanced lan-hidden" value="true">
                                <ui:VisualElement name="lanPeerApplicationRows" />
                            </ui:Foldout>
                            <ui:Foldout name="lanRosterDetails" text="全部成员" class="lan-advanced lan-roster-details lan-hidden" value="false">
                                <ui:ScrollView name="lanMembers" class="lan-members" horizontal-scroller-visibility="Hidden" />
                            </ui:Foldout>
                            <ui:Foldout name="lanAddressInvite" text="邀请与连接" class="lan-advanced lan-connection" value="false">
                                <ui:Label name="lanHostAddress" class="lan-address" />
                                <ui:Button name="lanCopy" text="复制 IPv4 地址" class="lan-secondary" />
                            </ui:Foldout>
                            <ui:Foldout name="lanPeerInvite" text="跨网邀请" class="lan-advanced lan-peer-invite lan-hidden" value="true">
                                <ui:Button name="lanPeerPublish" text="公开到大厅" class="lan-secondary" />
                                <ui:Button name="lanPeerCopyCode" text="复制房间码" class="lan-secondary" />
                                <ui:Foldout text="手动邀请" class="lan-advanced" value="false">
                                    <ui:Button name="lanPeerCopy" text="复制邀请" class="lan-secondary" />
                                    <ui:Button name="lanPeerAccept" text="粘贴回执" class="lan-primary lan-hidden" />
                                    <ui:Button name="lanPeerCancelInvite" text="取消邀请" class="lan-quiet lan-hidden" />
                                    <ui:Label name="lanPeerInviteStatus" class="lan-copy lan-hidden" />
                                </ui:Foldout>
                            </ui:Foldout>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="lan-launch-bar squad-glass">
                        <ui:VisualElement class="lan-launch-summary">
                            <ui:Label name="lanLaunchTitle" class="lan-launch-title" />
                            <ui:Label name="lanLaunchHint" class="lan-muted" />
                            <ui:DropdownField name="lanCompanions" label="AI TEAMMATES" choices="0,1,2,3" index="0" class="lan-companions lan-hidden" />
                        </ui:VisualElement>
                        <ui:Button name="lanLeave" text="离开房间" class="lan-quiet" />
                        <ui:Button name="lanEquipment" text="整理装备" class="lan-secondary" />
                        <ui:Button name="lanReady" text="准备就绪" class="lan-primary" />
                        <ui:Button name="lanStart" text="开始远征" class="lan-primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="lanNotice" class="lan-footer squad-glass lan-hidden">
                    <ui:VisualElement name="lanStatusDot" class="lan-status-dot" />
                    <ui:Label name="lanStatus" class="lan-status" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
