.vitals-monitor { -unity-font-definition: url("../../../Localization/Fonts/NotoSansCJKsc-Regular.otf"); flex-grow: 1; min-width: 0; min-height: 0; }
.vitals-upper { flex-grow: 1; flex-direction: row; min-height: 90px; }
.vitals-body { width: 65%; flex-shrink: 0; min-width: 0; min-height: 0; }
.vitals-signals { flex-shrink: 0; min-width: 0; padding-top: 20px; }
.vitals-trace { flex-grow: 1; min-width: 0; margin-left: 8px; }
.vitals-waveform { flex-grow: 1; min-height: 0; }
.vitals-warning { position: absolute; left: 0; top: -3px; font-size: 12px; -unity-font-style: bold; display: none; }
.vitals-reserve { flex-direction: row; align-items: center; height: 24px; flex-shrink: 0; }
.vitals-reserve-label { width: 80px; color: #edeef0; font-size: 12px; margin: 0; margin-right: 8px; padding: 0; -unity-text-outline-width: 0; text-shadow: 0 1px 2px rgba(0,0,0,.9); }
.vitals-cells { flex-grow: 1; flex-direction: row; height: 20px; min-width: 0; }
.vitals-cell { flex-grow: 1; flex-basis: 0; margin-right: 3px; min-width: 0; height: 100%; }

.vitals-halo-art { width: 100%; height: 100%; }
.vitals-reserve-halo { height: 38px; }
.vitals-reserve-halo .vitals-cells { flex-grow: 0; width: 36px; height: 36px; }

.vitals-warning { text-shadow: 0 1px 2px rgba(0,0,0,.9); }
