.vitals-monitor { flex-grow: 1; min-width: 0; min-height: 0; }
.vitals-upper { flex-grow: 1; flex-direction: row; min-height: 90px; }
.vitals-body { width: 65%; flex-shrink: 0; min-width: 0; min-height: 0; }
.vitals-signals { flex-shrink: 0; min-width: 0; padding-top: 14px; }
.vitals-trace { flex-grow: 1; min-width: 0; margin-left: 8px; }
.vitals-waveform { flex-grow: 1; min-height: 0; }
.vitals-warning { position: absolute; left: 0; top: -3px; font-size: 12px; -unity-font-style: bold; display: none; }
.vitals-reserve { flex-direction: row; align-items: center; height: 18px; flex-shrink: 0; }
.vitals-reserve-label { width: 80px; color: #c4e1ff; font-size: 12px; margin: 0; margin-right: 8px; padding: 0; -unity-text-outline-width: 0.3px; -unity-text-outline-color: #152028; }
.vitals-cells { flex-grow: 1; flex-direction: row; height: 7px; min-width: 0; }
.vitals-cell { flex-grow: 1; flex-basis: 0; margin-right: 3px; border-width: 0.7px; border-radius: 1px; }
