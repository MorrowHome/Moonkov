@import url("ArchiveTheme.uss");
/* Navigation group geometry and SVG assets adapted from MapLibre GL JS, BSD-3-Clause.
   Upstream CSS and full license: ThirdPartyNotices/MapLibre. */
.raid-map-hint { position: absolute; left: 50%; top: 16px; margin-left: -48px; padding: 4px 10px; background-color: rgba(0,0,0,.55); color: white; font-size: 12px; }
.raid-map-overlay { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: #252725; }
.raid-map-window { flex-grow: 1; min-height: 0; -unity-font-definition: url("../../../Localization/Fonts/NotoSansCJKsc-Regular.otf"); }
.raid-map-canvas-host { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; }
.raid-map-canvas { position: absolute; left: 0; right: 0; top: 0; bottom: 0; overflow: hidden; }
.raid-map-window Label { color: #e8eaed; letter-spacing: 0; }
.map-place { position: absolute; left: 12px; top: 12px; flex-direction: row; align-items: center; width: 250px; padding: 10px 12px; background-color: #202124; border-radius: 4px; }
.map-place-copy { flex-grow: 1; }
.map-place-name { font-size: 15px; }
.raid-map-window .map-place-status { font-size: 11px; color: #bdc1c6; margin-top: 3px; white-space: normal; }
.map-text-button { height: 29px; min-width: 0; margin: 0; padding: 0 10px; border-width: 0; border-radius: 4px; background-color: #202124; color: #e8eaed; font-size: 12px; }
.map-text-button:hover, .map-control:hover { background-color: #303134; }
.map-text-button:active, .map-control:active { background-color: #3c4043; }
.map-text-button:focus, .map-control:focus { border-width: 1px; border-color: #8ab4f8; }
.map-text-button.is-active { color: #8ab4f8; background-color: #34445c; }
.map-text-button:disabled, .map-control:disabled { opacity: .25; }
.map-control-group { border-radius: 4px; background-color: #202124; overflow: hidden; }
.map-control { width: 29px; height: 29px; min-width: 0; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: #202124; color: #e8eaed; align-items: center; justify-content: center; }
.map-separated { border-top-width: 1px; border-top-color: #5f6368; }
.map-close { position: absolute; right: 12px; top: 12px; border-radius: 4px; font-size: 23px; }
.map-icon { width: 17px; height: 17px; -unity-background-scale-mode: scale-to-fit; }
.map-in-icon { width: 13px; height: 13px; background-image: url("MapControls/zoom-in.svg"); }
.map-out-icon { width: 13px; height: 13px; background-image: url("MapControls/zoom-out.svg"); }
.map-center-icon { width: 20px; height: 20px; background-image: url("MapControls/geolocate.svg"); }
.map-full-icon { width: 19px; height: 19px; background-image: url("MapControls/fullscreen.svg"); }
.map-navigation { position: absolute; right: 12px; bottom: 32px; }
.map-single-control { margin-bottom: 10px; }
.map-layers { position: absolute; left: 12px; bottom: 60px; }
.map-info { display: none; position: absolute; left: 12px; top: 84px; width: 250px; padding: 12px; background-color: #202124; border-radius: 4px; }
.raid-map-details-open .map-info { display: flex; }
.map-info-copy { font-size: 12px; white-space: normal; margin: 0 0 12px; }
.raid-map-window .map-info-exit { font-size: 14px; color: #81c995; white-space: normal; margin: 0 0 14px; }
.raid-map-window .map-info-caption { font-size: 11px; color: #bdc1c6; margin-bottom: 4px; }
.map-key { flex-direction: row; flex-wrap: wrap; margin-bottom: 12px; }
.map-key > Label { margin-right: 10px; font-size: 11px; }
.raid-map-window .map-key-medical { color: #81c995; }
.raid-map-window .map-key-industrial { color: #fdd663; }
.raid-map-window .map-key-equipment { color: #8ab4f8; }
.map-clear { align-self: flex-start; margin-left: -10px; }
.raid-map-window .map-zoom { display: none; }
.raid-map-window .raid-map-marker-label { position: absolute; color: white; font-size: 12px; padding: 1px 3px; white-space: normal; max-width: 210px; -unity-text-outline-width: 0; text-shadow: 0 1px 2px rgba(0,0,0,.9); }
.raid-map-window .raid-map-landmark { font-size: 14px; }
.raid-map-window .raid-map-scale { position: absolute; left: 12px; bottom: 6px; color: white; font-size: 11px; -unity-text-outline-width: 0; text-shadow: 0 1px 2px #222222; }
.raid-map-compact .map-info { top: 80px; }

.raid-map-details-open .map-layers { display: none; }
