@import url("ArchiveTheme.uss");
@import url("Components/MoonkovControls.uss");
.raid-map-hint { position: absolute; left: 50%; top: 16px; margin-left: -80px; width: 160px; padding: 5px 10px; color: var(--archive-ink); background-color: rgba(8,9,12,.86); font-size: 13px; -unity-text-align: middle-center; }
.raid-map-overlay { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(8,9,12,.90); }
.raid-map-window { width: 1100px; max-width: 94%; height: 92%; max-height: 92%; min-height: 0; }
.raid-map-window .bounty-archive-window { position: relative; width: 100%; height: 100%; min-height: 0; padding: 14px 16px; }
.raid-map-window .terminal-window-header { border-bottom-width: 1px; border-bottom-color: var(--archive-rule); padding-bottom: 8px; margin-bottom: 8px; flex-shrink: 0; }
.raid-map-title { font-size: 22px; color: var(--archive-ink); }
.raid-map-copy { font-size: 13px; color: var(--archive-muted); white-space: normal; margin: 3px 0; flex-shrink: 0; }
.raid-map-canvas-host { flex-grow: 1; min-height: 100px; border-width: 1px; border-color: var(--archive-rule); background-color: #080b10; margin: 8px 0; overflow: hidden; }
.raid-map-canvas { flex-grow: 1; min-height: 0; overflow: hidden; }
.raid-map-canvas:focus { border-width: 1px; border-color: var(--archive-accent); }
.raid-map-marker-label { position: absolute; font-size: 12px; color: var(--archive-ink); padding: 1px 3px; background-color: rgba(8,9,12,.82); }
.raid-map-controls { flex-direction: row; flex-wrap: wrap; align-items: center; flex-shrink: 0; }
.raid-map-controls > Button { min-height: 34px; min-width: 0; margin: 2px 6px 2px 0; padding: 6px 10px; font-size: 13px; }
.raid-map-controls > .raid-map-zoom-button { min-width: 34px; }
.raid-map-controls > Label { margin-right: 8px; }
.raid-map-controls > Button:hover, .raid-map-controls > Button:focus { border-color: var(--archive-accent); }
