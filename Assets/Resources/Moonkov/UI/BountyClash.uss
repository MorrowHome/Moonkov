@import url("ArchiveTheme.uss");
@import url("Components/MoonkovControls.uss");
.clash-root, .clash-battle { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.clash-hidden { display: none; }
.clash-root { color: var(--archive-ink); }
.clash-root .clash-copy { color: var(--archive-muted); font-size: 13px; white-space: normal; margin-bottom: 12px; }
.clash-heading { color: var(--archive-muted); font-size: 11px; margin-bottom: 6px; }
.raid-ui .clash-root .clash-header { left: 20px; right: auto; top: 16px; bottom: auto; width: 210px; padding: 10px 14px; }
.clash-header .clash-objective { font-size: 12px; white-space: normal; margin-top: 5px; }
.clash-header .raid-caption { font-size: 11px; white-space: normal; margin-bottom: 4px; }
.clash-header .raid-timer { font-size: 32px; margin: 0; }
.clash-progress { height: 6px; margin-top: 6px; }
.clash-progress .unity-progress-bar__title { display: none; }
.clash-progress .unity-progress-bar__progress { background-color: var(--archive-accent); }
.clash-team { position: absolute; left: 20px; bottom: 245px; width: 210px; border-left-width: 2px; border-left-color: var(--archive-accent); padding: 6px 10px; background-color: rgba(8,9,12,.72); }
.clash-team .clash-roster { margin: 0; }
.clash-member { color: var(--archive-ink); font-size: 12px; min-height: 22px; white-space: normal; }
.clash-sidebar { position: absolute; right: 20px; top: 16px; width: 170px; }
.clash-sidebar .clash-map { width: 170px; height: 170px; background-color: rgba(8,9,12,.70); border-width: 1px; border-color: var(--archive-rule); }
.clash-sidebar .clash-sense { padding: 6px 0; }
.clash-sidebar .clash-copy { margin: 0; font-size: 11px; }
.clash-sidebar .clash-exit { font-size: 11px; white-space: normal; border-top-width: 1px; border-top-color: var(--archive-rule); padding: 6px 0; background-color: rgba(8,9,12,.65); }
.clash-warning, .clash-action { position: absolute; left: 30%; right: 30%; bottom: 230px; padding: 8px 12px; color: var(--archive-ink); border-left-width: 3px; border-left-color: var(--archive-accent); background-color: rgba(8,9,12,.88); font-size: 13px; white-space: normal; -unity-text-align: middle-center; }
.clash-warning { bottom: 280px; border-left-color: var(--archive-alert); }
.clash-marker-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.clash-root .clash-friendly-marker { position: absolute; width: 150px; margin-left: -75px; color: #c5d8ff; font-size: 11px; -unity-text-align: middle-center; white-space: normal; }
.clash-root .clash-friendly-down { color: var(--archive-alert); }
.clash-sense-layer { display: none; }
.clash-lobby { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(8,9,12,.88); }
.clash-lobby-window { width: 680px; max-width: 94%; max-height: 90%; }
.clash-root .bounty-archive-window { position: relative; width: 100%; max-width: 100%; max-height: 100%; }
.clash-root .terminal-window-header { flex-direction: row; align-items: center; border-bottom-width: 1px; padding-bottom: 12px; }
.clash-lobby-title { font-size: 25px; color: var(--archive-ink); white-space: normal; }
.clash-lobby-body { min-height: 0; flex-shrink: 1; }
.clash-line { flex-direction: row; align-items: center; margin-bottom: 8px; }
.clash-line > Button { min-height: 34px; padding: 6px 10px; margin-right: 8px; }
.clash-line > TextField, .clash-line > DropdownField { flex-grow: 1; margin-right: 8px; }
.clash-roster { margin: 8px 0; }
.clash-error { color: var(--archive-alert); font-size: 12px; white-space: normal; min-height: 20px; }
.clash-finished { position: absolute; left: 50%; top: 22%; width: 520px; margin-left: -260px; }
.clash-finished Button { margin-top: 8px; }
.clash-menu-open .clash-battle, .clash-menu-open .clash-marker-layer { display: none; }
.clash-compact .clash-header { left: 12px; top: 12px; width: 190px; }
.clash-compact .clash-team { left: 12px; width: 190px; }
.clash-compact .clash-sidebar { right: 12px; top: 12px; width: 146px; }
.clash-compact .clash-sidebar .clash-map { width: 146px; height: 146px; }
.clash-compact .clash-finished { width: 480px; margin-left: -240px; top: 16%; }

.clash-lobby-actions { flex-shrink: 0; margin-top: 10px; margin-bottom: 0; }
