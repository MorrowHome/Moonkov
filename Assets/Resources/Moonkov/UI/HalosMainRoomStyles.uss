/* Source artwork owns the composition. No replacement room, cards or recolouring. */
#stashScreen.halos-original-home.terminal-is-ship {
    padding: 0;
    background-color: #000000;
    background-image: none;
}
#stashScreen.halos-original-home.terminal-is-ship > .terminal-scene-shade,
#stashScreen.halos-original-home.terminal-is-ship > .terminal-chrome,
#stashScreen.halos-original-home.terminal-is-ship > #terminalNav,
#stashScreen.halos-original-home.terminal-is-ship > #terminalContent,
#stashScreen.halos-original-home.terminal-is-ship > .stash-footer { display: none; }
#stashScreen.halos-original-home.terminal-is-ship > .stash-header {
    position: absolute; top: 16px; right: 18px; left: auto;
    height: auto; min-height: 0; padding: 0; margin: 0;
    background-color: transparent; border-width: 0;
}
#stashScreen.halos-original-home.terminal-is-ship .stash-brand,
#stashScreen.halos-original-home.terminal-is-ship .stash-page-heading,
#stashScreen.halos-original-home.terminal-is-ship .stash-account { display: none; }
#stashScreen.halos-original-home.terminal-is-ship .stash-menu-actions { margin: 0; }
#stashScreen.halos-original-home.terminal-is-ship .stash-menu-actions Button { font-size: 12px; }
.halos-original-room {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    overflow: hidden; background-color: #000000;
}
.halos-room-viewport {
    position: absolute; width: 1920px; height: 1080px;
    transform-origin: 0 0; overflow: hidden;
}
.halos-room-world { position: absolute; left: 0; top: 0; width: 5760px; height: 1080px; }
.halos-room-parallax { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 50% 50%; }
.halos-room-sprite { position: absolute; }
.halos-room-tablet {
    position: absolute; left: 0; top: 0; width: 1920px; height: 1080px;
    transform-origin: 50% 50%;
}
#halosOriginalHome .halos-room-hit {
    position: absolute; padding: 0; margin: 0; border-width: 0; border-radius: 0;
    background-color: transparent; background-image: none; opacity: 1;
}
#halosOriginalHome .halos-room-hit:hover,
#halosOriginalHome .halos-room-hit:active { background-color: transparent; }
#halosOriginalHome.halos-keyboard-focus .halos-room-hit:focus { border-width: 2px; border-color: #dce7f2; }
.halos-room-caption {
    position: absolute; height: 42px; translate: -50% 0;
    margin: 0; padding: 0 12px;
    background-color: rgba(17, 19, 24, 0.92); color: #f1f2ed;
    font-size: 32px; -unity-text-align: middle-center;
}
#halosOriginalHome .halos-room-hit:hover .halos-room-caption,
#halosOriginalHome .halos-room-hit:focus .halos-room-caption { background-color: #243754; }
.halos-room-edge { position: absolute; top: 0; bottom: 0; width: 200px; }
.halos-room-left { left: 0; }
.halos-room-right { right: 0; }
.halos-room-character { position: absolute; left: 2860px; top: 78px; width: 1040px; height: 1090px; }
#halosOriginalHome .halos-room-portrait { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#halosOriginalHome .halos-character-hit { left: 300px; top: 146px; width: 455px; height: 850px; }
#halosOriginalHome .halos-moon-hit { left: 2375px; top: 115px; width: 995px; height: 630px; }
.halos-subject-preview {
    display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: #111113;
}
#stashScreen.halos-subject-open > .stash-header { display: none; }
.halos-subject-stage { position: absolute; left: 8%; right: 8%; top: 10%; bottom: 10%; }
#halosOriginalHome .halos-subject-art { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: auto; height: auto; }
.halos-subject-header { position: absolute; left: 4%; right: 4%; top: 3%; flex-direction: row; align-items: center; justify-content: space-between; }
#halosOriginalHome .halos-subject-title { font-size: 20px; color: #eeeeef; letter-spacing: 1px; }
.halos-subject-controls { position: absolute; left: 4%; right: 4%; bottom: 3%; flex-direction: row; justify-content: center; align-items: center; }
#halosOriginalHome .halos-subject-controls Label { font-size: 12px; color: #b5b5c0; margin-right: 16px; }
#halosOriginalHome .halos-subject-button {
    height: 36px; padding: 0 16px; margin: 0; font-size: 12px;
    border-width: 1px; border-color: #464853; border-radius: 0; background-image: none;
    background-color: #232429; color: #eeeeef;
    transition-property: background-color, border-color; transition-duration: 150ms;
}
#halosOriginalHome .halos-subject-button:hover,
#halosOriginalHome .halos-subject-button:focus { background-color: #2b2d37; border-color: #889bc5; }
#halosOriginalHome .halos-subject-button:active { background-color: #343c52; }
