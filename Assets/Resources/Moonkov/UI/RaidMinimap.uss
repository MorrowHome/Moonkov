.raid-ui .raid-minimap { position: absolute; top: 24px; right: 28px; width: 244px; padding: 10px; display: none; background-color: rgba(8,9,12,0.94); border-width: 1px; border-color: #5c626d; border-top-width: 3px; border-top-color: #164bff; -unity-font-definition: url("/Assets/Localization/Fonts/NotoSansCJKsc-Regular.otf"); }
.raid-minimap-heading { flex-direction: row; justify-content: space-between; margin-bottom: 8px; }
.raid-ui .raid-minimap-heading Label { margin: 0; font-size: 12px; color: #d9dde3; white-space: nowrap; }
.raid-ui .raid-minimap-heading .raid-minimap-range { color: #929da9; }
.raid-minimap-viewport { height: 220px; width: 220px; flex-shrink: 0; overflow: hidden; background-color: #10151b; }
.raid-minimap-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.raid-ui .raid-minimap-north { position: absolute; top: 3px; left: 98px; width: 24px; margin: 0; color: #ffffff; background-color: rgba(8,9,12,0.82); font-size: 12px; -unity-text-align: middle-center; }
.raid-ui .raid-minimap-scale { position: absolute; bottom: 6px; left: 8px; width: 55px; padding-top: 2px; margin: 0; border-top-width: 2px; border-top-color: #c8cdd5; color: #e8eae6; font-size: 12px; background-color: rgba(8,9,12,0.65); }
.raid-minimap-legend { flex-direction: row; justify-content: space-between; margin-top: 7px; }
.raid-ui .raid-minimap-legend Label { font-size: 12px; margin: 0; white-space: nowrap; }
.raid-ui .raid-minimap-you { color: #f1f2ed; }
.raid-ui .raid-minimap-supply { color: #e9bb75; }
.raid-ui .raid-minimap-oxygen { color: #4ccce6; }
.raid-ui .raid-minimap-exit { color: #9fe0ba; }
.raid-ui .raid-minimap-distance { margin: 6px 0 0 0; font-size: 12px; color: #b6d3ba; white-space: nowrap; }
/* Keep survival warnings and extraction clear of the surface instrument. */
.raid-ui .raid-oxygen-panel { left: 28px; right: auto; top: 184px; }
.raid-ui .raid-oxygen-warning { left: 28px; right: auto; top: 310px; max-width: 280px; }
.raid-ui .raid-extraction-panel { top: 370px; max-width: 280px; }
/* One flow owns the right edge. Hidden or translated panels still reserve their
   own row, so extraction and mission text cannot paint over the surface map. */
.raid-ui .raid-right-rail { position: absolute; top: 24px; right: 24px; bottom: 140px; width: 280px; }
.raid-ui .raid-right-rail .raid-extraction-panel, .raid-ui .raid-right-rail .mission-hud, .raid-ui .raid-right-rail .raid-cargo-instrument { position: relative; top: auto; right: auto; left: auto; bottom: auto; width: 100%; min-width: 0; max-width: none; margin: 0 0 12px 0; flex-shrink: 0; }
.raid-ui .raid-right-rail .mission-title { font-size: 16px; padding-right: 40px; }
.raid-ui .raid-right-rail .mission-step { font-size: 13px; }
.raid-ui .raid-right-rail .mission-eyebrow, .raid-ui .raid-right-rail .mission-hint { display: none; }
.raid-ui .raid-right-rail .raid-copy { margin: 0; }
.raid-ui .raid-receipt { right: 324px; }

.raid-ui #raidTaskPanel { position: absolute; top: 24px; right: 24px; width: 280px; max-height: 70%; }
.raid-ui #raidTaskPanel.is-collapsed { width: 112px; }
.raid-ui #raidTaskPanel.has-minimap { width: 280px; }
.raid-ui #raidTaskPanel.has-minimap.is-collapsed .raid-task-toggle { width: 112px; align-self: flex-end; }
.raid-ui #raidTaskPanel .raid-minimap { position: relative; top: auto; right: auto; width: 224px; align-self: flex-end; flex-shrink: 0; margin: 0 0 8px 0; }
.raid-ui #raidTaskPanel .raid-minimap-viewport { width: 202px; height: 202px; }
.raid-ui #raidTaskPanel .raid-minimap-north { left: 89px; }
.raid-ui #raidTaskPanel .raid-minimap-scale { width: 50.5px; }
.raid-ui #raidTaskPanel .raid-right-rail { position: relative; top: auto; right: auto; bottom: auto; width: 100%; min-height: 0; flex-shrink: 1; }
.raid-ui #raidTaskPanel.is-collapsed .raid-right-rail { display: none; }
.raid-ui .raid-task-toggle { flex-direction: row; align-items: center; width: 100%; min-width: 0; height: 32px; min-height: 32px; flex-shrink: 0; margin: 0; padding: 6px 12px; border-width: 1px; border-color: #43484e; border-radius: 0; background-color: rgba(24, 25, 27, 0.92); letter-spacing: 0; }
.raid-ui .raid-task-toggle:hover { background-color: #272a2d; border-color: #5a6169; }
.raid-ui .raid-task-toggle:active { background-color: #2e3135; }
.raid-ui .raid-task-toggle Label { margin: 0; font-size: 12px; color: #edeef0; }
.raid-ui .raid-task-heading { flex-grow: 1; }
.raid-ui .raid-task-toggle .raid-task-key { color: #b0b4ba; margin-right: 12px; }
.raid-ui .raid-task-chevron { width: 12px; -unity-text-align: middle-center; }
.raid-ui #raidTaskPanel .mission-hud, .raid-ui #raidTaskPanel .campaign-hud { position: relative; top: auto; right: auto; left: auto; bottom: auto; width: 100%; margin: 0; padding: 12px; flex-shrink: 0; background-color: rgba(24, 25, 27, 0.88); }
.raid-ui #raidTaskPanel .mission-title, .raid-ui #raidTaskPanel .campaign-hud-title { font-size: 16px; }
.raid-ui #raidTaskPanel .mission-step, .raid-ui #raidTaskPanel .campaign-hud-action { font-size: 14px; }
.raid-ui #raidTaskPanel .campaign-hud-location, .raid-ui #raidTaskPanel .campaign-hud-hint, .raid-ui #raidTaskPanel .campaign-muted { font-size: 12px; }
.raid-ui #raidTaskPanel #campaignHudChapter, .raid-ui #raidTaskPanel #campaignJournalShortcut { display: none; }
.raid-ui #raidTaskPanel .raid-extraction-panel { display: none; margin-bottom: 0; }
.raid-ui #raidTaskPanel .raid-extraction-panel.is-visible { display: flex; }
.raid-ui #raidTaskPanel #clashInstrument { position: relative; left: auto; right: auto; top: auto; bottom: auto; width: 100%; margin: 0; padding: 12px; background-color: rgba(24, 25, 27, 0.88); }
.raid-ui #raidTaskPanel #clashClock, .raid-ui #raidTaskPanel #clashPhase { display: none; }
.raid-ui #raidTaskPanel #clashBounty, .raid-ui #raidTaskPanel .clash-objective { font-size: 14px; white-space: normal; }
.raid-ui #raidTaskPanel .clash-exit { font-size: 12px; white-space: normal; margin: 0; padding: 12px; background-color: rgba(24, 25, 27, 0.88); }
