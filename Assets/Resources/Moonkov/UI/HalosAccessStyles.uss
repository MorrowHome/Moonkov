.halos-ui {
    --halos-background: #08090b;
    --halos-panel: #18191b;
    --halos-text: #eeeef0;
    --halos-muted: #b0b4ba;
    --halos-blue: #164bff;
    position: relative;
    flex-grow: 1;
    background-color: var(--halos-background);
    color: var(--halos-text);
    overflow: hidden;
    -unity-font-definition: url("../../../UI Toolkit/Fonts/Inter-Regular.ttf");
}
.halos-backdrop, .halos-noise, .halos-signal, .halos-impact {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}
.halos-noise { background-image: url("Halos/Noise.png"); background-size: cover; -unity-background-image-tint-color: #8da4ef; opacity: 0.045; }
.halos-signal { background-image: url("Halos/SignalResidual.png"); background-size: cover; background-position: center; opacity: 0.12; }
.halos-impact { background-color: var(--halos-blue); opacity: 0; }
.halos-noise, .halos-signal { left: -4%; right: -4%; }
.halos-shutter { position: absolute; left: 0; right: 0; height: 50%; background-color: #000000; overflow: hidden; }
.halos-shutter-top { top: 0; }
.halos-shutter-bottom { bottom: 0; }
.halos-shutter-light { position: absolute; left: 0; right: 0; height: 200%; background-image: url("Halos/LightFader.png"); background-size: 100% 100%; }
.halos-shutter-top .halos-shutter-light { top: 0; }
.halos-shutter-bottom .halos-shutter-light { bottom: 0; scale: 1 -1; }
.halos-stage { position: absolute; width: 1920px; height: 1080px; }
.halos-terminal {
    position: absolute;
    background-image: url("Halos/Terminal.png");
    background-size: 100% 100%;
    -unity-background-image-tint-color: #ffffff;
    overflow: hidden;
}
.halos-terminal-text { position: absolute; left: 16px; right: 16px; top: 36px; bottom: 16px; font-size: 16px; color: #eeeef0; white-space: normal; -unity-text-align: upper-left; -unity-font-definition: url("../../../UI Toolkit/RobotoMono-Medium.ttf"); }
.halos-terminal-main .halos-terminal-text { left: 40px; top: 100px; font-size: 20px; }
.halos-terminal-small .halos-terminal-text { top: 40px; font-size: 12px; }
.halos-emblem { background-image: url("Halos/Emblem.png"); background-size: contain; background-position: center; }
.halos-wordmark { background-image: url("Halos/MoonkovWordmark.svg"); background-size: contain; background-position: center; }
.halos-intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}
.halos-access.halos-intro-active > .container { visibility: hidden; opacity: 0; }
.halos-access.halos-reduced-motion Button { transition-duration: 0s; }
.halos-intro .halos-emblem { width: 260px; height: 252px; }
.halos-intro .halos-wordmark { width: 356px; height: 48px; margin-top: 24px; }
.halos-access.archive-access-account { background-image: none; background-color: var(--halos-background); }
.halos-access.archive-access-account .archive-access-exhibit,
.halos-access.archive-access-account .login-heading { display: none; }
.halos-access.archive-access-account > .container { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: auto; max-width: none; padding: 0; margin: 0; border-width: 0; background-color: transparent; opacity: 1; }
.halos-access.archive-access-account .archive-form-scroll { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.halos-access.archive-access-account .archive-form-scroll .unity-scroll-view__content-container { min-height: 100%; align-items: center; justify-content: center; }
.halos-access.archive-access-account .archive-account-form { position: relative; left: auto; right: auto; top: auto; bottom: auto; width: 360px; max-width: 90%; padding: 24px 0; }
.halos-access .halos-account-brand { align-items: center; margin-bottom: 28px; }
.halos-access .halos-account-brand .halos-emblem { width: 210px; height: 204px; }
.halos-access .halos-account-brand .halos-wordmark { width: 320px; height: 42px; max-width: 100%; margin-top: 16px; }
.halos-access.archive-access-account #accountUsername,
.halos-access.archive-access-account #accountPassword { position: relative; left: auto; right: auto; top: auto; bottom: auto; width: auto; height: 78px; margin: 0 0 12px; flex-direction: column; align-items: stretch; }
.halos-access.archive-access-account TextField > .unity-base-field__label { width: auto; min-width: 0; height: 22px; margin: 0; padding: 0; color: var(--halos-muted); font-size: 12px; background-color: transparent; border-width: 0; align-self: stretch; -unity-text-align: middle-left; }
.halos-access.archive-access-account TextField .unity-text-field__input { height: 52px; min-height: 52px; padding: 8px 16px; background-color: transparent; background-image: url("Halos/FieldRule.png"); background-size: 100% 100%; background-position: center; -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 5; -unity-slice-bottom: 5; color: var(--halos-text); border-width: 0; border-radius: 0; font-size: 16px; }
.halos-access.archive-access-account TextField:hover .unity-text-field__input { -unity-background-image-tint-color: #eeeeef; }
.halos-access.archive-access-account TextField:focus .unity-text-field__input { border-width: 0; -unity-background-image-tint-color: #8da4ef; }
.halos-access.archive-access-account TextField .unity-text-element--inner-input-field,
.halos-access.archive-access-account TextField .unity-text-element--inner-input-field-component { color: var(--halos-text); font-size: 16px; }
.halos-access.archive-access-account #accountMessage { position: relative; left: auto; right: auto; top: auto; height: auto; min-height: 28px; margin: 0 0 12px; padding: 0; color: var(--halos-muted); background-color: transparent; border-width: 0; font-size: 12px; white-space: normal; }
.halos-access.archive-access-account #accountMessage.is-error { color: #ffb4a4; }
.halos-access.archive-access-account .archive-form-actions,
.halos-access.archive-access-account .archive-account-secondary { position: relative; left: auto; right: auto; top: auto; bottom: auto; height: 44px; flex-direction: row; margin: 0 0 10px; padding: 0; }
.halos-access.archive-access-account .archive-form-actions Button,
.halos-access.archive-access-account .archive-account-secondary Button,
.halos-access.archive-access-account .archive-account-secondary #ProfileMode { position: relative; left: auto; right: auto; top: auto; bottom: auto; flex-grow: 1; flex-basis: 0; width: auto; min-width: 0; height: 44px; min-height: 44px; margin: 0; padding: 0 12px; font-size: 16px; color: var(--halos-text); background-color: transparent; background-image: url("Halos/FieldRule.png"); background-size: 100% 100%; -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 5; -unity-slice-bottom: 5; border-width: 0; border-radius: 0; -unity-text-align: middle-center; transition-duration: 0.15s; }
.halos-access.archive-access-account #accountLogin,
.halos-access.archive-access-account .archive-account-secondary #ProfileMode { margin-right: 10px; }
.halos-access.archive-access-account #accountLogin,
.halos-access.archive-access-account #ProfileMode { border-left-width: 0; }
.halos-access.archive-access-account #accountLogin { background-color: transparent; -unity-background-image-tint-color: #8da4ef; }
.halos-access.archive-access-account Button:hover { background-color: rgba(255,255,255,0.06); -unity-background-image-tint-color: #ffffff; }
.halos-access.archive-access-account #accountLogin:hover { background-color: rgba(22,75,255,0.12); -unity-background-image-tint-color: #8da4ef; }
.halos-access.archive-access-account Button:focus { border-width: 0; -unity-background-image-tint-color: #8da4ef; }
.halos-access.archive-access-account Button:active { background-color: rgba(22,75,255,0.2); }
.halos-access.archive-access-account Button:disabled { opacity: 0.45; }
.halos-access .halos-motion { align-self: center; margin-top: 8px; color: var(--halos-muted); font-size: 12px; }
.halos-access .halos-motion .unity-toggle__input { flex-grow: 0; background-color: transparent; border-width: 0; }
.halos-access .halos-motion .unity-toggle__checkmark { width: 16px; height: 16px; margin-right: 8px; border-width: 1px; border-color: #626975; background-color: var(--halos-panel); }
.halos-access .halos-motion:checked .unity-toggle__checkmark { background-color: var(--halos-blue); border-color: #8da4ef; }
.halos-access.halos-compact .halos-account-brand { margin-bottom: 16px; }
.halos-access.halos-compact .halos-account-brand .halos-emblem { width: 136px; height: 132px; }
.halos-access.halos-compact .halos-account-brand .halos-wordmark { width: 270px; height: 36px; margin-top: 10px; }
.halos-loading { background-image: url("PageArt/Base.png"); background-size: cover; background-position: center; -unity-background-image-tint-color: #687589; }
.halos-loading .halos-stage { opacity: 0.38; }
.halos-loading-content { width: 360px; max-width: 90%; flex-shrink: 0; align-items: center; }
.halos-loading-brand { align-items: center; margin-bottom: 32px; }
.halos-loading-brand .halos-emblem { width: 210px; height: 204px; }
.halos-loading-brand .halos-wordmark { width: 320px; height: 42px; margin-top: 16px; }
.halos-loading-progress { width: 100%; padding: 20px 0; background-color: rgba(8,9,12,0.92); }
.halos-loading #LoadingStatus { color: var(--halos-text); font-size: 16px; white-space: normal; margin: 0 12px 16px; -unity-text-align: middle-center; }
.halos-loading ProgressBar { height: 3px; margin: 0; padding: 0; }
.halos-loading .unity-progress-bar__background { height: 3px; min-height: 3px; background-color: #30343b; border-width: 0; border-radius: 0; }
.halos-loading .unity-progress-bar__progress { height: 3px; min-height: 3px; background-color: var(--halos-blue); border-width: 0; border-radius: 0; }
.halos-loading .unity-progress-bar__title { display: none; }
