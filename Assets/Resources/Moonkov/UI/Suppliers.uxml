<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="ContactCard" src="Components/ContactCardContent.uxml" />
    <ui:VisualElement name="terminalPage">
        <ui:VisualElement class="archive-page-layout">
            <ui:VisualElement class="archive-exhibit archive-industrial-photo" picking-mode="Ignore"><ui:Label text="SUPPLIERS / MARKET" class="terminal-eyebrow" /><ui:Label text="LUNAR SUPPLY NETWORK" /></ui:VisualElement>
            <ui:VisualElement class="archive-directory">
                <ui:VisualElement class="archive-directory-row">
                    <ui:Button name="supplier0" class="archive-contact"><ui:Instance template="ContactCard">
                        <ui:AttributeOverrides element-name="contactIndex" text="01 / UEL" />
                        <ui:AttributeOverrides element-name="contactTitle" text="UNITED EARTH LOGISTICS" />
                        <ui:AttributeOverrides element-name="contactDetail" text="Structural materials, field equipment and cargo transport." />
                    </ui:Instance></ui:Button>
                    <ui:Button name="supplier1" class="archive-contact"><ui:Instance template="ContactCard">
                        <ui:AttributeOverrides element-name="contactIndex" text="02 / LMB" />
                        <ui:AttributeOverrides element-name="contactTitle" text="LUNAR MEDICAL BUREAU" />
                        <ui:AttributeOverrides element-name="contactDetail" text="Medical supplies, suit diagnostics and expedition recovery." />
                    </ui:Instance></ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="archive-directory-row">
                    <ui:Button name="supplier2" class="archive-contact"><ui:Instance template="ContactCard">
                        <ui:AttributeOverrides element-name="contactIndex" text="03 / SE" />
                        <ui:AttributeOverrides element-name="contactTitle" text="THE SALVAGE ENGINEER" />
                        <ui:AttributeOverrides element-name="contactDetail" text="Halo components, reclaimed electronics and rare artifacts." />
                    </ui:Instance></ui:Button>
                    <ui:Button name="emergencySupply" class="archive-contact"><ui:Instance template="ContactCard">
                        <ui:AttributeOverrides element-name="contactIndex" text="04 / RECOVERY" />
                        <ui:AttributeOverrides element-name="contactTitle" text="EMERGENCY SUPPLY" />
                        <ui:AttributeOverrides element-name="contactDetail" text="Trade with moon dust. Lost every halo? Emergency supply can get you back into the field." />
                    </ui:Instance></ui:Button>
                </ui:VisualElement>
                <ui:Button class="terminal-button" enabled="false" tooltip="The player market is not open." text="OPEN PLAYER MARKET" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
