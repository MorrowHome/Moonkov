<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../../../UI Toolkit/GameUI/StashScreen.uss" />
    <ui:Style src="../../../UI Toolkit/GameUI/MoonkovTerminal.uss" />
    <ui:Style src="ArchiveTheme.uss" />
    <ui:Style src="OperationProposal.uss" />
    <ui:VisualElement name="layoutPreview" class="stash-root moonkov-terminal archive-ui archive-pages archive-page-4 operation-step-0" style="width: 1600px; height: 900px;">
        <ui:VisualElement name="terminalPage" style="flex-grow: 1;">
            <ui:VisualElement class="op-stage" name="operationMain" />
            <ui:VisualElement class="op-brand">
                <ui:Label text="ESCAPE FROM" class="op-kicker" />
                <ui:Label text="MOONKOV" class="op-brand-title stash-brand-title" />
                <ui:VisualElement class="op-blue-rule" />
                <ui:Label text="LUNAR EXPEDITION" class="op-kicker" />
            </ui:VisualElement>
            <ui:VisualElement class="op-stepper" name="operationStepper">
                <ui:Button name="operationStep0" class="op-step">
                    <ui:Label text="01" class="op-step-number" />
                    <ui:Label text="OPERATOR" class="op-step-label" />
                    <ui:Label text="OPERATOR" class="op-step-code" />
                </ui:Button>
                <ui:Button name="operationStep1" class="op-step">
                    <ui:Label text="02" class="op-step-number" />
                    <ui:Label text="LOCATION" class="op-step-label" />
                    <ui:Label text="LOCATION" class="op-step-code" />
                </ui:Button>
                <ui:Button name="operationStep2" class="op-step">
                    <ui:Label text="03" class="op-step-number" />
                    <ui:Label text="BRIEFING" class="op-step-label" />
                    <ui:Label text="BRIEFING" class="op-step-code" />
                </ui:Button>
                <ui:Button name="operationStep3" class="op-step">
                    <ui:Label text="04" class="op-step-number" />
                    <ui:Label text="RECOVERY" class="op-step-label" />
                    <ui:Label text="RECOVERY" class="op-step-code" />
                </ui:Button>
                <ui:Button name="operationStep4" class="op-step">
                    <ui:Label text="05" class="op-step-number" />
                    <ui:Label text="READY" class="op-step-label" />
                    <ui:Label text="CONFIRM" class="op-step-code" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="back" class="op-button op-back">
                <ui:Label class="op-back-arrow" text="←" />
                <ui:Label text="BACK" class="op-button-label" />
                <ui:Label text="→" class="op-arrow" />
            </ui:Button>
            <ui:Button name="operationContinue" class="op-button op-continue">
                <ui:VisualElement class="op-action-art" picking-mode="Ignore" />
                <ui:Label text="CONTINUE" class="op-button-label" />
                <ui:Label text="→" class="op-arrow" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
