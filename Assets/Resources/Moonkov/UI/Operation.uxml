<ui:UXML xmlns:moon="Unity.MP_FPS.Client" xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/UI Toolkit/GameUI/StashScreen.uss" />
    <ui:Style src="project://database/Assets/UI Toolkit/GameUI/MoonkovTerminal.uss" />
    <ui:Style src="project://database/Assets/Resources/Moonkov/UI/TerminalLayout.uss" />
    <ui:VisualElement name="layoutPreview" class="stash-root moonkov-terminal terminal-layout-preview">
        <ui:VisualElement name="terminalPage" class="terminal-content terminal-content-page">
            <ui:Label name="pageIndex" class="terminal-page-index" picking-mode="Ignore" text="05" />
            <ui:VisualElement name="operationStepper" class="terminal-row terminal-stepper">
                <ui:VisualElement class="terminal-stepper-rail" picking-mode="Ignore">
                    <ui:VisualElement class="terminal-stepper-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Button class="terminal-button" text="01  OPERATOR" />
                <ui:Button class="terminal-button" text="02  LOCATION" />
                <ui:Button class="terminal-button" text="03  BRIEFING" />
                <ui:Button class="terminal-button" text="04  RECOVERY" />
                <ui:Button class="terminal-button" text="05  READY" />
            </ui:VisualElement>
            <ui:VisualElement class="terminal-row">
                <ui:VisualElement name="operationMain" class="terminal-panel terminal-wide">
                    <moon:TechFrame picking-mode="Ignore" delay="0.08" />
                    <ui:Label class="terminal-eyebrow" text="EXPEDITION / OPERATOR" />
                </ui:VisualElement>
                <ui:VisualElement class="terminal-panel terminal-side">
                    <moon:TechFrame picking-mode="Ignore" delay="0.16" />
                    <ui:Label class="terminal-eyebrow" text="MISSION SUMMARY" />
                    <ui:Label class="terminal-step-counter" text="01 / 05" />
                    <ui:Label class="terminal-title" text="LUNAR RECOVERY" />
                    <ui:VisualElement class="terminal-row terminal-stat">
                        <ui:Label class="terminal-stat-name" text="LOCATION" />
                        <ui:Label class="terminal-stat-value" text="MOON / SURFACE SECTOR" name="statValue0" />
                    </ui:VisualElement>
                    <ui:VisualElement class="terminal-row terminal-stat">
                        <ui:Label class="terminal-stat-name" text="CAPACITY" />
                        <ui:Label class="terminal-stat-value" text="12 SUPPLIES" name="statValue1" />
                    </ui:VisualElement>
                    <ui:VisualElement class="terminal-row terminal-stat">
                        <ui:Label class="terminal-stat-name" text="EXTRACTION" />
                        <ui:Label class="terminal-stat-value" text="GREEN BEACON" name="statValue2" />
                    </ui:VisualElement>
                    <ui:VisualElement class="terminal-row terminal-stat">
                        <ui:Label class="terminal-stat-name" text="TEAM" />
                        <ui:Label class="terminal-stat-value" text="SESSION PARTICIPANTS" name="statValue3" />
                    </ui:VisualElement>
                    <ui:Label class="terminal-copy" text="Your session host determines the map and mission timing. Connection setup follows the readiness check." />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="terminal-row terminal-page-actions">
                <ui:Button class="terminal-button" text="BACK" name="back" />
                <ui:Button class="terminal-primary" text="CONTINUE" name="continue" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
