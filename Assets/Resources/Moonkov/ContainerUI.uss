@import url("../../UI Toolkit/GameUI/MoonkovTerminal.uss");
.inventory-view { flex-grow: 1; min-height: 0; color: #ECECE6; background-color: rgba(7, 8, 10, 0.94); position: relative; -unity-font-definition: url("../../UI Toolkit/Fonts/Inter-Regular.ttf"); }
.inventory-view Label { color: #ECECE6; margin: 0; -unity-text-align: middle-left; }
.inventory-view Button { background-image: none; background-color: rgba(255, 255, 255, 0.06); color: #ECECE6; border-width: 0; border-radius: 0; min-width: 0; margin: 0; padding: 7px; letter-spacing: 2px; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Bold.ttf"); transition-property: background-color, color; transition-duration: 0.15s; }
.inventory-view Button:hover { background-color: rgba(255, 225, 26, 0.14); color: #FFE11A; }
.inventory-view Button:active { background-color: #FFE11A; color: #07080A; }
.inventory-body { flex-grow: 1; min-height: 0; flex-direction: row; }
.inventory-loot-pane { width: 46%; margin-right: 4%; padding: 14px; background-color: rgba(255, 255, 255, 0.025); border-width: 1px; border-color: rgba(255, 255, 255, 0.12); border-top-width: 2px; border-top-color: #FFE11A; }
.inventory-with-loot .inventory-containers { flex-grow: 1; }
.inventory-character { width: 44%; min-height: 0; margin-right: 3%; }
.inventory-with-stash .inventory-character { width: 36%; margin-right: 2%; }
.inventory-character-title { font-size: 23px; letter-spacing: 3px; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Black.ttf"); margin-bottom: 6px; }
.inventory-caption { font-size: 10px; letter-spacing: 1px; color: #FFE11A; margin-bottom: 7px; white-space: normal; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.inventory-character-stage { flex-grow: 1; min-height: 290px; position: relative; }
.inventory-slot-layer, .inventory-view .stash-equipment-guides { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inventory-view .stash-character-render { position: absolute; left: 14%; right: 14%; top: 0; bottom: 0; }
.inventory-view .inventory-slot { position: absolute; width: 24%; height: 24%; padding: 8px; background-color: rgba(9, 10, 13, 0.82); border-width: 1px; border-color: rgba(255, 255, 255, 0.12); border-left-width: 2px; border-left-color: rgba(255, 225, 26, 0.35); }
.inventory-view .inventory-slot:hover { background-color: rgba(255, 225, 26, 0.08); border-color: rgba(255, 225, 26, 0.6); }
.inventory-view .inventory-equipped { background-color: rgba(63, 224, 208, 0.06); border-left-color: #3FE0D0; }
.inventory-slot-label { position: absolute; left: 7px; right: 5px; top: 7px; font-size: 8px; letter-spacing: 2px; white-space: normal; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.inventory-view .inventory-slot-label { color: rgba(236, 236, 230, 0.55); }
.inventory-slot-art { position: absolute; top: 25px; left: 12%; right: 12%; bottom: 22px; }
.inventory-slot-item { position: absolute; left: 7px; right: 5px; bottom: 6px; font-size: 9px; }
.inventory-view .inventory-slot-item { color: rgba(236, 236, 230, 0.75); }
.inventory-weight { font-size: 11px; margin-top: 10px; margin-bottom: 8px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.inventory-containers { flex-grow: 1; min-width: 0; min-height: 0; }
.inventory-with-stash .inventory-containers { width: 25%; flex-grow: 0; margin-right: 2%; }
.inventory-stash { flex-grow: 1; min-width: 0; min-height: 0; background-color: rgba(255, 255, 255, 0.025); border-width: 1px; border-color: rgba(255, 255, 255, 0.08); border-top-width: 2px; border-top-color: #FFE11A; padding: 14px; }
.inventory-container { margin-bottom: 16px; min-height: 0; }
.inventory-section-title { font-size: 12px; letter-spacing: 3px; -unity-font-definition: url("../../UI Toolkit/Fonts/Roboto-Bold.ttf"); margin-bottom: 8px; }
.inventory-regions { flex-direction: row; flex-wrap: wrap; min-height: 0; }
.inventory-region { margin-right: 8px; margin-bottom: 8px; min-height: 0; }
.inventory-region-title { font-size: 8px; letter-spacing: 2px; margin-bottom: 4px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.inventory-view .inventory-region-title { color: #3FE0D0; }
.inventory-grid { position: relative; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.4); }
.inventory-warehouse-scroll { flex-grow: 1; min-height: 0; }
.inventory-stash .inventory-container, .inventory-stash .inventory-regions, .inventory-stash .inventory-region { flex-grow: 1; }
.inventory-view .inventory-item { position: absolute; padding: 0; overflow: hidden; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); background-color: rgba(255, 255, 255, 0.05); }
.inventory-view .inventory-item:hover { border-color: rgba(255, 255, 255, 0.5); background-color: rgba(255, 255, 255, 0.09); }
.inventory-item-art { position: absolute; left: 12%; right: 12%; top: 20%; bottom: 20%; }
.inventory-item-label { position: absolute; left: 4px; right: 4px; top: 3px; font-size: 8px; }
.inventory-item-quantity { position: absolute; right: 4px; bottom: 3px; font-size: 9px; }
.inventory-view .inventory-item-quantity { color: #FFE11A; }
.inventory-ghost { position: absolute; background-color: rgba(9, 10, 13, 0.92); border-width: 1px; border-color: #FFE11A; }
.inventory-drop { position: absolute; border-width: 2px; }
.inventory-view .inventory-drop-valid { background-color: rgba(63, 224, 122, 0.18); border-color: #3FE07A; }
.inventory-view .inventory-drop-invalid { background-color: rgba(255, 77, 58, 0.18); border-color: #FF4D3A; }
.inventory-hint { height: 32px; flex-shrink: 0; font-size: 10px; white-space: normal; margin-top: 7px; -unity-font-definition: url("../../UI Toolkit/RobotoMono-Medium.ttf"); }
.inventory-view .inventory-hint { color: rgba(236, 236, 230, 0.45); }
.inventory-container-window { width: auto; min-width: 250px; max-width: 560px; }
.inventory-container-window .inventory-container { margin: 10px; }
.inventory-view .terminal-window-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
